{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Gemini API Key",
            "pattern": "/AIza[a-zA-Z0-9_-]{35}/"
          },
          {
            "name": "Cloudflare API Token (Env Var)",
            "pattern": "/CLOUDFLARE_API_TOKEN\\s*=\\s*['\"]?[a-zA-Z0-9_-]+['\"]?/i"
          },
          {
            "name": "Cloudflare New Tokens (Value)",
            "pattern": "/(?:cfk|cfut|cfat)_[a-zA-Z0-9_-]{48}/"
          }
        ]
      }
    }
  ]
}
