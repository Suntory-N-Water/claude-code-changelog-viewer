or {
    `$date.toISOString()` as $call where {
        register_diagnostic(
            span = $call,
            message = "日付の表示には date-fns の format() と TZDate('Asia/Tokyo') を使用してください。toISOString() は UTC 文字列を返すため、表示目的での使用は禁止です。",
            severity = "error"
        )
    },
    `$date.toLocaleDateString($...)` as $call where {
        register_diagnostic(
            span = $call,
            message = "日付の表示には date-fns の format() と TZDate('Asia/Tokyo') を使用してください。",
            severity = "error"
        )
    },
    `$date.toLocaleString($...)` as $call where {
        register_diagnostic(
            span = $call,
            message = "日付の表示には date-fns の format() と TZDate('Asia/Tokyo') を使用してください。",
            severity = "error"
        )
    },
    `$date.toLocaleTimeString($...)` as $call where {
        register_diagnostic(
            span = $call,
            message = "日付の表示には date-fns の format() と TZDate('Asia/Tokyo') を使用してください。",
            severity = "error"
        )
    }
}
