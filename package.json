{
  "name": "claude-code-changelog-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Claude Codeの更新履歴をどこよりも分かりやすく表示するWebアプリケーション",
  "author": "sui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suntory-N-Water/claude-code-changelog-viewer.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "bugs": {
    "url": "https://github.com/Suntory-N-Water/claude-code-changelog-viewer/issues"
  },
  "homepage": "https://github.com/Suntory-N-Water/claude-code-changelog-viewer#readme",
  "keywords": [
    "typescript",
    "astro",
    "pnpm",
    "monorepo",
    "claude-code"
  ],
  "scripts": {
    "dev": "pnpm --filter www run dev",
    "build": "pnpm --filter www run build",
    "preview": "pnpm --filter www run preview",
    "deploy": "pnpm --filter www run deploy",
    "fetch:docs": "pnpm --filter docs-tracker run build && pnpm --filter docs-tracker run fetch-docs",
    "fetch:changelog": "pnpm --filter changelog-fetcher run fetch",
    "analyze": "pnpm --filter changelog-fetcher run analyze",
    "infer": "pnpm --filter changelog-fetcher run infer",
    "format": "biome format --write ./apps ./packages && pnpm --filter www run format",
    "check": "biome check ./apps ./packages",
    "check:fix": "biome check --write ./apps ./packages",
    "lint": "biome lint ./apps ./packages",
    "lint:unsafe-fix": "biome lint --write --unsafe ./apps ./packages",
    "lint:ai": "biome lint --reporter=github ./apps ./packages 2>&1 | { grep '^::' || true; }",
    "type-check": "pnpm -r exec tsc --noEmit && pnpm --filter www run check",
    "type-check:ai": "pnpm -r exec tsc --noEmit --pretty false && pnpm --filter www run check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/node": "^25.0.8",
    "typescript": "~5.9.3"
  }
}
