{
  "name": "claude-code-changelog-viewer",
  "private": true,
  "version": "2.1.117",
  "type": "module",
  "description": "Claude Codeの更新履歴をどこよりも分かりやすく表示するWebサイト",
  "author": "sui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suntory-N-Water/claude-code-changelog-viewer.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bugs": {
    "url": "https://github.com/Suntory-N-Water/claude-code-changelog-viewer/issues"
  },
  "homepage": "https://github.com/Suntory-N-Water/claude-code-changelog-viewer#readme",
  "keywords": [
    "typescript",
    "astro",
    "pnpm",
    "monorepo",
    "claude-code"
  ],
  "scripts": {
    "dev": "pnpm --filter www run dev",
    "dev:notify": "pnpm --filter notification-worker run dev",
    "build": "pnpm --filter www run build",
    "preview": "pnpm --filter www run preview",
    "deploy": "pnpm --filter www run deploy",
    "upload": "pnpm --filter www run upload",
    "fetch:docs": "pnpm --filter docs-tracker run fetch-docs",
    "generate:docs-diff": "pnpm --filter docs-tracker run generate-diff",
    "fetch:changelog": "pnpm --filter changelog-fetcher run fetch",
    "analyze": "pnpm --filter changelog-fetcher run analyze",
    "infer": "pnpm --filter changelog-fetcher run infer",
    "infer:no-ai": "pnpm --filter changelog-fetcher run infer:no-ai",
    "notify:deploy": "pnpm --filter notification-worker run deploy",
    "notify:migrate": "pnpm --filter notification-worker run db:migrate:remote",
    "notify:migrate:local": "pnpm --filter notification-worker run db:migrate",
    "sync": "pnpm --filter www run sync",
    "format": "biome format --write ./apps ./packages && pnpm --filter www run format",
    "check": "biome check ./apps ./packages",
    "check:fix": "biome check --write ./apps ./packages",
    "lint": "biome lint ./apps ./packages",
    "lint:unsafe-fix": "biome lint --write --unsafe ./apps ./packages",
    "lint:ai": "biome lint --reporter=github ./apps ./packages 2>&1 | { grep '^::' || true; }",
    "type-check": "pnpm --filter '*' run type-check && pnpm --filter www run check",
    "type-check:ai": "pnpm --filter '*' run type-check && pnpm --filter www run check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ai-check": "pnpm run format && pnpm run lint:ai && pnpm run type-check:ai",
    "knip": "knip",
    "similarity": "similarity-ts --exclude node_modules --exclude dist --exclude .astro --exclude changelogs --exclude analysis --exclude inferred --exclude metadata --exclude '*.d.ts' .",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,jsonc,html,astro}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.0",
    "@biomejs/biome": "2.4.9",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "4.1.5",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "^4.1.5"
  }
}
