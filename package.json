{
  "name": "claude-code-changelog-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Claude Codeの更新履歴をどこよりも分かりやすく表示するWebサイト",
  "author": "sui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suntory-N-Water/claude-code-changelog-viewer.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "keywords": [
    "typescript",
    "astro",
    "pnpm",
    "monorepo",
    "claude-code"
  ],
  "scripts": {
    "dev": "pnpm --filter www run dev",
    "dev:worker": "pnpm --filter changelog-viewer-worker run dev",
    "dev:worker:remote": "pnpm --filter changelog-viewer-worker run dev:remote",
    "build": "pnpm --filter www run build",
    "preview": "pnpm --filter www run preview",
    "deploy": "pnpm --filter www run deploy",
    "upload": "pnpm --filter www run upload",
    "worker:deploy": "pnpm --filter changelog-viewer-worker run deploy",
    "worker:migrate": "pnpm --filter changelog-viewer-worker run db:migrate:remote",
    "worker:migrate:local": "pnpm --filter changelog-viewer-worker run db:migrate",
    "worker:seed": "pnpm --filter changelog-viewer-worker run db:seed",
    "worker:generate-seed": "pnpm --filter changelog-viewer-worker run db:generate-seed",
    "worker:migrate:docs-search": "pnpm --filter changelog-viewer-worker run db:migrate:docs-search:remote",
    "worker:migrate:docs-search:local": "pnpm --filter changelog-viewer-worker run db:migrate:docs-search",
    "sync": "pnpm --filter www run sync",
    "new-column": "pnpm --filter www run new-column",
    "format": "biome format --write --reporter=github ./apps ./packages && pnpm --silent --filter www run format",
    "check": "biome check ./apps ./packages",
    "check:fix": "biome check --write ./apps ./packages",
    "lint": "biome lint ./apps ./packages",
    "lint:unsafe-fix": "biome lint --write --unsafe ./apps ./packages",
    "lint:ai": "biome lint --reporter=github ./apps ./packages 2>&1 | { grep '^::' || true; }",
    "type-check": "pnpm --filter '*' run type-check && SITE_DATA_SKIP_FETCH=1 pnpm --filter www run check",
    "type-check:ai": "pnpm --filter '*' run type-check:ai && SITE_DATA_SKIP_FETCH=1 pnpm --filter www run check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ai-check": "pnpm --silent run format && pnpm --silent run lint:ai && pnpm --silent run type-check:ai",
    "knip": "knip",
    "similarity": "similarity-ts --exclude node_modules --exclude dist --exclude .astro --exclude '*.d.ts' ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@secretlint/secretlint-rule-pattern": "^13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "secretlint": "^13.1.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.17.0"
}
