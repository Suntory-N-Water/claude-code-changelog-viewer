{
  "name": "claude-code-changelog-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Claude Codeの更新履歴をどこよりも分かりやすく表示するWebアプリケーション",
  "author": "sui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suntory-N-Water/claude-code-changelog-viewer.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "bugs": {
    "url": "https://github.com/Suntory-N-Water/claude-code-changelog-viewer/issues"
  },
  "homepage": "https://github.com/Suntory-N-Water/claude-code-changelog-viewer#readme",
  "keywords": [
    "typescript",
    "astro",
    "pnpm",
    "monorepo",
    "claude-code"
  ],
  "scripts": {
    "changeset": "changeset",
    "format": "biome format --write ./packages ./apps",
    "check": "biome check ./packages ./apps",
    "check:fix": "biome check --write ./packages ./apps",
    "lint": "biome lint ./packages ./apps",
    "lint:unsafe-fix": "biome lint --write --unsafe ./packages ./apps",
    "lint:ai": "biome lint --reporter=github ./packages ./apps 2>&1 | { grep '^::' || true; }",
    "type-check": "pnpm -r exec tsc --noEmit",
    "type-check:ai": "pnpm -r exec tsc --noEmit --pretty false"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/node": "^25.0.8",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
