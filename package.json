{
  "name": "claude-code-changelog-viewer",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "Claude Codeの更新履歴をどこよりも分かりやすく表示するWebサイト",
  "author": "sui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suntory-N-Water/claude-code-changelog-viewer.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "typescript",
    "astro",
    "pnpm",
    "monorepo",
    "claude-code"
  ],
  "scripts": {
    "dev": "pnpm --filter www run dev",
    "dev:notify": "pnpm --filter notification-worker run dev",
    "build": "pnpm --filter www run build",
    "preview": "pnpm --filter www run preview",
    "deploy": "pnpm --filter www run deploy",
    "upload": "pnpm --filter www run upload",
    "fetch:blog": "pnpm --filter docs-tracker run fetch-blog",
    "fetch:docs": "pnpm --filter docs-tracker run fetch-docs",
    "fetch:schema": "pnpm --filter docs-tracker run fetch-schema",
    "fetch:youtube-metadata": "pnpm --filter docs-tracker run fetch-youtube-metadata",
    "fetch:youtube-transcripts": "pnpm --filter docs-tracker run fetch-youtube-transcripts",
    "generate:docs-diff": "pnpm --filter docs-tracker run generate-diff",
    "fetch:changelog": "pnpm --filter changelog-fetcher run fetch",
    "analyze": "pnpm --filter changelog-fetcher run analyze",
    "infer": "pnpm --filter changelog-fetcher run infer",
    "tie:issues": "pnpm --filter changelog-fetcher run tie:issues",
    "infer:no-ai": "pnpm --filter changelog-fetcher run infer:no-ai",
    "generate:settings": "pnpm --filter changelog-fetcher run generate-settings",
    "generate:settings:no-ai": "pnpm --filter changelog-fetcher run generate-settings:no-ai",
    "notify:deploy": "pnpm --filter notification-worker run deploy",
    "notify:migrate": "pnpm --filter notification-worker run db:migrate:remote",
    "notify:migrate:local": "pnpm --filter notification-worker run db:migrate",
    "sync": "pnpm --filter www run sync",
    "format": "biome format --write --reporter=github ./apps ./packages && pnpm --silent --filter www run format",
    "check": "biome check ./apps ./packages",
    "check:fix": "biome check --write ./apps ./packages",
    "lint": "biome lint ./apps ./packages",
    "lint:unsafe-fix": "biome lint --write --unsafe ./apps ./packages",
    "lint:ai": "biome lint --reporter=github ./apps ./packages 2>&1 | { grep '^::' || true; }",
    "type-check": "pnpm --filter '*' run type-check && pnpm --filter www run check",
    "type-check:ai": "pnpm --filter '*' run type-check:ai && pnpm --filter www run check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ai-check": "pnpm --silent run format && pnpm --silent run lint:ai && pnpm --silent run type-check:ai",
    "knip": "knip",
    "similarity": "similarity-ts --exclude node_modules --exclude dist --exclude .astro --exclude changelogs --exclude analysis --exclude inferred --exclude metadata --exclude '*.d.ts' .",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,jsonc,html,astro}": "biome check --write --no-errors-on-unmatched",
    "*": [
      "secretlint --no-glob"
    ]
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@biomejs/biome": "2.5.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@secretlint/secretlint-rule-pattern": "^13.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "secretlint": "^13.0.2",
    "tsx": "^4.23.0",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}
