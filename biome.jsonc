{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.{cjs,mjs,cts,mts,js,jsx,ts,tsx}",
      "**/*.json",
      "**/*.jsonc",
      "**/*.html",
      "**/*.astro",
      "!node_modules",
      "!**/.astro",
      "!**/dist",
      "!**/metadata",
      "!**/worker-configuration.d.ts",
      "!**/.wrangler"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "attributePosition": "auto",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "includes": [
      "**/*.{cjs,mjs,cts,mts,js,jsx,ts,tsx}",
      "**/*.json",
      "**/*.jsonc",
      "**/*.html",
      "!node_modules",
      "!**/dist",
      "!**/worker-configuration.d.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error",
        "noEvolvingTypes": "error",
        "noImportCycles": "error",
        "noUnusedExpressions": "error",
        // package.json の依存重複を検出(モノレポ向け)
        "noDuplicateDependencies": "error",
        "noUnnecessaryConditions": "error",
        // .then() / .catch() のネストを禁止し async/await を促進
        "noNestedPromises": "error",
        // for...in を禁止(Object.keys/entries を使用)
        "noForIn": "error"
      },
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "warn",
          "options": {
            "style": "type"
          }
        },
        "noParameterAssign": "error",
        "useConsistentArrayType": "error",
        "useArrayLiterals": "error",
        "useBlockStatements": "error",
        // a = b = c のような連鎖代入を禁止
        "noMultiAssign": "error",
        // ++ / -- を禁止し += 1 / -= 1 に統一
        "noIncrementDecrement": "error"
      },
      "correctness": {
        // 解決できない import を検出(bun:* / astro:* は overrides で除外)
        "noUnresolvedImports": "error"
      },
      "complexity": {
        "noUselessUndefined": "error",
        "useLiteralKeys": "off",
        // 関数の引数は最大3つまで(テストファイルは overrides で除外)
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "a11y": {
        "useKeyWithClickEvents": "error",
        "noStaticElementInteractions": "error",
        "useKeyWithMouseEvents": "error",
        "useHeadingContent": "error",
        "useValidAnchor": "error"
      }
    }
  },
  "json": {
    "parser": {
      "allowTrailingCommas": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off",
        "noDuplicateClasses": "on"
      }
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 80
    }
  },
  "overrides": [
    {
      "includes": ["**/*.{ts,tsx,js,jsx,astro}"],
      "plugins": [
        "./plugins/no-deep-relative-import.grit",
        "./plugins/no-import-equals.grit",
        "./plugins/no-template-literal-import.grit"
      ]
    },
    {
      // apps/www/scripts 以外全体に debug 文禁止ルールを適用
      "includes": ["**", "!apps/www/scripts/**"],
      "plugins": ["./plugins/no-debug-statements.grit"]
    },
    {
      // apps/www のみ date-fns による日付フォーマットを強制する
      "includes": ["apps/www/**/*.{ts,tsx,astro}"],
      "plugins": ["./plugins/enforce-date-fns.grit"]
    },
    {
      "includes": ["**/*.css"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      // Astro ファイルは Prettier でフォーマットするため、Biome はリントのみ
      "includes": ["**/*.astro"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "correctness": {
            // Astro は静的レンダリングのため key 不要
            "useJsxKeyInIterable": "off",
            // Astro では type Props が Astro.props の型推論に使われる
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/common/src/logger.ts",
        "apps/common/src/logger.ts"
      ],
      "linter": {
        "enabled": false
      }
    },
    {
      // テストヘルパーは引数の上限を緩和する
      "includes": ["**/__tests__/**", "**/support/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "complexity": {
            "useMaxParams": "off"
          },
          "suspicious": {
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      // astro:content は Astro のバーチャルモジュールで解決不可
      "includes": ["apps/www/src/**/*.ts", "apps/www/src/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    },
    {
      // Cloudflare Workers のテスト/Workflow 仮想モジュールは Biome の解決対象外
      "includes": [
        "apps/worker/src/workflows/**",
        "apps/worker/src/infrastructure/d1/d1-export-client.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "style": {
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    },
    {
      // discriminated union の exhaustive switch に対する biome の偽陽性を回避
      "includes": [
        "apps/worker/src/routes/webhooks.ts",
        "apps/worker/src/queue/consumer.ts",
        "apps/worker/src/index.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      // aria-current={condition ? 'page' : undefined} に対する biome の偽陽性を回避
      "includes": [
        "apps/www/src/components/MobileMenu.astro",
        "apps/www/src/layouts/Layout.astro"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useValidAriaValues": "off"
          }
        }
      }
    }
  ]
}
