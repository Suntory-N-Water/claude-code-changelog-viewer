{
  "$schema": "https://biomejs.dev/schemas/2.4.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.{cjs,mjs,cts,mts,js,jsx,ts,tsx}",
      "**/*.json",
      "**/*.jsonc",
      "**/*.html",
      "**/*.astro",
      "!node_modules",
      "!**/.astro",
      "!**/dist",
      "!**/metadata",
      "!**/worker-configuration.d.ts",
      "!**/.wrangler"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "attributePosition": "auto",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "includes": [
      "**/*.{cjs,mjs,cts,mts,js,jsx,ts,tsx}",
      "**/*.json",
      "**/*.jsonc",
      "**/*.html",
      "!node_modules",
      "!**/dist",
      "!**/worker-configuration.d.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error",
        "noEvolvingTypes": "error",
        "noImportCycles": "error",
        "noUnusedExpressions": "error",
        // package.json の依存重複を検出(モノレポ向け)
        "noDuplicateDependencies": "error"
      },
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "warn",
          "options": {
            "style": "type"
          }
        },
        "noParameterAssign": "error",
        "useConsistentArrayType": "error",
        "useArrayLiterals": "error",
        "useBlockStatements": "error"
      },
      "correctness": {
        // 解決できない import を検出(bun:* / astro:* は overrides で除外)
        "noUnresolvedImports": "error"
      },
      "complexity": {
        "noUselessUndefined": "error",
        "useLiteralKeys": "off",
        // 関数の引数は最大3つまで(テストファイルは overrides で除外)
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3
          }
        }
      },
      "nursery": {
        "noUnnecessaryConditions": "error",
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        // .then() / .catch() のネストを禁止し async/await を促進
        "noNestedPromises": "error",
        // a = b = c のような連鎖代入を禁止
        "noMultiAssign": "error",
        // for...in を禁止(Object.keys/entries を使用)
        "noForIn": "error",
        // ++ / -- を禁止し += 1 / -= 1 に統一
        "noIncrementDecrement": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off",
        "noDuplicateClasses": "on"
      }
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 80
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      // Astro ファイルは Prettier でフォーマットするため、Biome はリントのみ
      "includes": ["**/*.astro"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "correctness": {
            // Astro は静的レンダリングのため key 不要
            "useJsxKeyInIterable": "off",
            // Astro では type Props が Astro.props の型推論に使われる
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/common/src/logger.ts",
        "apps/common/src/logger.ts"
      ],
      "linter": {
        "enabled": false
      }
    },
    {
      // bun:test / bun:sqlite などの Bun 組み込みバーチャルモジュールは解決不可
      // テストヘルパーは引数の上限を緩和する
      "includes": ["**/__tests__/**", "**/support/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "complexity": {
            "useMaxParams": "off"
          }
        }
      }
    },
    {
      // astro:content は Astro のバーチャルモジュールで解決不可
      "includes": ["apps/www/src/**/*.ts", "apps/www/src/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    }
  ]
}
