{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "ignoreBinaries": ["similarity-ts"],
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "@actions/core",
        "@actions/github",
        "@secretlint/secretlint-rule-pattern",
        "@secretlint/secretlint-rule-preset-recommend",
        "agent"
      ]
    },
    "apps/www": {
      "entry": [
        "src/pages/**/*.{astro,ts}",
        "src/components/**/*.{astro,tsx}",
        "src/layouts/**/*.astro"
      ],
      "project": ["src/**/*.{astro,ts,tsx}"],
      "ignoreDependencies": ["tailwindcss", "tw-animate-css"],
      "ignoreUnresolved": ["/pagefind/pagefind-highlight.js"]
    },
    "apps/worker": {
      "entry": ["src/**/*.test.ts"],
      "includeEntryExports": false,
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/common": {
      "project": ["src/**/*.ts"]
    },
    "packages/types": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": [".github/**"]
}
