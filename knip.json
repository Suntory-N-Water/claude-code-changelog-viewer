{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "ignoreBinaries": ["similarity-ts"],
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "@actions/core",
        "@actions/github",
        "@secretlint/secretlint-rule-pattern",
        "@secretlint/secretlint-rule-preset-recommend"
      ]
    },
    "apps/www": {
      "entry": ["src/components/**/*.{astro,tsx}", "src/layouts/**/*.astro"],
      "project": ["src/**/*.{astro,ts,tsx,css}"],
      "ignoreDependencies": ["tw-animate-css"],
      "ignoreUnresolved": ["/pagefind/pagefind-highlight.js"]
    },
    "apps/worker": {
      "entry": ["src/**/*.test.ts"],
      "includeEntryExports": false,
      "project": ["src/**/*.ts"]
    },
    "packages/common": {
      "project": ["src/**/*.{ts,mdx}"]
    },
    "packages/types": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": [".github/**"]
}
