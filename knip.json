{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@actions/core", "@actions/github"]
    },
    "apps/www": {
      "entry": [
        "src/pages/**/*.{astro,ts}",
        "src/components/**/*.{astro,tsx}",
        "src/layouts/**/*.astro",
        "scripts/*.ts"
      ],
      "project": ["src/**/*.{astro,ts,tsx}", "scripts/**/*.ts"],
      "ignoreDependencies": ["tailwindcss", "tw-animate-css"]
    },
    "apps/changelog-fetcher": {
      "project": ["src/**/*.ts"]
    },
    "apps/notification-worker": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/docs-tracker": {
      "project": ["src/**/*.ts"]
    },
    "packages/common": {
      "project": ["src/**/*.ts"]
    },
    "packages/types": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": [".github/**"]
}
