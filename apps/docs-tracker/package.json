{
  "name": "docs-tracker",
  "version": "0.0.0",
  "description": "Automatically fetch and track Claude Code documentation changes using Git-based scraping. Pure Markdown storage without HTML processing.",
  "scripts": {
    "dev": "bun src/index.ts",
    "fetch-docs": "bun src/fetch-docs.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "documentation",
    "doc-tracker",
    "scraper",
    "markdown",
    "git-scraping",
    "automation",
    "typescript",
    "github-actions",
    "change-tracking"
  ],
  "license": "MIT",
  "dependencies": {
    "@claude-code-changelog-viewer/common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.3"
  }
}
