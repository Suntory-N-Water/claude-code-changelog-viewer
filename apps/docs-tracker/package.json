{
  "name": "docs-tracker",
  "version": "0.0.0",
  "description": "Automatically fetch and track Claude Code documentation changes using Git-based scraping. Pure Markdown storage without HTML processing.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "fetch-blog": "tsx src/fetch-blog.ts",
    "fetch-docs": "tsx src/fetch-docs.ts",
    "fetch-schema": "tsx src/fetch-schema.ts",
    "fetch-youtube-metadata": "tsx src/fetch-youtube-metadata.ts",
    "fetch-youtube-transcripts": "tsx src/fetch-youtube-transcripts.ts",
    "generate-diff": "tsx src/generate-docs-diff.ts",
    "type-check": "tsc --noEmit",
    "type-check:ai": "tsc --noEmit --pretty false",
    "test": "vitest run"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "documentation",
    "doc-tracker",
    "scraper",
    "markdown",
    "git-scraping",
    "automation",
    "typescript",
    "github-actions",
    "change-tracking"
  ],
  "license": "MIT",
  "dependencies": {
    "@claude-code-changelog-viewer/common": "workspace:*",
    "@google/genai": "catalog:",
    "fast-xml-parser": "^5.9.3",
    "jsdom": "^29.1.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0",
    "youtube-transcript": "^1.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "@types/turndown": "^5.0.6"
  }
}
