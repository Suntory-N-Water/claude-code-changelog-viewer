{
  "name": "docs-tracker",
  "version": "0.0.0",
  "description": "Automatically fetch and track Claude Code documentation changes using Git-based scraping. Pure Markdown storage without HTML processing.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "fetch-docs": "tsx src/fetch-docs.ts"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "documentation",
    "doc-tracker",
    "scraper",
    "markdown",
    "git-scraping",
    "automation",
    "typescript",
    "github-actions",
    "change-tracking"
  ],
  "license": "MIT",
  "dependencies": {
    "@claude-code-changelog-viewer/common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "tsx": "^4.21.0"
  }
}
