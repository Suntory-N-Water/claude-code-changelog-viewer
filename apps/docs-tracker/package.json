{
  "name": "docs-tracker",
  "version": "0.0.0",
  "description": "Automatically fetch and track Claude Code documentation changes using Git-based scraping. Pure Markdown storage without HTML processing.",
  "scripts": {
    "dev": "bun src/index.ts",
    "fetch-docs": "bun src/fetch-docs.ts",
    "type-check": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "documentation",
    "doc-tracker",
    "scraper",
    "markdown",
    "git-scraping",
    "automation",
    "typescript",
    "github-actions",
    "change-tracking"
  ],
  "license": "MIT",
  "dependencies": {
    "@claude-code-changelog-viewer/common": "workspace:*",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.3.3"
  }
}
