{
  "name": "docs-tracker",
  "version": "0.0.0",
  "type": "module",
  "description": "Automatically fetch and track Claude Code documentation changes using Git-based scraping. Pure Markdown storage without HTML processing.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "fetch-docs": "tsx src/fetch-docs.ts",
    "fetch-schema": "tsx src/fetch-schema.ts",
    "type-check": "tsc --noEmit",
    "type-check:ai": "tsc --noEmit --pretty false",
    "test": "vitest run"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "documentation",
    "doc-tracker",
    "scraper",
    "markdown",
    "git-scraping",
    "automation",
    "typescript",
    "github-actions",
    "change-tracking"
  ],
  "license": "MIT",
  "dependencies": {
    "@claude-code-changelog-viewer/common": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
