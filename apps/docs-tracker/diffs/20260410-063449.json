              "content": "```python"
            },
            {
              "type": "added",
              "content": "{"
            },
            {
              "type": "added",
              "content": "    \"taskId\": str,  # ID of the background monitor task"
            },
            {
              "type": "added",
              "content": "    \"timeoutMs\": int,  # Timeout deadline in milliseconds (0 when persistent)"
