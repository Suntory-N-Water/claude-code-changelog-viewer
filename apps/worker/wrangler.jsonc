{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "changelog-viewer-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-19",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WORKER_URL": "https://claude-code-log.com",
    "SITE_URL": "https://claude-code-log.com",
    "EMAIL_FROM": "noreply@claude-code-log.com",
    "CF_ACCESS_TEAM_DOMAIN": "1202ayasnppk.cloudflareaccess.com",
    "AI_GATEWAY_ID": "default",
    // R2 へ export する対象。d1_databases の DB と同じデータベースを指す
    "BACKUP_DATABASE_ID": "d4301e1b-c7ae-427d-8017-8735b01e5943"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY",
      "DISPATCH_SECRET",
      "EMAIL_ENCRYPTION_KEY",
      "GITHUB_DISPATCH_TOKEN",
      "CF_ACCESS_AUD",
      "DEPLOY_HOOK_URL",
      "CLOUDFLARE_ACCOUNT_ID",
      "D1_REST_API_TOKEN"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "workflows": [
    {
      "name": "changelog-inference",
      "binding": "CHANGELOG_INFERENCE_WORKFLOW",
      "class_name": "ChangelogInferenceWorkflow"
    },
    {
      "name": "d1-backup",
      "binding": "D1_BACKUP_WORKFLOW",
      "class_name": "D1BackupWorkflow",
      // 曜日フィールドは 1-7 で 1 が日曜のため、数値ではなくテキストで土曜を指定する。
      // UTC 土曜 17:00 = JST 日曜 2:00 で、既存 cron と重ならない
      "schedules": ["0 17 * * SAT"]
    },
    {
      "name": "settings-reference",
      "binding": "SETTINGS_REFERENCE_WORKFLOW",
      "class_name": "SettingsReferenceWorkflow",
      "schedules": ["0 21 * * *"]
    }
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notification-db",
      "database_id": "d4301e1b-c7ae-427d-8017-8735b01e5943",
      "migrations_dir": "drizzle/migrations"
    },
    {
      "binding": "DOCS_DB",
      "database_name": "docs-search-db",
      "database_id": "17168c5c-4920-41de-a184-a95562131727",
      "migrations_dir": "docs-search/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CHANGELOG_DETECTION_KV",
      "id": "7aa4212531eb4ac4a0bf0cd0e19e1e2e"
    }
  ],
  "ratelimits": [
    {
      "name": "WEBHOOK_RATE_LIMITER",
      "namespace_id": "764001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "764002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SITE_DATA_RATE_LIMITER",
      "namespace_id": "764003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "WEEKLY_ASSETS",
      "bucket_name": "weekly-assets"
    },
    {
      "binding": "D1_BACKUP_BUCKET",
      "bucket_name": "changelog-viewer-d1-backup"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "changelog-notification"
      }
    ],
    "consumers": [
      {
        "queue": "changelog-notification",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "changelog-notification-dlq",
        "retry_delay": 60
      }
    ]
  },
  "routes": [
    {
      "pattern": "claude-code-log.com/api/*",
      "zone_name": "claude-code-log.com"
    },
    {
      "pattern": "claude-code-log.com/mcp",
      "zone_name": "claude-code-log.com"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    // "0 15 * * *": UTC のため JST 換算で 毎日 0 時 (cleanup)
    // "*/5 * * * *": CHANGELOG.md の変化検知 (5 分間隔)
    // "0 */3 * * *": 公式ドキュメント・設定スキーマの同期 (3 時間間隔)
    "crons": ["0 15 * * *", "*/5 * * * *", "0 */3 * * *"]
  }
}
