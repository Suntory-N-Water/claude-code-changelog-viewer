---

// Footer.astro - CCログ超訳 Footer Component
import Icon from './Icon.astro';

const appVersion = __APP_VERSION__;
---

<footer class='mt-24'>
  <div class='max-w-4xl mx-auto px-4 sm:px-6 py-12'>
    <!-- AI生成コンテンツの注意書き -->
    <div
      class='mb-10 p-5 bg-[hsl(var(--cc-main-orange)/0.04)] border-l-4 border-[hsl(var(--cc-main-orange))] rounded-r-xl'
    >
      <p class='text-sm font-semibold text-[hsl(var(--cc-main-black))] mb-1'>
        AI生成コンテンツについて
      </p>
      <p class='text-sm text-[hsl(var(--cc-main-black)/0.7)] leading-relaxed'>
        ページの概要(サマリー)、変更内容の日本語訳、ユーザーへの恩恵の解説はAIによって生成されているため、誤っている可能性があります。正確な情報は
        <a
          href='https://github.com/anthropics/claude-code/releases'
          target='_blank'
          rel='noopener noreferrer'
          class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
        >
          公式リリースノート
        </a>
        をご確認ください。
      </p>
    </div>

    <!-- リンクセクション -->
    <div class='grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-12 mb-10'>
      <div>
        <p
          class='text-xs font-bold text-[hsl(var(--cc-main-black)/0.4)] mb-4 tracking-widest uppercase'
        >
          リソース
        </p>
        <ul class='space-y-3'>
          <li>
            <a
              href='https://github.com/anthropics/claude-code'
              target='_blank'
              rel='noopener noreferrer'
              class='text-sm text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors inline-flex items-center gap-2.5'
            >
              <Icon name='github' class='w-4 h-4' aria-hidden='true' />
              Claude Code GitHub
            </a>
          </li>
          <li>
            <a
              href='https://code.claude.com/docs'
              target='_blank'
              rel='noopener noreferrer'
              class='text-sm text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors inline-flex items-center gap-2.5'
            >
              <Icon name='document' class='w-4 h-4' aria-hidden='true' />
              公式ドキュメント
            </a>
          </li>
          <li>
            <a
              href='/'
              class='text-sm text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors inline-flex items-center gap-2.5'
            >
              <Icon name='list' class='w-4 h-4' aria-hidden='true' />
              バージョンの変更履歴
            </a>
          </li>
          <li>
            <a
              href='/features'
              class='text-sm text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors inline-flex items-center gap-2.5'
            >
              <Icon name='grid' class='w-4 h-4' aria-hidden='true' />
              機能エリア別の変更履歴
            </a>
          </li>
          <li>
            <a
              href='/docs'
              class='text-sm text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors inline-flex items-center gap-2.5'
            >
              <Icon name='document-file' class='w-4 h-4' aria-hidden='true' />
              公式ドキュメント更新履歴
            </a>
          </li>
          <li>
            <a
              href='/rss.xml'
              class='text-sm text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors inline-flex items-center gap-2.5'
            >
              <Icon name='rss' class='w-4 h-4' aria-hidden='true' />
              RSSフィード
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p
          class='text-xs font-bold text-[hsl(var(--cc-main-black)/0.4)] mb-4 tracking-widest uppercase'
        >
          プロジェクト
        </p>
        <ul class='space-y-3'>
          <li>
            <a
              href='https://github.com/Suntory-N-Water/claude-code-changelog-viewer'
              target='_blank'
              rel='noopener noreferrer'
              class='text-sm text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors inline-flex items-center gap-2.5'
            >
              <Icon name='github' class='w-4 h-4' aria-hidden='true' />
              GitHubリポジトリ
            </a>
          </li>
          <li>
            <a
              href='/notify'
              class='text-sm text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors inline-flex items-center gap-2.5'
            >
              <Icon name='bell' class='w-4 h-4' aria-hidden='true' />
              通知設定
            </a>
          </li>
          <li>
            <a
              href='/about'
              class='text-sm text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors inline-flex items-center gap-2.5'
            >
              <Icon name='info-circle' class='w-4 h-4' aria-hidden='true' />
              このサイトについて
            </a>
          </li>
          <li>
            <a
              href='/contact'
              class='text-sm text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors inline-flex items-center gap-2.5'
            >
              <Icon name='mail' class='w-4 h-4' aria-hidden='true' />
              お問い合わせ
            </a>
          </li>
          <li>
            <a
              href='/privacy'
              class='text-sm text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors inline-flex items-center gap-2.5'
            >
              <Icon name='shield-check' class='w-4 h-4' aria-hidden='true' />
              プライバシーポリシー
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- フッターボトム -->
    <div
      class='pt-6 border-t border-[hsl(var(--cc-gray))] flex flex-wrap items-center justify-between gap-2'
    >
      <p class='text-xs text-[hsl(var(--cc-main-black)/0.4)]'>
        非公式プロジェクト。AnthropicおよびClaudeはAnthropic, PBCの商標です。
      </p>
      <span
        class='text-xs text-[hsl(var(--cc-main-black)/0.3)]'
        style='font-variant-numeric: tabular-nums;'
      >
        v{appVersion}
      </span>
    </div>
  </div>
</footer>
