---
// Footer.astro - CCログ超訳 Footer Component
import { FOOTER_SECTIONS } from '../lib/navigation';
import Icon from './Icon.astro';
---

<footer class='mt-24'>
  <div class='max-w-4xl mx-auto px-4 sm:px-6 py-12'>
    <!-- AI生成コンテンツの注意書き -->
    <div
      class='mb-10 p-5 bg-[hsl(var(--cc-main-orange)/0.04)] border-l-4 border-[hsl(var(--cc-main-orange))] rounded-r-xl flex flex-wrap items-center gap-x-6 gap-y-3 text-sm'
    >
      <p class='flex items-center gap-2 text-[hsl(var(--cc-main-black)/0.8)]'>
        <Icon
          name='warning'
          class='w-4 h-4 shrink-0 text-[hsl(var(--cc-main-orange))]'
          aria-hidden='true'
        />
        翻訳と解説は AI 生成のため誤りを含む場合があります
      </p>
      <a
        href='https://github.com/anthropics/claude-code/releases'
        target='_blank'
        rel='noopener noreferrer'
        class='inline-flex items-center gap-1 text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline transition-colors'
      >
        公式リリースノートを開く
        <Icon name='external-link' class='w-3.5 h-3.5' aria-hidden='true' />
      </a>
    </div>

    <!-- リンクセクション -->
    <nav
      class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10 mb-10'
      aria-label='フッターメニュー'
    >
      {
        FOOTER_SECTIONS.map((section) => (
          <div>
            <p class='text-xs font-bold text-[hsl(var(--cc-main-black)/0.5)] mb-4 tracking-widest uppercase'>
              {section.title}
            </p>
            <ul class='space-y-1'>
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                    class='inline-flex items-center gap-2.5 -mx-2 px-2 py-2 min-h-11 sm:min-h-0 sm:py-1.5 rounded-md text-sm text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] hover:bg-[hsl(var(--cc-main-orange)/0.06)] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--cc-main-orange))]'
                  >
                    <Icon name={link.icon} class='w-4 h-4 shrink-0' aria-hidden='true' />
                    {link.label}
                    {link.external && (
                      <Icon
                        name='external-link'
                        class='w-3 h-3 shrink-0 text-[hsl(var(--cc-main-black)/0.4)]'
                        aria-hidden='true'
                      />
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <!-- フッターボトム -->
    <div
      class='pt-6 border-t border-[hsl(var(--cc-gray))] flex flex-wrap items-center justify-between gap-2'
    >
      <p class='text-xs text-[hsl(var(--cc-main-black)/0.4)]'>
        非公式プロジェクト。AnthropicおよびClaudeはAnthropic, PBCの商標です。
      </p>
    </div>
  </div>
</footer>
