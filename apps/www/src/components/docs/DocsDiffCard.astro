---

import { TZDate } from '@date-fns/tz';
import { format } from 'date-fns';
import { ja } from 'date-fns/locale';
import Icon from '../Icon.astro';
import { formatChangelogContent } from '../../lib/format-changelog-content';

type DocFileDiff = {
  filename: string;
  additions: number;
  deletions: number;
};

type Props = {
  id: string;
  timestamp: string;
  aiSummary: string;
  files: DocFileDiff[];
};

const { id, timestamp, aiSummary, files } = Astro.props;

const jstDate = new TZDate(timestamp, 'Asia/Tokyo');
const formattedDate = format(jstDate, 'yyyy年M月d日 HH:mm', { locale: ja });
const formattedSummary = formatChangelogContent(aiSummary);

const totalAdditions = files.reduce((sum, f) => sum + f.additions, 0);
const totalDeletions = files.reduce((sum, f) => sum + f.deletions, 0);
---

<article
  class='bg-[hsl(var(--cc-main-white))] rounded-xl border border-[hsl(var(--cc-gray))] overflow-hidden hover:border-[hsl(var(--cc-main-orange)/0.4)] hover:shadow-sm transition-[box-shadow,border-color] duration-200'
>
  <!-- カードヘッダー -->
  <div
    class='px-5 py-3 border-b border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-gray)/0.25)]'
  >
    <div class='flex flex-wrap items-center justify-between gap-2'>
      <div class='flex items-center gap-2'>
        <Icon
          name='clock'
          class='w-4 h-4 text-[hsl(var(--cc-main-orange))] shrink-0'
          aria-hidden='true'
        />
        <time
          datetime={timestamp}
          class='text-sm font-semibold text-[hsl(var(--cc-main-black))]'
        >
          {formattedDate}
        </time>
      </div>
      <div
        class='flex items-center gap-1.5 text-xs text-[hsl(var(--cc-main-black)/0.5)]'
      >
        <span class='text-green-700 font-mono font-medium tabular-nums'
          >+{totalAdditions}</span
        >
        <span class='text-red-600 font-mono font-medium tabular-nums'
          >-{totalDeletions}</span
        >
        <span aria-hidden='true'>·</span>
        <span>{files.length} ファイル</span>
      </div>
    </div>
  </div>

  <div class='px-5 py-4 space-y-3'>
    <!-- サマリー -->
    <p
      class='text-sm text-[hsl(var(--cc-main-black))] leading-relaxed'
      set:html={formattedSummary}
    />

    <!-- 変更ファイル一覧 -->
    <div class='flex flex-wrap gap-1.5'>
      {
        files.map((file) => (
          <a
            href={`/docs/${id}#${file.filename.replace('.md', '').replace(/\//g, '-')}`}
            class='inline-flex items-center gap-1 px-2 py-1 rounded-md bg-[hsl(var(--cc-gray)/0.5)] hover:bg-[hsl(var(--cc-gray))] text-xs font-mono text-[hsl(var(--cc-main-black)/0.8)] transition-[background-color] min-h-7'
          >
            <span class='text-green-700 font-medium'>+{file.additions}</span>
            <span class='text-red-600 font-medium'>-{file.deletions}</span>
            <span class='text-[hsl(var(--cc-main-black)/0.5)] ml-0.5 truncate max-w-45'>
              {file.filename.replace(/\.md$/, '')}
            </span>
          </a>
        ))
      }
    </div>

    <!-- 詳細リンク -->
    <div class='pt-2 border-t border-[hsl(var(--cc-gray)/0.6)]'>
      <a
        href={`/docs/${id}`}
        class='inline-flex items-center gap-1 text-xs font-medium text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] transition-colors'
        aria-label={`${formattedDate} の diff 詳細を表示`}
      >
        diff 詳細を表示
        <svg
          class='w-3 h-3'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2.5'
          aria-hidden='true'
        >
          <path stroke-linecap='round' stroke-linejoin='round' d='M9 5l7 7-7 7'
          ></path>
        </svg>
      </a>
    </div>
  </div>
</article>
