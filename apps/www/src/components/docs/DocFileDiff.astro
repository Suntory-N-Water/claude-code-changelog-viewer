---
import Icon from '../Icon.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';

type DiffLine = {
  type: 'added' | 'removed' | 'context';
  content: string;
};

type DiffHunk = {
  header: string;
  lines: DiffLine[];
};

type Props = {
  filename: string;
  additions: number;
  deletions: number;
  explanation?: string;
  hunks: DiffHunk[];
};

const { filename, additions, deletions, explanation, hunks } = Astro.props;

const docUrl = `https://code.claude.com/docs/en/${filename.replace(/\.md$/, '')}`;
---

<Card padding='none' radius='lg' class='overflow-hidden font-mono text-xs'>
  <!-- ファイルヘッダー -->
  <div
    class='bg-[hsl(var(--cc-gray)/0.4)] border-b border-[hsl(var(--cc-gray))]'
  >
    <div class='px-4 py-2.5 flex items-center gap-2.5'>
      <Icon
        name='document-file'
        class='w-3.5 h-3.5 text-[hsl(var(--cc-main-black)/0.45)] shrink-0'
        stroke-width='1.5'
        aria-hidden='true'
      />
      <span
        class='text-[hsl(var(--cc-main-black))] font-semibold flex-1 truncate text-xs'
      >
        {filename.replace(/\.md$/, '')}
      </span>
      <Button
        href={docUrl}
        target='_blank'
        rel='noopener noreferrer'
        variant='ghost'
        size='icon-sm'
        class='shrink-0 -mr-1 w-auto h-auto p-1.5 hover:bg-transparent'
        aria-label='公式ドキュメントを開く(外部リンク)'
      >
        <Icon
          name='external-link'
          class='w-3.5 h-3.5'
          stroke-width='1.8'
          aria-hidden='true'
        />
      </Button>
      <span class='text-green-700 font-medium shrink-0'>+{additions}</span>
      <span class='text-red-600 font-medium shrink-0'>-{deletions}</span>
    </div>
    {
      explanation && (
        <div class='px-4 py-2.5 border-t border-[hsl(var(--cc-gray)/0.6)] bg-white'>
          <p class='text-xs text-[hsl(var(--cc-main-black)/0.8)] leading-relaxed font-sans'>
            {explanation}
          </p>
        </div>
      )
    }
  </div>

  {
    hunks.length === 0 ? (
      <div class='px-4 py-3 text-[hsl(var(--cc-main-black)/0.4)] text-xs'>
        (差分が大きいため省略しています)
      </div>
    ) : (
      <div class='overflow-x-auto'>
        <div class='min-w-max'>
          {hunks.map((hunk) => (
            <>
              {/* ハンクヘッダー */}
              <div class='bg-[hsl(var(--cc-main-orange)/0.08)] text-[hsl(var(--cc-main-orange))] px-4 py-1 text-xs border-y border-[hsl(var(--cc-main-orange)/0.15)] select-none whitespace-nowrap'>
                {hunk.header}
              </div>
              {/* diff 行 */}
              {hunk.lines.map((line) => (
                <div
                  class={`flex leading-5 ${
                    line.type === 'added'
                      ? 'bg-green-50 border-l-2 border-green-500'
                      : line.type === 'removed'
                        ? 'bg-red-50 border-l-2 border-red-500'
                        : 'border-l-2 border-transparent'
                  }`}
                >
                  <span
                    class={`select-none w-5 text-center shrink-0 leading-5 py-0.5 ${
                      line.type === 'added'
                        ? 'text-green-600'
                        : line.type === 'removed'
                          ? 'text-red-500'
                          : 'text-[hsl(var(--cc-main-black)/0.3)]'
                    }`}
                    aria-hidden='true'
                  >
                    {line.type === 'added'
                      ? '+'
                      : line.type === 'removed'
                        ? '-'
                        : ' '}
                  </span>
                  <span
                    class={`px-2 py-0.5 whitespace-pre flex-1 ${
                      line.type === 'added'
                        ? 'text-green-900'
                        : line.type === 'removed'
                          ? 'text-red-900'
                          : 'text-[hsl(var(--cc-main-black)/0.7)]'
                    }`}
                  >
                    {line.content}
                  </span>
                </div>
              ))}
            </>
          ))}
        </div>
      </div>
    )
  }
</Card>
