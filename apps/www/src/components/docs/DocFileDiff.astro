---
type DiffLine = {
  type: 'added' | 'removed' | 'context';
  content: string;
};

type DiffHunk = {
  header: string;
  lines: DiffLine[];
};

type Props = {
  filename: string;
  additions: number;
  deletions: number;
  hunks: DiffHunk[];
};

const { filename, additions, deletions, hunks } = Astro.props;
---

<div
  class='border border-[hsl(var(--cc-gray))] rounded-lg overflow-hidden font-mono text-xs'
>
  <!-- ファイルヘッダー -->
  <div
    class='bg-[hsl(var(--cc-gray)/0.4)] px-4 py-2.5 flex items-center gap-2.5 border-b border-[hsl(var(--cc-gray))]'
  >
    <svg
      class='w-3.5 h-3.5 text-[hsl(var(--cc-main-black)/0.45)] shrink-0'
      fill='none'
      viewBox='0 0 24 24'
      stroke='currentColor'
      stroke-width='1.5'
      aria-hidden='true'
    >
      <path
        stroke-linecap='round'
        stroke-linejoin='round'
        d='M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z'
      ></path>
    </svg>
    <span
      class='text-[hsl(var(--cc-main-black))] font-semibold flex-1 truncate text-xs'
    >
      {filename}
    </span>
    <span class='text-green-700 font-medium shrink-0'>+{additions}</span>
    <span class='text-red-600 font-medium shrink-0'>-{deletions}</span>
  </div>

  {
    hunks.length === 0 ? (
      <div class='px-4 py-3 text-[hsl(var(--cc-main-black)/0.4)] text-xs italic'>
        (詳細なし)
      </div>
    ) : (
      <div class='overflow-x-auto'>
        {hunks.map((hunk) => (
          <>
            {/* ハンクヘッダー */}
            <div class='bg-[hsl(var(--cc-main-orange)/0.08)] text-[hsl(var(--cc-main-orange))] px-4 py-1 text-xs border-y border-[hsl(var(--cc-main-orange)/0.15)] select-none'>
              {hunk.header}
            </div>
            {/* diff 行 */}
            {hunk.lines.map((line) => (
              <div
                class={`flex leading-5 ${
                  line.type === 'added'
                    ? 'bg-green-50 border-l-2 border-green-500'
                    : line.type === 'removed'
                      ? 'bg-red-50 border-l-2 border-red-500'
                      : 'border-l-2 border-transparent'
                }`}
              >
                <span
                  class={`select-none w-5 text-center shrink-0 leading-5 py-0.5 ${
                    line.type === 'added'
                      ? 'text-green-600'
                      : line.type === 'removed'
                        ? 'text-red-500'
                        : 'text-[hsl(var(--cc-main-black)/0.3)]'
                  }`}
                  aria-hidden='true'
                >
                  {line.type === 'added'
                    ? '+'
                    : line.type === 'removed'
                      ? '-'
                      : ' '}
                </span>
                <span
                  class={`px-2 py-0.5 whitespace-pre flex-1 ${
                    line.type === 'added'
                      ? 'text-green-900'
                      : line.type === 'removed'
                        ? 'text-red-900'
                        : 'text-[hsl(var(--cc-main-black)/0.7)]'
                  }`}
                >
                  {line.content}
                </span>
              </div>
            ))}
          </>
        ))}
      </div>
    )
  }
</div>
