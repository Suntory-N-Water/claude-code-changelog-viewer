---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'input'>, 'class'> & {
  invalidStyle?: boolean;
  class?: string;
};

const { invalidStyle = false, class: className, ...attributes } = Astro.props;
---

<input
  class:list={[
    'w-full min-h-11 px-4 py-2.5 rounded-lg border border-rule-2 bg-paper text-base text-ink placeholder:text-muted focus-visible:outline-2 focus-visible:-outline-offset-1 focus-visible:outline-focus disabled:cursor-not-allowed disabled:opacity-55',
    invalidStyle && 'invalid:not-placeholder-shown:border-error',
    className,
  ]}
  {...attributes}
/>
