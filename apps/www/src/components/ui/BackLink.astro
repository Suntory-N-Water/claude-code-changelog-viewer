---
import type { HTMLAttributes } from 'astro/types';
import Icon from '../Icon.astro';

type Props = Omit<HTMLAttributes<'a'>, 'class'> & {
  href: string;
  tone?: 'muted' | 'accent';
  class?: string;
};

const { href, tone = 'muted', class: className, ...attributes } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-1.5 min-h-10 text-sm transition-colors underline-offset-4 hover:underline',
    tone === 'accent' ? 'text-accent-text' : 'text-muted hover:text-ink',
    className,
  ]}
  {...attributes}
>
  <Icon name='arrow-left' class='w-4 h-4' aria-hidden='true' />
  <slot>戻る</slot>
</a>
