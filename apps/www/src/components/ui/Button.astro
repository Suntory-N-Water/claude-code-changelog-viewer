---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'button'> & HTMLAttributes<'a'>, 'class'> & {
  href?: string;
  variant?: 'primary' | 'outline' | 'ghost' | 'link';
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'icon-sm' | 'icon';
  shape?: 'default' | 'pill';
  fullWidth?: boolean;
  class?: string;
};

const {
  href,
  variant = 'primary',
  size = 'md',
  shape = 'default',
  fullWidth = false,
  class: className,
  ...attributes
} = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  class:list={[
    'inline-flex items-center justify-center whitespace-nowrap cursor-pointer font-medium transition-[background-color,border-color,color,transform] duration-(--dur-micro) active:translate-y-px disabled:cursor-not-allowed disabled:opacity-55',
    {
      'bg-accent text-accent-ink hover:bg-accent-strong': variant === 'primary',
      'border border-rule-2 text-ink hover:border-ink hover:bg-paper-2': variant === 'outline',
      'text-ink-2 hover:text-ink hover:bg-paper-2': variant === 'ghost',
      'text-accent-text underline-offset-4 hover:underline': variant === 'link',
      'min-h-11 px-5 py-2 text-sm gap-1.5': size === 'md',
      'px-3 py-1.5 text-xs gap-1': size === 'xs',
      'min-h-11 px-4 py-2 text-sm gap-2': size === 'sm',
      'min-h-12 px-6 py-3 gap-2': size === 'lg',
      'w-8 h-8': size === 'icon-sm',
      'w-11 h-11': size === 'icon',
      'rounded-lg': shape === 'default',
      'rounded-full': shape === 'pill',
      'w-full': fullWidth,
    },
    className,
  ]}
  {...attributes}
>
  <slot />
</Tag>
