---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'div'>, 'class'> & {
  as?: 'div' | 'article' | 'section' | 'aside';
  variant?: 'default' | 'page' | 'muted' | 'accent' | 'dashed';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  radius?: 'lg' | 'xl';
  interactive?: boolean;
  class?: string;
};

const {
  as: Tag = 'div',
  variant = 'page',
  padding = 'md',
  radius = 'xl',
  interactive = false,
  class: className,
  ...attributes
} = Astro.props;
---

<Tag
  class:list={[
    {
      'border border-rule bg-paper text-ink': variant === 'default' || variant === 'page',
      'bg-paper-2': variant === 'muted',
      'bg-[color-mix(in_oklab,var(--color-accent)_10%,var(--color-paper))]': variant === 'accent',
      'border border-dashed border-rule-2': variant === 'dashed',
      'p-4': padding === 'sm',
      'p-5 sm:p-6': padding === 'md',
      'p-6 sm:p-8': padding === 'lg',
      'rounded-lg': radius === 'lg',
      'rounded-xl': radius === 'xl',
      'transition-colors duration-(--dur-short) hover:border-ink': interactive,
    },
    className,
  ]}
  {...attributes}
>
  <slot />
</Tag>
