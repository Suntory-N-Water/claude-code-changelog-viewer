---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'span'>, 'class'> & {
  href?: string;
  variant?: 'neutral' | 'accent' | 'outline' | 'prefix';
  size?: 'xs' | 'sm';
  class?: string;
};

const { href, variant = 'neutral', size = 'sm', class: className, ...attributes } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  class:list={[
    'inline-flex items-center rounded-md',
    {
      'bg-[hsl(var(--cc-gray)/0.5)] text-[hsl(var(--cc-main-black)/0.7)]': variant === 'neutral',
      'bg-[hsl(var(--cc-main-orange)/0.1)] text-[hsl(var(--cc-main-orange))]': variant === 'accent',
      'border border-[hsl(var(--cc-gray))] text-[hsl(var(--cc-main-black)/0.7)]':
        variant === 'outline',
      'font-mono font-medium': variant === 'prefix',
      'px-1.5 py-0.5 text-[11px]': size === 'xs',
      'px-2 py-0.5 text-xs': size === 'sm',
    },
    className,
  ]}
  {...attributes}
>
  <slot />
</Tag>
