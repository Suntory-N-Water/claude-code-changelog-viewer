---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'span'>, 'class'> & {
  href?: string;
  variant?: 'neutral' | 'accent' | 'outline' | 'prefix';
  size?: 'xs' | 'sm';
  shape?: 'rounded' | 'pill';
  class?: string;
};

const {
  href,
  variant = 'neutral',
  size = 'sm',
  shape = 'pill',
  class: className,
  ...attributes
} = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  class:list={[
    'inline-flex items-center',
    {
      'bg-paper-3 text-ink-2': variant === 'neutral',
      'bg-[color-mix(in_oklab,var(--color-accent)_16%,var(--color-paper))] text-accent-text':
        variant === 'accent',
      'border border-rule-2 text-ink-2': variant === 'outline',
      'font-semibold': variant === 'prefix',
      'px-1.5 py-0.5 text-[11px]': size === 'xs',
      'px-2 py-0.5 text-xs': size === 'sm',
      rounded: shape === 'rounded',
      'rounded-full': shape === 'pill',
    },
    className,
  ]}
  {...attributes}
>
  <slot />
</Tag>
