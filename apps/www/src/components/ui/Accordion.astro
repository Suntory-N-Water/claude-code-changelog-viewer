---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'details'>, 'class'> & {
  variant?: 'page' | 'muted' | 'plain';
  class?: string;
};

const { variant = 'page', class: className, ...attributes } = Astro.props;
---

<details
  class:list={[
    {
      'rounded-lg border border-rule bg-paper': variant === 'page',
      'rounded-lg bg-paper-2': variant === 'muted',
      'border-b border-rule': variant === 'plain',
    },
    className,
  ]}
  {...attributes}
>
  <slot />
</details>
