---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'button'>, 'class'> & {
  active?: boolean;
  class?: string;
};

const { active = false, class: className, ...attributes } = Astro.props;
---

<button
  type='button'
  class:list={[
    'min-h-11 px-4 py-3 text-sm font-medium whitespace-nowrap border-b-2 border-transparent text-muted hover:text-ink -mb-px transition-colors cursor-pointer aria-selected:border-accent aria-selected:text-ink',
    className,
  ]}
  {...attributes}
>
  <slot />
</button>
