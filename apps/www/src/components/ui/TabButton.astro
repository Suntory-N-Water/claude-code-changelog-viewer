---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'button'>, 'class'> & {
  active?: boolean;
  class?: string;
};

const { active = false, class: className, ...attributes } = Astro.props;
---

<button
  type='button'
  class:list={[
    'px-4 py-3 text-sm font-medium border-b-2 -mb-px transition-colors cursor-pointer',
    active
      ? 'border-[hsl(var(--cc-main-orange))] text-[hsl(var(--cc-main-orange))]'
      : 'border-transparent text-[hsl(var(--cc-main-black)/0.5)] hover:text-[hsl(var(--cc-main-black)/0.8)]',
    className,
  ]}
  {...attributes}
>
  <slot />
</button>
