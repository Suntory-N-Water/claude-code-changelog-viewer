---
import type { HTMLAttributes } from 'astro/types';
import Icon from '../Icon.astro';

type Props = Omit<HTMLAttributes<'a'>, 'class'> & {
  href: string;
  padding?: 'md' | 'lg';
  iconSize?: 'sm' | 'md';
  class?: string;
};

const { href, padding = 'lg', iconSize = 'md', class: className, ...attributes } = Astro.props;
---

<a
  href={href}
  class:list={[
    'block rounded-xl border border-rule bg-paper text-ink transition-colors duration-(--dur-short) hover:border-ink overflow-hidden group cursor-pointer',
    className,
  ]}
  {...attributes}
>
  <div class:list={['flex items-center justify-between gap-4', padding === 'lg' ? 'p-6' : 'p-5']}>
    <div class='min-w-0 flex-1'>
      <slot>詳細を見る</slot>
    </div>
    <Icon
      name='chevron-right'
      class:list={[
        'text-muted group-hover:text-ink transition-colors shrink-0',
        iconSize === 'md' ? 'w-5 h-5' : 'w-4 h-4 mt-0.5',
      ]}
      aria-hidden='true'
    />
  </div>
</a>
