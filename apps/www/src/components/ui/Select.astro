---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'select'>, 'class'> & {
  class?: string;
};

const { class: className, ...attributes } = Astro.props;
---

<select
  class:list={[
    'rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(var(--cc-main-orange)/0.45)] transition-colors disabled:cursor-not-allowed disabled:opacity-50',
    className,
  ]}
  {...attributes}
>
  <slot />
</select>
