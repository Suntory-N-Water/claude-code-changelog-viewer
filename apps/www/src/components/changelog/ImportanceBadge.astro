---
import { getImportanceLevel } from '@claude-code-changelog-viewer/types';

interface Props {
  score: number;
}

const { score } = Astro.props;
const level = getImportanceLevel(score);

const styles = {
  high: 'bg-[hsl(var(--cc-main-orange))] text-white',
  medium: 'bg-[hsl(var(--cc-gray))] text-[hsl(var(--cc-main-black))]',
  low: 'border border-[hsl(var(--cc-gray))] text-[hsl(var(--cc-main-black))]'
};

const labels = {
  high: '重要',
  medium: '変更',
  low: '修正'
};
---
<span class={`inline-block px-3 py-1 rounded-full text-sm font-medium ${styles[level]}`}>
  {labels[level]}
</span>
