---
import Badge from '../ui/Badge.astro';
import CardLink from '../ui/CardLink.astro';

type Props = {
  version: string;
  itemCount: number;
  summary?: string;
  diffStatus?: 'removed' | 'changed';
};

const { version, itemCount, summary, diffStatus } = Astro.props;
---

<CardLink href={`/changelog/v${version}`} class='version-card'>
  <div class='flex flex-wrap items-center gap-2 mb-1'>
    <h2 class='font-mono text-xl font-semibold text-balance text-[hsl(var(--cc-main-orange))] group-hover:text-[hsl(var(--cc-orange-hover))] transition-[color] tabular-nums'>
      v{version}
    </h2>
    {diffStatus === 'removed' && (
      <Badge size='xs' class='bg-[hsl(var(--cc-gray))] text-[hsl(var(--cc-main-black))]'>
        削除済み
      </Badge>
    )}
    {diffStatus === 'changed' && (
      <Badge size='xs' class='bg-[hsl(var(--cc-gray))] text-[hsl(var(--cc-main-black))]'>
        更新あり
      </Badge>
    )}
  </div>
  <p class='font-mono text-xs text-muted-foreground tabular-nums'>{itemCount}件の変更</p>
  {summary && <p class='mt-3 text-sm leading-relaxed text-gray-600 line-clamp-2'>{summary}</p>}
</CardLink>
