---
interface Props {
  version: string;
  itemCount: number;
}

const { version, itemCount } = Astro.props;
---

<a
  href={`/changelog/v${version}`}
  class='version-card block bg-card text-card-foreground rounded-xl border shadow-sm hover:shadow-lg hover:border-[hsl(var(--cc-main-orange))] transition-all duration-200 overflow-hidden group'
>
  <div class='p-6'>
    <h2
      class='text-2xl font-bold text-[hsl(var(--cc-main-orange))] mb-2 group-hover:text-[hsl(var(--cc-orange-hover))] transition-colors'
      style={`view-transition-name: version-title-${version}`}
    >
      v{version}
    </h2>
    <p class='text-sm text-muted-foreground'>
      変更項目: {itemCount}件
    </p>
  </div>
</a>
