---
interface Props {
  version: string;
  itemCount: number;
}

const { version, itemCount } = Astro.props;
---
<a
  href={`/changelog/v${version}`}
  class="block border-2 border-[hsl(var(--cc-gray))] rounded-lg p-6 bg-white hover:border-[hsl(var(--cc-main-orange))] hover:shadow-lg transition-all"
>
  <h2 class="text-2xl font-bold text-[hsl(var(--cc-main-orange))] mb-2">
    v{version}
  </h2>
  <p class="text-sm text-gray-600">
    変更項目: {itemCount}件
  </p>
</a>
