---
import Icon from '../Icon.astro';
import { formatChangelogContent } from '../../lib/format-changelog-content';

type Props = {
  benefit: string;
};

const { benefit } = Astro.props;

const formattedBenefit = formatChangelogContent(benefit);
---

<div class='mt-4 border-l-4 border-[hsl(var(--cc-main-orange))] pl-4'>
  <div class='flex items-start gap-2'>
    <Icon
      name='check-circle'
      class='w-4 h-4 text-[hsl(var(--cc-main-orange))] shrink-0 mt-0.5'
      aria-hidden='true'
    />
    <div class='min-w-0'>
      <p class='font-semibold text-sm text-[hsl(var(--cc-main-orange))]'>変更後</p>
      <p class='mt-1 text-sm wrap-break-word font-medium' set:html={formattedBenefit} />
    </div>
  </div>
</div>
