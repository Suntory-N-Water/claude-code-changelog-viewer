---
import { formatChangelogContent } from '../../lib/format-changelog-content';

type Props = {
  benefit: string;
};

const { benefit } = Astro.props;

const formattedBenefit = formatChangelogContent(benefit);
---

<div class='mt-4 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 text-[15px] leading-relaxed'>
  <p class='font-semibold text-accent-text whitespace-nowrap'>変更後</p>
  <p class='text-ink-2 wrap-break-word' set:html={formattedBenefit} />
</div>
