---
import type { InferenceResult } from '@claude-code-changelog-viewer/types';

interface Props {
  inference: InferenceResult;
}

const { inference } = Astro.props;
---

<div class='mt-4 space-y-4 border-l-4 border-[hsl(var(--cc-main-orange))] pl-4'>
  <div>
    <h4 class='font-semibold text-sm text-gray-600'>変更前</h4>
    <p class='mt-1 text-sm text-pretty'>{inference.before}</p>
  </div>

  <div>
    <h4 class='font-semibold text-sm text-gray-600'>変更後</h4>
    <p class='mt-1 text-sm text-pretty'>{inference.after}</p>
  </div>

  <div>
    <h4 class='font-semibold text-sm text-[hsl(var(--cc-main-orange))]'>
      ユーザーへの恩恵
    </h4>
    <p class='mt-1 text-sm text-pretty font-medium'>{inference.benefit}</p>
  </div>
</div>
