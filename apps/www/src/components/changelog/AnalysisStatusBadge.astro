---
import { ANALYSIS_STATUS_LABELS, type AnalysisStatus } from '@claude-code-changelog-viewer/types';

interface Props {
  status: AnalysisStatus;
}

const { status } = Astro.props;

// completed は表示しない
if (status === 'completed') return null;

const styles: Record<AnalysisStatus, string> = {
  completed: '',
  inference_failed: 'bg-red-100 text-red-800 border-red-300',
  no_docs_found: 'bg-yellow-100 text-yellow-800 border-yellow-300',
  sdk_only: 'bg-gray-100 text-gray-800 border-gray-300',
  docs_pending: 'bg-blue-100 text-blue-800 border-blue-300',
  ready_for_inference: 'bg-blue-100 text-blue-800 border-blue-300',
};
---
<span class={`inline-block px-3 py-1 rounded-full text-sm border ${styles[status]}`}>
  {ANALYSIS_STATUS_LABELS[status]}
</span>
