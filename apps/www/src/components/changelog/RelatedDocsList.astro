---
import type { InferredRelatedDoc } from '@claude-code-changelog-viewer/types';
import { getOfficialDocUrl } from '@claude-code-changelog-viewer/common';
import Icon from '../Icon.astro';
type Props = {
  docs: InferredRelatedDoc[];
};

const { docs } = Astro.props;

if (docs.length === 0) {
  return null;
}
---

<div class='mt-4'>
  <h4 class='font-semibold text-sm text-gray-600 mb-2'>関連ドキュメント</h4>
  <ul class='space-y-1.5'>
    {
      docs.map((doc) => {
        const url = getOfficialDocUrl(doc.file);
        const enIndex = doc.file.indexOf('en/');
        const fileName = (
          enIndex !== -1 ? doc.file.slice(enIndex + 3) : doc.file
        ).replace(/\.md$/, '');
        return (
          <li>
            <a
              href={url}
              target='_blank'
              rel='noopener noreferrer'
              class='text-sm text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline inline-flex items-center gap-1.5 transition-colors group'
            >
              {fileName}
              <Icon
                name='external-link'
                class='w-3.5 h-3.5 opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all'
                aria-hidden='true'
              />
            </a>
          </li>
        );
      })
    }
  </ul>
</div>
