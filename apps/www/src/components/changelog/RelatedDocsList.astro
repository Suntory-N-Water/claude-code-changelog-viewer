---
import type { InferredRelatedDoc } from '@claude-code-changelog-viewer/types';
import { getOfficialDocUrl } from '@claude-code-changelog-viewer/common';
import Icon from '../Icon.astro';
type Props = {
  docs: InferredRelatedDoc[];
};

const { docs } = Astro.props;

if (docs.length === 0) {
  return null;
}
---

<div class='mt-4 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 text-sm'>
  <p class='py-1 font-semibold text-muted whitespace-nowrap'>関連ドキュメント</p>
  <ul class='flex flex-wrap gap-x-4'>
    {docs.map((doc) => {
      const url = getOfficialDocUrl(doc.file);
      const enIndex = doc.file.indexOf('en/');
      const fileName = (enIndex !== -1 ? doc.file.slice(enIndex + 3) : doc.file).replace(
        /\.md$/,
        '',
      );
      return (
        <li>
          <a
            href={url}
            target='_blank'
            rel='noopener noreferrer'
            class='inline-flex items-center gap-1 py-1 font-mono text-accent-text underline-offset-4 hover:underline'
          >
            {fileName}
            <Icon name='external-link' class='w-3.5 h-3.5 opacity-70' />
          </a>
        </li>
      );
    })}
  </ul>
</div>
