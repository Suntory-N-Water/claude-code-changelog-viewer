---
import type { InferredChangelogItem } from '@claude-code-changelog-viewer/types';

type PrefixGroup = {
  prefix: string;
  label: string;
  items: InferredChangelogItem[];
};

type Props = {
  groups: PrefixGroup[];
};

const { groups } = Astro.props;

const shouldShow = groups.length >= 2;
---

{shouldShow && (
  <nav aria-labelledby='prefix-toc-title'>
    <h2 id='prefix-toc-title' class='font-sans text-sm font-semibold text-ink mb-2'>
      カテゴリ
    </h2>
    <ul class='border-t border-rule'>
      {groups.map((group) => (
        <li class='border-b border-rule'>
          <a
            href={`#prefix-${group.prefix.toLowerCase()}`}
            class='flex items-baseline justify-between gap-3 min-h-11 py-2.5 text-[15px] text-ink-2 hover:text-ink transition-colors'
          >
            {group.label}
            <span class='text-sm tabular-nums text-muted'>{group.items.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
