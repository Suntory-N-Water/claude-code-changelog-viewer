---
import CardLink from '../ui/CardLink.astro';

type Props = {
  slug: string;
  label: string;
  itemCount: number;
  versionCount: number;
};

const { slug, label, itemCount, versionCount } = Astro.props;
---

<CardLink href={`/features/${slug}`} class='version-card'>
  <h2
    class='text-2xl font-bold text-balance text-[hsl(var(--cc-main-orange))] mb-1 group-hover:text-[hsl(var(--cc-orange-hover))] transition-[color]'
  >
    {label}
  </h2>
  <p class='text-sm text-muted-foreground tabular-nums'>
    {itemCount}件の変更 / {versionCount}バージョン
  </p>
</CardLink>
