---
import ImportanceBadge from './ImportanceBadge.astro';
import AnalysisStatusBadge from './AnalysisStatusBadge.astro';
import InferenceDetail from './InferenceDetail.astro';
import RelatedDocsList from './RelatedDocsList.astro';
import type { ChangelogItem } from '@claude-code-changelog-viewer/types';

interface Props {
  item: ChangelogItem;
}

const { item } = Astro.props;
const hasInference = item.analysis_status === 'completed' && item.inference;
---
<article class="border border-[hsl(var(--cc-gray))] rounded-lg p-4 bg-white shadow-sm hover:shadow-md transition-shadow">
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1">
      <p class="text-base text-pretty mb-3">{item.content}</p>
    </div>
    <div class="flex flex-col gap-2 items-end">
      <ImportanceBadge score={item.importance_score} />
      <AnalysisStatusBadge status={item.analysis_status} />
    </div>
  </div>

  {hasInference && <InferenceDetail inference={item.inference!} />}

  <RelatedDocsList docs={item.related_docs} />
</article>
