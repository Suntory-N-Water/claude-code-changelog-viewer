---
import type { ChangelogItem } from '@claude-code-changelog-viewer/types';
import { formatChangelogContent } from '../../lib/changelog';
import {
  PREFIX_DEFAULT_STYLE,
  PREFIX_ICONS,
  PREFIX_STYLES,
} from '../../lib/prefix';
import InferenceDetail from './InferenceDetail.astro';
import RelatedDocsList from './RelatedDocsList.astro';

type Props = {
  item: ChangelogItem;
  anchorId?: string;
};

const { item, anchorId } = Astro.props;
const formattedContent = formatChangelogContent(item.content);
const hasJaTranslation = !!item.content_ja;
const formattedContentJa = item.content_ja
  ? formatChangelogContent(item.content_ja)
  : '';

const prefixStyle = PREFIX_STYLES[item.prefix] || PREFIX_DEFAULT_STYLE;
const prefixIcon = PREFIX_ICONS[item.prefix];
---

<article
  id={anchorId}
  class='changelog-card border border-[hsl(var(--cc-gray))] rounded-lg p-5 bg-white shadow-sm hover:shadow-md transition-all duration-200 hover:border-[hsl(var(--cc-main-orange))]'
  data-pagefind-filter={`prefix:${item.prefix}`}
>
  {
    (item.feature_areas ?? []).map((area) => (
      <span class='hidden' data-pagefind-filter={`feature_area:${area}`} />
    ))
  }
  <div class='flex-1 min-w-0'>
    <!-- プレフィックスバッジ -->
    {
      item.prefix && (
        <div class='mb-3'>
          <span
            class={`inline-flex items-center gap-1 pl-2.5 pr-3.5 py-1.5 rounded-full text-sm font-bold uppercase ${prefixStyle}`}
          >
            {prefixIcon && (
              <svg
                class='w-3.5 h-3.5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2.5'
                aria-hidden='true'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d={prefixIcon}
                />
              </svg>
            )}
            {item.prefix}
          </span>
        </div>
      )
    }

    <!-- 日本語訳がある場合 -->
    {
      hasJaTranslation ? (
        <>
          <div class='mb-4 p-4 bg-[hsl(var(--cc-main-orange)/0.05)] border-l-4 border-[hsl(var(--cc-main-orange))] rounded-r'>
            <div
              class='text-base leading-relaxed text-[hsl(var(--cc-main-black))] font-medium'
              set:html={formattedContentJa}
            />
          </div>
          <details class='mb-2 [&_summary]:text-base [&_summary::marker]:text-lg'>
            <summary class='text-gray-600 hover:text-[hsl(var(--cc-main-orange))] cursor-pointer transition-colors mb-2 select-none'>
              英語原文を表示
            </summary>
            <div
              class='text-base leading-relaxed text-gray-700 pl-3 border-l-4 border-gray-300'
              set:html={formattedContent}
            />
          </details>
        </>
      ) : (
        <div
          class='text-lg leading-relaxed text-[hsl(var(--cc-main-black))]'
          set:html={formattedContent}
        />
      )
    }
  </div>

  {item.inference && <InferenceDetail inference={item.inference} />}

  <RelatedDocsList docs={item.related_docs} />
</article>
