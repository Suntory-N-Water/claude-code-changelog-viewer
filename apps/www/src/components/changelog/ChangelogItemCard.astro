---
import type { InferredChangelogItem } from '@claude-code-changelog-viewer/types';
import { formatChangelogContent } from '../../lib/format-changelog-content';
import InferenceDetail from './InferenceDetail.astro';
import RelatedDocsList from './RelatedDocsList.astro';

type Props = {
  item: InferredChangelogItem;
  anchorId?: string;
};

const { item, anchorId } = Astro.props;
const formattedContent = formatChangelogContent(item.content);
const formattedContentJa = item.content_ja ? formatChangelogContent(item.content_ja) : '';
---

<article
  id={anchorId}
  class='changelog-item py-7 border-b border-rule last:border-b-0 scroll-mt-[calc(var(--nav-height)+4rem)]'
  data-pagefind-filter={`prefix:${item.prefix}`}
>
  {formattedContentJa ? (
    <>
      <div
        class='text-[17px] leading-[1.85] text-ink wrap-break-word'
        set:html={formattedContentJa}
      />
      <details class='group mt-3'>
        <summary class='inline-flex items-center gap-1 min-h-9 cursor-pointer list-none select-none text-sm text-muted hover:text-ink transition-colors [&::-webkit-details-marker]:hidden'>
          <span class='group-open:hidden'>英語原文を表示</span>
          <span class='hidden group-open:inline'>英語原文を閉じる</span>
        </summary>
        <div
          class='mt-2 rounded-lg bg-paper-2 px-4 py-3 text-[15px] leading-relaxed text-ink-2 wrap-break-word'
          lang='en'
          set:html={formattedContent}
        />
      </details>
    </>
  ) : (
    <div class='text-[17px] leading-[1.85] text-ink wrap-break-word' set:html={formattedContent} />
  )}

  {item.benefit && <InferenceDetail benefit={item.benefit} />}

  <RelatedDocsList docs={item.related_docs} />
</article>
