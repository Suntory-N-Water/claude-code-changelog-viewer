---
import type { Prefix } from '@claude-code-changelog-viewer/common';
import type { InferredChangelogItem } from '@claude-code-changelog-viewer/types';
import { getFeatureAreaLabel, toFeatureAreaSlug } from '../../lib/feature-area';
import { formatChangelogContent } from '../../lib/format-changelog-content';
import {
  PREFIX_DEFAULT_STYLE,
  PREFIX_ICONS,
  PREFIX_STYLES,
} from '../../lib/prefix';
import InferenceDetail from './InferenceDetail.astro';
import RelatedDocsList from './RelatedDocsList.astro';
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';

type Props = {
  item: InferredChangelogItem;
  anchorId?: string;
  /** ページが存在する feature_area の Set(未指定時はリンクを生成しない) */
  linkedAreas?: Set<string>;
};

const { item, anchorId, linkedAreas } = Astro.props;
const formattedContent = formatChangelogContent(item.content);
const hasJaTranslation = !!item.content_ja;
const formattedContentJa = item.content_ja
  ? formatChangelogContent(item.content_ja)
  : '';

const prefixStyle =
  PREFIX_STYLES[item.prefix as Prefix] || PREFIX_DEFAULT_STYLE;
const prefixIcon = PREFIX_ICONS[item.prefix as Prefix];
---

<Card
  as='article'
  id={anchorId}
  padding='none'
  radius='lg'
  class='changelog-card p-5 bg-white shadow-sm hover:shadow-md transition-[box-shadow,border-color] duration-200 hover:border-[hsl(var(--cc-main-orange))]'
  data-pagefind-filter={`prefix:${item.prefix}`}
>
  <div class='flex-1 min-w-0'>
    {
      item.prefix && (
        <div class='mb-3'>
          <Badge
            variant='prefix'
            class={`gap-1 pl-2.5 pr-3.5 py-1.5 text-sm ${prefixStyle}`}
          >
            {prefixIcon && (
              <svg
                class='w-3.5 h-3.5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2.5'
                aria-hidden='true'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d={prefixIcon}
                />
              </svg>
            )}
            {item.prefix}
          </Badge>
        </div>
      )
    }

    {
      item.feature_areas && item.feature_areas.length > 0 && (
        <div class='flex flex-wrap gap-1.5 mb-3'>
          {item.feature_areas.map((area) =>
            linkedAreas?.has(area) ? (
              <Badge
                href={`/features/${toFeatureAreaSlug(area)}`}
                class='gap-1 text-[hsl(var(--cc-main-black)/0.6)] hover:bg-[hsl(var(--cc-main-orange)/0.1)] hover:text-[hsl(var(--cc-main-orange))] transition-[background-color,color]'
                data-pagefind-filter={`feature_area:${area}`}
              >
                {getFeatureAreaLabel(area)}
              </Badge>
            ) : (
              <Badge
                class='gap-1 text-[hsl(var(--cc-main-black)/0.6)]'
                data-pagefind-filter={`feature_area:${area}`}
              >
                {getFeatureAreaLabel(area)}
              </Badge>
            ),
          )}
        </div>
      )
    }

    {
      hasJaTranslation ? (
        <>
          <div class='mb-4 p-4 bg-[hsl(var(--cc-main-orange)/0.05)] border-l-4 border-[hsl(var(--cc-main-orange))] rounded-r'>
            <div
              class='text-base leading-relaxed text-[hsl(var(--cc-main-black))] font-medium wrap-break-word'
              set:html={formattedContentJa}
            />
          </div>
          <details class='mb-2 [&_summary]:text-base [&_summary::marker]:text-lg'>
            <summary class='text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] cursor-pointer transition-colors mb-2 select-none'>
              英語原文を表示
            </summary>
            <div
              class='text-base leading-relaxed text-[hsl(var(--cc-main-black))] pl-3 border-l-4 border-gray-300 wrap-break-word'
              set:html={formattedContent}
            />
          </details>
        </>
      ) : (
        <div
          class='text-lg leading-relaxed text-[hsl(var(--cc-main-black))] wrap-break-word'
          set:html={formattedContent}
        />
      )
    }
  </div>

  {item.inference && <InferenceDetail inference={item.inference} />}

  <RelatedDocsList docs={item.related_docs} />
</Card>
