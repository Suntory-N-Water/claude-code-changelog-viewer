---
import Icon from './Icon.astro';
import Button from './ui/Button.astro';
---

<Button
  id='scroll-to-top'
  size='icon'
  shape='pill'
  variant='outline'
  class='fixed bottom-6 right-6 sm:bottom-8 sm:right-8 w-12 h-12 bg-paper shadow-md transition-[opacity,background-color,border-color] duration-(--dur-short) z-50 opacity-0 pointer-events-none'
  aria-label='ページトップへ戻る'
  type='button'
>
  <Icon name='arrow-up' class='w-5 h-5' stroke-width='2.25' />
</Button>

<script>
  let controller: AbortController | null = null;

  function initScrollToTop() {
    // 前回のリスナーをクリーンアップ
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const button = document.getElementById('scroll-to-top');
    if (!button) {
      return;
    }

    const toggleVisibility = () => {
      if (window.scrollY > 300) {
        button.classList.remove('opacity-0', 'pointer-events-none');
        button.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        button.classList.remove('opacity-100', 'pointer-events-auto');
        button.classList.add('opacity-0', 'pointer-events-none');
      }
    };

    const scrollToTop = () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    window.addEventListener('scroll', toggleVisibility, { signal });
    button.addEventListener('click', scrollToTop, { signal });

    // 初期状態をチェック
    toggleVisibility();
  }

  initScrollToTop();
</script>
