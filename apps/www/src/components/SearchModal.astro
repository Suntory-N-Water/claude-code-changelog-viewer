---
import '@pagefind/default-ui/css/ui.css';
import Icon from './Icon.astro';
import Button from './ui/Button.astro';
---

<Button
  id='search-trigger'
  type='button'
  variant='outline'
  size='sm'
  class='min-h-10 w-10 lg:w-auto px-0! lg:px-3! lg:min-w-60 rounded-full bg-paper-2 border-transparent text-muted font-normal hover:border-rule-2'
  aria-label='検索を開く (⌘K / Ctrl+K)'
>
  <Icon name='search' class='w-4 h-4 shrink-0' />
  <span class='hidden lg:inline text-sm flex-1 text-left'>変更内容を検索…</span>
  <kbd
    id='search-kbd-mac'
    class='hidden lg:inline-flex items-center gap-0.5 rounded-sm bg-paper px-1.5 py-0.5 font-sans text-xs text-muted'
  >
    <span>⌘</span>K
  </kbd>
  <kbd
    id='search-kbd-win'
    class='hidden rounded-sm bg-paper px-1.5 py-0.5 font-sans text-xs text-muted'
  >
    Ctrl+K
  </kbd>
</Button>

<template id='search-modal-template'>
  <div id='search-modal-overlay' class='search-modal-overlay'>
    <div class='search-modal-positioner'>
      <div id='search-modal-content' class='search-modal-content'>
        <div class='search-modal-header'>
          <span class='text-sm font-semibold text-ink'>検索</span>
          <Button
            id='search-modal-close'
            type='button'
            variant='ghost'
            size='xs'
            class='min-h-9 text-muted'
            aria-label='検索を閉じる'
          >
            <kbd class='rounded-sm bg-paper-2 px-1.5 py-0.5 font-sans text-xs'>Esc</kbd>
          </Button>
        </div>

        <div id='search-modal-body' class='search-modal-body'>
          <p id='search-modal-status' class='px-1 py-4 text-sm text-muted' role='status'>
            検索を準備しています…
          </p>
          <div id='search' class='pagefind-ui'></div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
  let currentKeydownHandler: ((e: KeyboardEvent) => void) | null = null;

  // Pagefind UI は全ページのバンドルに載せず、モーダルを初めて開いた時だけ読み込む
  let pagefindUiPromise: Promise<void> | null = null;

  function loadPagefindUi() {
    if (!pagefindUiPromise) {
      pagefindUiPromise = import('@pagefind/default-ui')
        .then(({ PagefindUI }) => {
          new PagefindUI({
            element: '#search',
            bundlePath: '/pagefind/',
            showImages: false,
            resetStyles: true,
            highlightParam: 'highlight',
            ranking: {
              termSimilarity: 1.5,
              pageLength: 0.3,
              termFrequency: 0.8,
            },
          });
        })
        .catch((error) => {
          // 次に開いた時に再試行できるようにする
          pagefindUiPromise = null;
          throw error;
        });
    }
    return pagefindUiPromise;
  }

  // Mac 以外では Ctrl+K の kbd を表示
  const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
  const kbdMac = document.getElementById('search-kbd-mac');
  const kbdWin = document.getElementById('search-kbd-win');
  if (kbdMac) {
    kbdMac.classList.toggle('lg:inline-flex', isMac);
  }
  if (kbdWin) {
    kbdWin.classList.toggle('lg:inline-flex', !isMac);
  }

  function initSearchModal() {
    const trigger = document.getElementById('search-trigger');
    if (!trigger) {
      return;
    }

    let overlay = document.getElementById('search-modal-overlay');
    if (!overlay) {
      const template = document.getElementById(
        'search-modal-template',
      ) as HTMLTemplateElement | null;
      if (!template) {
        return;
      }
      const clone = template.content.cloneNode(true);
      document.body.appendChild(clone);
      overlay = document.getElementById('search-modal-overlay');
    }
    if (!overlay) {
      return;
    }

    const content = document.getElementById('search-modal-content');
    const closeBtn = document.getElementById('search-modal-close');
    if (!content || !closeBtn) {
      return;
    }

    const overlayEl = overlay;

    const status = document.getElementById('search-modal-status');

    function openModal() {
      overlayEl.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      loadPagefindUi()
        .then(() => {
          status?.remove();
          if (!overlayEl.classList.contains('is-open')) {
            return;
          }
          overlayEl.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.focus();
        })
        .catch(() => {
          if (status) {
            status.textContent = '検索を読み込めませんでした';
          }
        });
      window.gtag?.('event', 'search_opened', {
        event_category: 'engagement',
        page_path: window.location.pathname,
      });
    }

    function closeModal() {
      overlayEl.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    trigger.addEventListener('click', openModal);
    overlayEl.addEventListener('click', closeModal);
    content.addEventListener('click', (e) => e.stopPropagation());
    closeBtn.addEventListener('click', closeModal);

    // 前回のリスナーを除去してから登録
    if (currentKeydownHandler) {
      document.removeEventListener('keydown', currentKeydownHandler);
    }
    currentKeydownHandler = (e: KeyboardEvent) => {
      if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        if (overlayEl.classList.contains('is-open')) {
          closeModal();
        } else {
          openModal();
        }
      }
      if (e.key === 'Escape' && overlayEl.classList.contains('is-open')) {
        e.preventDefault();
        closeModal();
      }
    };
    document.addEventListener('keydown', currentKeydownHandler);

    // 検索結果のリンクをクリック時にモーダルを閉じる
    const modalBody = document.getElementById('search-modal-body');
    modalBody?.addEventListener('click', (e) => {
      const anchor = (e.target as HTMLElement).closest('a');
      if (anchor) {
        closeModal();
      }
    });
  }

  initSearchModal();
</script>
