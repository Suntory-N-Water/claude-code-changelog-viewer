---
import Icon from './Icon.astro';
import Button from './ui/Button.astro';

type Props = {
  isWeeklyPage: boolean;
  isDocsPage: boolean;
  isReferencePage: boolean;
};

const { isWeeklyPage, isDocsPage, isReferencePage } = Astro.props;
---

<Button
  id='mobile-menu-btn'
  type='button'
  variant='ghost'
  size='icon-sm'
  class='sm:hidden w-10 h-10 rounded-md hover:text-[hsl(var(--cc-main-black))] hover:bg-[hsl(var(--cc-gray)/0.5)]'
  aria-label='メニューを開く'
  aria-expanded='false'
  aria-controls='mobile-menu'
>
  <Icon id='icon-menu' name='menu' class='w-5 h-5' aria-hidden='true' />
  <Icon
    id='icon-close'
    name='close'
    class='w-5 h-5 hidden'
    aria-hidden='true'
  />
</Button>

<div
  id='mobile-menu'
  class='absolute top-full left-0 right-0 sm:hidden border-t border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white)/0.98)] shadow-lg shadow-[hsl(var(--cc-main-black)/0.06)]'
>
  <nav class='flex flex-col gap-1 p-3' aria-label='メインメニュー'>
    <a
      href='/posts/weekly'
      class={`group flex items-center gap-3 rounded-xl px-3 py-3 min-h-11 border transition-colors ${isWeeklyPage ? 'border-[hsl(var(--cc-main-orange)/0.5)] bg-[hsl(var(--cc-main-orange)/0.08)]' : 'border-[hsl(var(--cc-main-orange)/0.2)] bg-[hsl(var(--cc-main-orange)/0.04)] hover:border-[hsl(var(--cc-main-orange)/0.4)] hover:bg-[hsl(var(--cc-main-orange)/0.07)]'}`}
      aria-current={isWeeklyPage ? 'page' : undefined}
    >
      <span
        class='flex items-center justify-center w-9 h-9 rounded-lg bg-[hsl(var(--cc-main-orange)/0.12)] text-[hsl(var(--cc-main-orange))] shrink-0'
      >
        <Icon name='newspaper' class='w-5 h-5' aria-hidden='true' />
      </span>
      <span class='min-w-0 flex-1'>
        <span
          class='block text-sm font-semibold text-[hsl(var(--cc-main-orange))]'
        >
          週次まとめ
        </span>
        <span
          class='block text-xs text-[hsl(var(--cc-main-black)/0.55)] leading-snug'
        >
          今週の注目アップデートを解説
        </span>
      </span>
      <Icon
        name='chevron-right'
        class='w-4 h-4 shrink-0 text-[hsl(var(--cc-main-orange)/0.7)] group-hover:translate-x-0.5 transition-transform'
        aria-hidden='true'
      />
    </a>

    <div class='my-1 border-t border-[hsl(var(--cc-gray))]'></div>

    <a
      href='/docs'
      class={`flex items-center gap-3 rounded-lg px-3 py-2.5 min-h-11 text-sm transition-colors ${isDocsPage ? 'text-[hsl(var(--cc-main-orange))] font-medium bg-[hsl(var(--cc-main-orange)/0.06)]' : 'text-[hsl(var(--cc-main-black)/0.75)] hover:text-[hsl(var(--cc-main-orange))] hover:bg-[hsl(var(--cc-gray)/0.4)]'}`}
      aria-current={isDocsPage ? 'page' : undefined}
    >
      <Icon
        name='document-file'
        class='w-5 h-5 shrink-0 text-[hsl(var(--cc-main-black)/0.5)]'
        aria-hidden='true'
      />
      Docs 更新履歴
    </a>
    <a
      href='/reference/settings'
      class={`flex items-center gap-3 rounded-lg px-3 py-2.5 min-h-11 text-sm transition-colors ${isReferencePage ? 'text-[hsl(var(--cc-main-orange))] font-medium bg-[hsl(var(--cc-main-orange)/0.06)]' : 'text-[hsl(var(--cc-main-black)/0.75)] hover:text-[hsl(var(--cc-main-orange))] hover:bg-[hsl(var(--cc-gray)/0.4)]'}`}
      aria-current={isReferencePage ? 'page' : undefined}
    >
      <Icon
        name='clipboard-doc'
        class='w-5 h-5 shrink-0 text-[hsl(var(--cc-main-black)/0.5)]'
        aria-hidden='true'
      />
      設定リファレンス
    </a>

    <div class='my-1 border-t border-[hsl(var(--cc-gray))]'></div>

    <a
      href='/notify'
      class='flex items-center gap-3 rounded-lg px-3 py-2.5 min-h-11 text-sm text-[hsl(var(--cc-main-black)/0.75)] hover:text-[hsl(var(--cc-main-orange))] hover:bg-[hsl(var(--cc-gray)/0.4)] transition-colors'
    >
      <Icon
        name='bell'
        class='w-5 h-5 shrink-0 text-[hsl(var(--cc-main-black)/0.5)]'
        aria-hidden='true'
      />
      更新通知を受け取る
    </a>
  </nav>
</div>

<style>
  #mobile-menu {
    display: none;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      display 0.15s,
      opacity 0.15s ease-out,
      transform 0.15s ease-out;
    transition-behavior: allow-discrete;
  }

  #mobile-menu.is-open {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  @starting-style {
    #mobile-menu.is-open {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu {
      transition-duration: 0.01s;
    }
  }
</style>

<script>
  function initMobileMenu() {
    const button = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');

    if (!button || !menu || !iconMenu || !iconClose) {
      return;
    }

    function toggleMenu(open: boolean) {
      menu?.classList.toggle('is-open', open);
      button?.setAttribute('aria-expanded', String(open));
      button?.setAttribute(
        'aria-label',
        open ? 'メニューを閉じる' : 'メニューを開く',
      );
      iconMenu?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    }

    button.addEventListener('click', () => {
      toggleMenu(button.getAttribute('aria-expanded') !== 'true');
    });

    // ページ遷移時にメニューを閉じる
    document.addEventListener('astro:after-swap', () => toggleMenu(false));
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
