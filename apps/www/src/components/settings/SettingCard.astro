---
import Badge from '../ui/Badge.astro';
import CardLink from '../ui/CardLink.astro';
import { getSourceLabel } from '../../lib/settings-reference';

type Props = {
  slug: string;
  keyName: string;
  source: 'settings' | 'env';
  summary: string;
  childCount?: number;
};

const { slug, keyName, source, summary, childCount = 0 } = Astro.props;
const sourceLabel = getSourceLabel(source);
---

<CardLink href={`/reference/settings/${slug}`} padding='md' iconSize='sm'>
  <h2 class='mb-2 text-sm font-semibold font-mono leading-snug break-all text-accent-text group-hover:text-ink transition-colors'>
    {keyName}
  </h2>
  <div class='mb-2 flex flex-wrap items-center gap-1.5'>
    <Badge>{sourceLabel}</Badge>
    {childCount > 0 && <Badge class='tabular-nums'>{childCount}件を含む</Badge>}
  </div>
  <p class='text-sm text-ink-2 leading-relaxed line-clamp-1'>{summary}</p>
</CardLink>
