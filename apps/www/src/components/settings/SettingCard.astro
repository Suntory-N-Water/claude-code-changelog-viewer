---
import Badge from '../ui/Badge.astro';
import CardLink from '../ui/CardLink.astro';
import { getSourceLabel } from '../../lib/settings-reference';

type Props = {
  slug: string;
  keyName: string;
  source: 'settings' | 'env';
  summary: string;
};

const { slug, keyName, source, summary } = Astro.props;
const sourceLabel = getSourceLabel(source);
---

<CardLink href={`/reference/settings/${slug}`} padding='md' iconSize='sm'>
  <h2
    class='mb-2 text-sm font-bold font-mono break-all text-[hsl(var(--cc-main-orange))] group-hover:text-[hsl(var(--cc-orange-hover))] transition-[color]'
  >
    {keyName}
  </h2>
  <div class='mb-2'>
    <Badge class='font-medium'>{sourceLabel}</Badge>
  </div>
  <p class='text-sm text-gray-600 leading-relaxed line-clamp-1'>{summary}</p>
</CardLink>
