---
import Icon from '../Icon.astro';
import Pagination from '../ui/Pagination.astro';

type Article = {
  slug: string;
  title: string;
  date: string;
  formattedDate: string;
  description: string;
};

type Props = {
  heading: string;
  lead: string;
  basePath: string;
  articles: Article[];
  page: {
    currentPage: number;
    lastPage: number;
    url: { first?: string; prev?: string; next?: string };
  };
};

const { heading, lead, basePath, articles, page } = Astro.props;

const firstPageUrl = page.url.first ?? basePath;
const pageUrlBase = firstPageUrl.replace(/\/$/, '');
const paginationPages = Array.from({ length: page.lastPage }, (_, index) => {
  const pageNumber = index + 1;
  return {
    number: pageNumber,
    url: pageNumber === 1 ? firstPageUrl : `${pageUrlBase}/${pageNumber}`,
  };
});
---

<div class='min-h-dvh py-12 sm:py-16 px-4'>
  <div class='max-w-3xl mx-auto'>
    <header class='mb-12'>
      <nav aria-label='パンくずリスト' class='text-sm text-gray-400 mb-6'>
        <a
          href='/'
          class='hover:text-[hsl(var(--cc-main-orange))] transition-colors duration-150'
          >ホーム</a
        >
        <span class='mx-2 select-none'>/</span>
        <span class='text-[hsl(var(--cc-main-black)/0.7)]'>{heading}</span>
      </nav>
      <h1
        class='text-3xl sm:text-4xl font-bold tracking-tight text-balance text-[hsl(var(--cc-main-black))] mb-3'
      >
        {heading}
      </h1>
      <p class='text-sm text-[hsl(var(--cc-main-black)/0.6)] leading-relaxed'>
        {lead}
      </p>
    </header>

    {
      articles.length === 0 ? (
        <p class='py-16 text-center text-sm text-[hsl(var(--cc-main-black)/0.5)]'>
          まだ記事がありません。
        </p>
      ) : (
        <ul class='space-y-4'>
          {articles.map((article) => (
            <li>
              <a
                href={`${basePath}/${article.slug}`}
                class='group flex items-center gap-4 rounded-xl border border-[hsl(var(--cc-gray))] px-5 py-6 sm:px-6 hover:border-[hsl(var(--cc-main-orange)/0.5)] hover:bg-[hsl(var(--cc-gray)/0.15)] transition-colors'
              >
                <div class='min-w-0 flex-1'>
                  <p class='text-xs text-[hsl(var(--cc-main-black)/0.5)] tabular-nums mb-1.5'>
                    投稿日{' '}
                    <time datetime={article.date}>{article.formattedDate}</time>
                  </p>
                  <h2 class='text-xl sm:text-2xl font-bold [word-break:auto-phrase] text-[hsl(var(--cc-main-black))] group-hover:text-[hsl(var(--cc-main-orange))] transition-colors mb-2 leading-snug'>
                    {article.title}
                  </h2>
                  <p class='text-sm text-[hsl(var(--cc-main-black)/0.6)] leading-relaxed line-clamp-2'>
                    {article.description}
                  </p>
                </div>
                <Icon
                  name='chevron-right'
                  class='w-5 h-5 shrink-0 text-[hsl(var(--cc-main-black)/0.3)] group-hover:text-[hsl(var(--cc-main-orange))] group-hover:translate-x-1 transition-[color,transform]'
                  aria-hidden='true'
                />
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      page.lastPage > 1 && (
        <Pagination
          pages={paginationPages}
          currentPage={page.currentPage}
          totalPages={page.lastPage}
          previousHref={page.url.prev}
          nextHref={page.url.next}
          previousLabel='新しい記事へ'
          nextLabel='古い記事へ'
          class='mt-12'
        />
      )
    }
  </div>
</div>
