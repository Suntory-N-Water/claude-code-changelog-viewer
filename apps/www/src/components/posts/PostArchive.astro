---
import Icon from '../Icon.astro';
import Pagination from '../ui/Pagination.astro';

type Article = {
  slug: string;
  title: string;
  date: string;
  formattedDate: string;
  description: string;
};

type Props = {
  heading: string;
  basePath: string;
  articles: Article[];
  page: {
    currentPage: number;
    lastPage: number;
    url: { first?: string; prev?: string; next?: string };
  };
};

const { heading, basePath, articles, page } = Astro.props;

const firstPageUrl = page.url.first ?? basePath;
const pageUrlBase = firstPageUrl.replace(/\/$/, '');
const paginationPages = Array.from({ length: page.lastPage }, (_, index) => {
  const pageNumber = index + 1;
  return {
    number: pageNumber,
    url: pageNumber === 1 ? firstPageUrl : `${pageUrlBase}/${pageNumber}`,
  };
});
---

<div class='pt-8 sm:pt-10 pb-24'>
  <div class='max-w-6xl mx-auto px-4 sm:px-6'>
    <header class='pb-12 sm:pb-16'>
      <nav aria-label='パンくずリスト' class='flex items-center gap-2 text-sm text-muted'>
        <a
          href='/'
          class='inline-flex items-center min-h-10 underline-offset-4 hover:underline hover:text-ink'
        >
          ホーム
        </a>
        <span aria-hidden='true'>/</span>
        <span class='text-ink-2'>{heading}</span>
      </nav>
      <h1 class='mt-6 text-[clamp(2.25rem,3vw+1.25rem,3.5rem)] text-ink'>{heading}</h1>
    </header>

    {articles.length > 0 && (
      <ul class='border-t-2 border-ink'>
        {articles.map((article) => (
          <li class='border-b border-rule'>
            <a
              href={`${basePath}/${article.slug}`}
              class='group grid lg:grid-cols-12 gap-x-8 gap-y-2 py-8 sm:py-10'
            >
              <time datetime={article.date} class='lg:col-span-3 text-sm text-muted tabular-nums'>
                {article.formattedDate}
              </time>
              <div class='lg:col-span-8 min-w-0'>
                <h2 class='text-2xl sm:text-3xl leading-snug text-ink group-hover:text-accent-text transition-colors'>
                  {article.title}
                </h2>
                <p class='mt-3 max-w-[60ch] text-base text-ink-2 leading-relaxed line-clamp-2'>
                  {article.description}
                </p>
              </div>
              <Icon
                name='chevron-right'
                class='hidden lg:block lg:col-span-1 justify-self-end self-center w-5 h-5 text-muted group-hover:text-ink transition-colors'
              />
            </a>
          </li>
        ))}
      </ul>
    )}

    {page.lastPage > 1 && (
      <Pagination
        pages={paginationPages}
        currentPage={page.currentPage}
        totalPages={page.lastPage}
        previousHref={page.url.prev}
        nextHref={page.url.next}
        previousLabel='新しい記事へ'
        nextLabel='古い記事へ'
        class='mt-12'
      />
    )}
  </div>
</div>
