---
import type { MarkdownHeading } from 'astro';

type Props = {
  headings: MarkdownHeading[];
  class?: string;
};

const { headings, class: className } = Astro.props;
---

<aside class:list={['hidden lg:block', className]}>
  <nav
    aria-label='目次'
    class='sticky top-[calc(var(--nav-height)+var(--space-lg))] max-h-[calc(100dvh-var(--nav-height)-3rem)] overflow-y-auto'
  >
    <p class='text-sm font-semibold text-ink mb-3'>目次</p>
    <ul class='space-y-1.5 border-l border-rule'>
      {headings.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            class={`block border-l-2 border-transparent -ml-px py-0.5 pr-2 text-sm [word-break:auto-phrase] text-ink-2 hover:border-accent hover:text-ink transition-colors ${h.depth === 3 ? 'pl-6' : 'pl-3 font-medium'}`}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
