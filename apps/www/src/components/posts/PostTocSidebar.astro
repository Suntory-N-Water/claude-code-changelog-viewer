---
import type { MarkdownHeading } from 'astro';

type Props = {
  headings: MarkdownHeading[];
  class?: string;
};

const { headings, class: className } = Astro.props;
---

<aside class:list={['hidden lg:block', className]}>
  <nav
    aria-label='目次'
    class='sticky top-16 max-h-[calc(100dvh-5rem)] overflow-y-auto'
  >
    <p
      class='text-xs font-semibold text-[hsl(var(--cc-main-black)/0.5)] uppercase tracking-wide mb-3'
    >
      目次
    </p>
    <ul class='space-y-1.5 border-l border-[hsl(var(--cc-gray))]'>
      {
        headings.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class={`block border-l-2 border-transparent -ml-px pr-2 text-sm [word-break:auto-phrase] text-[hsl(var(--cc-main-black)/0.6)] hover:border-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-main-orange))] transition-colors ${h.depth === 3 ? 'pl-6' : 'pl-3 font-medium'}`}
            >
              {h.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
