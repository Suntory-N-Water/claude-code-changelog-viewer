---
import type { MarkdownHeading } from 'astro';
import Icon from '../Icon.astro';
import Accordion from '../ui/Accordion.astro';

type Props = {
  headings: MarkdownHeading[];
  class?: string;
};

const { headings, class: className } = Astro.props;
---

<Accordion variant='muted' class:list={[className]}>
  <summary
    class='cursor-pointer select-none px-4 py-3 text-sm font-semibold text-[hsl(var(--cc-main-black)/0.7)] flex items-center gap-2'
  >
    <Icon
      name='chevron-down'
      class='w-4 h-4 transition-transform'
      aria-hidden='true'
    />
    目次
  </summary>
  <ul class='pb-4 pl-8 pr-4 space-y-1.5'>
    {
      headings.map((h) => (
        <li
          class={
            h.depth === 3
              ? 'ml-4 list-[circle] marker:text-[hsl(var(--cc-main-black)/0.35)]'
              : 'list-disc marker:text-[hsl(var(--cc-main-orange))]'
          }
        >
          <a
            href={`#${h.slug}`}
            class={`block text-sm [word-break:auto-phrase] hover:text-[hsl(var(--cc-main-orange))] transition-colors ${h.depth === 3 ? 'text-[hsl(var(--cc-main-black)/0.6)]' : 'font-semibold text-[hsl(var(--cc-main-black)/0.8)]'}`}
          >
            {h.text}
          </a>
        </li>
      ))
    }
  </ul>
</Accordion>
