---
import type { WeeklyAdminWeek } from '../../lib/weekly-admin';
import ChangelogItemCard from '../changelog/ChangelogItemCard.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Layout from '../../layouts/Layout.astro';

type Props = {
  /** 表示中の週 */
  current: WeeklyAdminWeek;
  /** ページを生成した全週(新しい順)。週切り替えリンクの生成に使う */
  weeks: WeeklyAdminWeek[];
};

const { current, weeks } = Astro.props;
---

<Layout
  title={`週次アップデート記事の選定 (${current.week})`}
  description='週次アップデート記事に掲載する Claude Code の変更を選定します。'
  noindex
>
  <div class='min-h-dvh py-10 sm:py-14 px-4'>
    <div
      id='weekly-selection'
      class='max-w-4xl mx-auto'
      data-week={current.week}
      data-period-start={current.periodStart}
      data-period-end={current.periodEnd}
      data-total-items={current.items.length}
    >
      <header class='mb-8'>
        <h1
          class='text-3xl font-bold tracking-tight text-[hsl(var(--cc-main-black))]'
        >
          週次アップデート記事の選定
        </h1>
        <p class='mt-2 text-sm text-[hsl(var(--cc-main-black)/0.65)]'>
          掲載する変更を選び、体験や補足をコメントしてください。
        </p>
      </header>

      <Card
        as='section'
        padding='sm'
        radius='lg'
        class='mb-8 bg-[hsl(var(--cc-main-white)/0.95)] shadow-sm'
      >
        <div
          class='flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'
        >
          <div>
            <span
              class='block text-sm font-medium text-[hsl(var(--cc-main-black))]'
              >対象週</span
            >
            <div class='mt-1.5 flex flex-wrap gap-2'>
              {
                weeks.map(({ week }, index) => (
                  <Button
                    href={
                      index === 0 ? '/admin/weekly' : `/admin/weekly/${week}`
                    }
                    variant={week === current.week ? 'primary' : 'outline'}
                    size='sm'
                    class='rounded-md font-semibold'
                    aria-current={week === current.week ? 'page' : undefined}
                  >
                    {week}
                  </Button>
                ))
              }
            </div>
            <p class='mt-1.5 text-xs text-[hsl(var(--cc-main-black)/0.55)]'>
              {current.periodStart} – {current.periodEnd}({
                current.items.length
              }件)
            </p>
          </div>
          <div class='flex gap-2'>
            <Button
              id='clear-button'
              type='button'
              variant='outline'
              size='sm'
              class='rounded-md bg-white font-semibold text-[hsl(var(--cc-main-black))] hover:bg-[hsl(var(--cc-gray)/0.15)]'
            >
              一括削除
            </Button>
            <Button
              id='copy-button'
              type='button'
              size='sm'
              class='rounded-md font-semibold disabled:cursor-not-allowed'
            >
              選定内容をコピー
            </Button>
          </div>
        </div>
      </Card>

      {
        current.items.length === 0 && (
          <p class='py-12 text-center text-sm text-[hsl(var(--cc-main-black)/0.6)]'>
            この週に公開された変更はありません。
          </p>
        )
      }

      <div class='space-y-5'>
        {
          current.items.map(({ item, version }) => (
            <section class='weekly-item'>
              <div class='mb-2 flex items-center gap-3'>
                <label class='inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-[hsl(var(--cc-main-black))]'>
                  <input
                    type='checkbox'
                    data-item-id={item.id}
                    data-version={version}
                    class='size-4 accent-[hsl(var(--cc-main-orange))]'
                  />
                  記事に掲載する
                </label>
                <span class='font-mono text-xs text-[hsl(var(--cc-main-black)/0.5)]'>
                  v{version}
                </span>
              </div>
              <ChangelogItemCard item={item} />
              <label data-comment hidden class='mt-3'>
                <span class='text-sm font-medium text-[hsl(var(--cc-main-black))]'>
                  コメント
                </span>
                <textarea
                  rows='3'
                  disabled
                  class='mt-1.5 block w-full rounded-md border border-[hsl(var(--cc-gray))] bg-white px-3 py-2 text-sm leading-relaxed focus:border-[hsl(var(--cc-main-orange))] focus:outline-none focus:ring-2 focus:ring-[hsl(var(--cc-main-orange)/0.2)]'
                  placeholder='この変更を使った体験や、読者に伝えたいこと'
                />
              </label>
              <fieldset data-links hidden class='mt-3'>
                <legend class='text-sm font-medium text-[hsl(var(--cc-main-black))]'>
                  関連リンク
                </legend>
                <p class='mt-0.5 text-xs text-[hsl(var(--cc-main-black)/0.55)]'>
                  記事では本文の直後にリンクカードとして表示されます
                </p>
                <div data-link-rows class='mt-1.5 space-y-2' />
                <button
                  data-link-add
                  type='button'
                  class='mt-2 inline-flex min-h-11 cursor-pointer items-center justify-center rounded-md border border-[hsl(var(--cc-gray))] bg-white px-4 py-2 text-sm font-semibold text-[hsl(var(--cc-main-black))] transition-colors hover:bg-[hsl(var(--cc-gray)/0.15)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--cc-main-orange))]'
                >
                  リンクを追加
                </button>
              </fieldset>
            </section>
          ))
        }
      </div>
    </div>
  </div>

  <!-- 行数が可変のため、1行ぶんを複製元として持つ -->
  <template id='weekly-link-row-template'>
    <div class='flex items-start gap-2'>
      <div class='min-w-0 flex-1'>
        <input
          data-link
          type='url'
          inputmode='url'
          aria-label='関連リンクの URL'
          placeholder='https://example.com/article'
          class='block w-full rounded-md border border-[hsl(var(--cc-gray))] bg-white px-3 py-2 text-sm focus:border-[hsl(var(--cc-main-orange))] focus:outline-none focus:ring-2 focus:ring-[hsl(var(--cc-main-orange)/0.2)]'
        />
        <p
          data-link-error
          hidden
          role='alert'
          class='mt-1 text-sm text-red-700'
        >
        </p>
      </div>
      <button
        data-link-remove
        type='button'
        aria-label='このリンクを削除'
        class='inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-md border border-[hsl(var(--cc-gray))] bg-white text-base font-semibold text-[hsl(var(--cc-main-black))] transition-colors hover:bg-[hsl(var(--cc-gray)/0.15)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--cc-main-orange))]'
      >
        ×
      </button>
    </div>
  </template>

  <!-- 掲載する item だけが使う UI のため、静的出力せずチェック時に複製する -->
  <template id='weekly-image-template'>
    <div
      class='mt-3 rounded-md border border-dashed border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white)/0.75)] p-4 transition-colors'
    >
      <button
        data-dropzone
        type='button'
        class='block w-full cursor-pointer text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--cc-main-orange))] disabled:cursor-not-allowed disabled:opacity-50'
      >
        <span class='block text-sm text-[hsl(var(--cc-main-black)/0.65)]'>
          画像をドロップ、クリックしてファイルを選択、またはフォーカス中に貼り付け(⌘V
          / Ctrl+V)
        </span>
        <span class='mt-2 block text-xs text-[hsl(var(--cc-main-black)/0.5)]'>
          PNG・JPEG・WebP / 5MB まで
        </span>
      </button>
      <input
        data-file
        type='file'
        accept='image/png,image/jpeg,image/webp'
        class='sr-only'
      />
      <div data-preview hidden>
        <div class='flex items-center gap-4'>
          <img
            data-thumbnail
            alt='添付した画像のプレビュー'
            width='96'
            height='96'
            loading='lazy'
            decoding='async'
            class='size-24 shrink-0 rounded-md border border-[hsl(var(--cc-gray))] bg-white object-contain'
          />
          <div class='flex min-w-0 flex-col gap-2.5'>
            <p class='text-xs text-[hsl(var(--cc-main-black)/0.6)]'>
              アップロード済み
            </p>
            <div class='flex flex-wrap gap-2'>
              <button
                data-replace
                type='button'
                class='inline-flex cursor-pointer items-center justify-center rounded-md border border-[hsl(var(--cc-gray))] bg-white px-4 py-2 text-sm font-semibold text-[hsl(var(--cc-main-black))] transition-colors hover:bg-[hsl(var(--cc-gray)/0.15)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--cc-main-orange))] disabled:cursor-not-allowed disabled:opacity-50'
              >
                差し替え
              </button>
              <button
                data-delete
                type='button'
                class='inline-flex cursor-pointer items-center justify-center rounded-md border border-[hsl(var(--cc-gray))] bg-white px-4 py-2 text-sm font-semibold text-[hsl(var(--cc-main-black))] transition-colors hover:bg-[hsl(var(--cc-gray)/0.15)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--cc-main-orange))] disabled:cursor-not-allowed disabled:opacity-50'
              >
                削除
              </button>
            </div>
          </div>
        </div>
      </div>
      <p
        data-status
        hidden
        role='status'
        class='mt-2 text-sm text-[hsl(var(--cc-main-black)/0.65)]'
      >
        アップロード中…
      </p>
      <p data-error hidden role='alert' class='mt-2 text-sm text-red-700'></p>
    </div>
  </template>
</Layout>

<script>
  import { setupWeeklySelection } from '../../lib/weekly-selection/setup';

  setupWeeklySelection();
</script>
