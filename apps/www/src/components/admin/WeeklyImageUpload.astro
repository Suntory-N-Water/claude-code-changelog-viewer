---
type Props = {
  week: string;
  itemId: string;
  uploadUrl?: string;
};

const {
  week,
  itemId,
  uploadUrl = 'https://api.claude-code-log.com/api/uploads',
} = Astro.props;
---

<weekly-image-upload
  data-week={week}
  data-item-id={itemId}
  data-upload-url={uploadUrl}
  hidden
  class='mt-3 rounded-md border border-dashed border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white)/0.75)] p-4'
>
  <div data-image-prompt class='text-center'>
    <p class='text-sm text-[hsl(var(--cc-main-black)/0.65)]'>
      ここに画像をペースト、ドロップ、またはファイルを選択
    </p>
    <label
      class='mt-2 inline-flex cursor-pointer rounded-md border border-[hsl(var(--cc-gray))] bg-white px-3 py-1.5 text-sm font-semibold hover:bg-[hsl(var(--cc-gray)/0.15)]'
    >
      ファイルを選択
      <input
        data-image-input
        type='file'
        accept='image/png,image/jpeg,image/webp'
        class='sr-only'
      />
    </label>
  </div>
  <div data-image-preview hidden class='flex items-center gap-3'>
    <img
      data-image-thumbnail
      alt='添付画像のプレビュー'
      class='size-24 rounded-md border border-[hsl(var(--cc-gray))] bg-white object-contain'
    />
    <div class='min-w-0 flex-1'>
      <p data-image-size class='text-xs text-[hsl(var(--cc-main-black)/0.6)]'>
        アップロード済み
      </p>
      <div class='mt-2 flex gap-2'>
        <label
          class='cursor-pointer rounded-md border border-[hsl(var(--cc-gray))] bg-white px-3 py-1.5 text-sm font-semibold hover:bg-[hsl(var(--cc-gray)/0.15)]'
        >
          差し替え
          <input
            data-image-replace-input
            type='file'
            accept='image/png,image/jpeg,image/webp'
            class='sr-only'
          />
        </label>
        <button
          data-image-delete
          type='button'
          class='rounded-md border border-[hsl(var(--cc-gray))] bg-white px-3 py-1.5 text-sm font-semibold hover:bg-[hsl(var(--cc-gray)/0.15)]'
        >
          削除
        </button>
      </div>
    </div>
  </div>
  <p data-image-error hidden class='mt-2 text-sm text-red-700' role='alert'></p>
</weekly-image-upload>

<script>
  const MAX_IMAGE_SIZE = 5 * 1024 * 1024;
  const ALLOWED_IMAGE_TYPES = ['image/png', 'image/jpeg', 'image/webp'];

  class WeeklyImageUpload extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) {
        return;
      }
      this.dataset.initialized = 'true';

      for (const input of this.querySelectorAll<HTMLInputElement>(
        '[data-image-input], [data-image-replace-input]',
      )) {
        input.addEventListener('change', () => {
          const file = input.files?.[0];
          if (file) {
            void this.upload(file);
          }
          input.value = '';
        });
      }
      this.addEventListener('dragover', (event) => event.preventDefault());
      this.addEventListener('drop', (event) => {
        event.preventDefault();
        const file = event.dataTransfer?.files[0];
        if (file) {
          void this.upload(file);
        }
      });
      this.closest('.weekly-item')?.addEventListener('paste', (event) => {
        const clipboardEvent = event as ClipboardEvent;
        const checkbox = this.closest(
          '.weekly-item',
        )?.querySelector<HTMLInputElement>('input[type="checkbox"]');
        if (!checkbox?.checked) {
          return;
        }
        const file = [...(clipboardEvent.clipboardData?.items ?? [])]
          .find((item) => item.kind === 'file')
          ?.getAsFile();
        if (file) {
          clipboardEvent.preventDefault();
          void this.upload(file);
        }
      });
      this.querySelector('[data-image-delete]')?.addEventListener(
        'click',
        () => {
          this.clear();
          this.dispatchEvent(
            new CustomEvent('image-change', {
              detail: { imageUrl: undefined },
              bubbles: true,
            }),
          );
        },
      );
    }

    get imageUrl() {
      return this.dataset.imageUrl;
    }

    set imageUrl(value: string | undefined) {
      if (value) {
        this.dataset.imageUrl = value;
      } else {
        delete this.dataset.imageUrl;
      }
      this.render(value);
    }

    clear() {
      this.imageUrl = undefined;
      const error = this.querySelector<HTMLElement>('[data-image-error]');
      if (error) {
        error.hidden = true;
      }
    }

    private render(imageUrl?: string, imageSize?: number) {
      const prompt = this.querySelector<HTMLElement>('[data-image-prompt]');
      const preview = this.querySelector<HTMLElement>('[data-image-preview]');
      const thumbnail = this.querySelector<HTMLImageElement>(
        '[data-image-thumbnail]',
      );
      const size = this.querySelector<HTMLElement>('[data-image-size]');
      if (!prompt || !preview || !thumbnail || !size) {
        return;
      }
      prompt.hidden = Boolean(imageUrl);
      preview.hidden = !imageUrl;
      thumbnail.src = imageUrl ?? '';
      size.textContent = imageSize
        ? `${(imageSize / 1024).toFixed(1)} KB`
        : 'アップロード済み';
    }

    private async upload(file: File) {
      const error = this.querySelector<HTMLElement>('[data-image-error]');
      if (!error) {
        return;
      }
      error.hidden = true;
      if (file.size > MAX_IMAGE_SIZE) {
        error.textContent = '画像は5MB以下にしてください。';
        error.hidden = false;
        return;
      }
      if (!ALLOWED_IMAGE_TYPES.includes(file.type)) {
        error.textContent = 'PNG・JPEG・WebPのみアップロードできます。';
        error.hidden = false;
        return;
      }

      const body = new FormData();
      body.append('week', this.dataset.week ?? '');
      body.append('itemId', this.dataset.itemId ?? '');
      body.append('file', file);

      try {
        const response = await fetch(this.dataset.uploadUrl ?? '', {
          method: 'POST',
          credentials: 'include',
          body,
        });
        const result = await response.json();
        if (!response.ok || typeof result.url !== 'string') {
          throw new Error(result.error ?? 'アップロードに失敗しました。');
        }
        this.dataset.imageUrl = result.url;
        this.render(result.url, file.size);
        this.dispatchEvent(
          new CustomEvent('image-change', {
            detail: { imageUrl: result.url },
            bubbles: true,
          }),
        );
      } catch (uploadError) {
        error.textContent =
          uploadError instanceof Error
            ? uploadError.message
            : 'アップロードに失敗しました。';
        error.hidden = false;
      }
    }
  }

  if (!customElements.get('weekly-image-upload')) {
    customElements.define('weekly-image-upload', WeeklyImageUpload);
  }
</script>
