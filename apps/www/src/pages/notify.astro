---
import slackManifestContent from '../../../../config/slack-app-manifest.yaml?raw';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../lib/constants';

const url = import.meta.env.DEV
  ? 'http://localhost:8787'
  : import.meta.env.SITE;
---

<Layout
  title={`通知設定 - ${SITE_TITLE}`}
  description='Claude Codeの新バージョンがリリースされた際に、Discord・Slack・メールへ自動通知する機能の設定ページです。登録するだけで、最新のアップデート情報をリアルタイムで受け取ることができます。'
  jsonLd={{ type: 'page' }}
  breadcrumbs={[
    { name: 'トップ', url: url },
    { name: '通知設定', url: `${url}/notify` },
  ]}
>
  <div class='min-h-dvh py-12 sm:py-20 px-4'>
    <div class='max-w-xl mx-auto'>
      <!-- ナビゲーション -->
      <nav class='mb-10'>
        <a
          href='/'
          data-direction='back'
          class='text-sm text-[hsl(var(--cc-main-black)/0.5)] hover:text-[hsl(var(--cc-main-orange))] inline-flex items-center gap-1.5 transition-colors'
        >
          <svg
            class='w-4 h-4'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M15 19l-7-7 7-7'></path>
          </svg>
          トップに戻る
        </a>
      </nav>

      <!-- ヘッダー -->
      <div class='mb-8'>
        <h1
          class='text-2xl sm:text-3xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-3'
        >
          通知設定
        </h1>
        <p
          class='text-base leading-relaxed text-[hsl(var(--cc-main-black)/0.6)]'
        >
          Claude Code
          の新バージョンがリリースされた際に、Discord・Slack・メールへ自動通知します。通知はいつでも解除可能です。
        </p>
      </div>

      <!-- クエリパラメータによるタブ初期化: JS 実行前のちらつきを防ぐ -->
      <script is:inline>
        (() => {
          const tab = new URLSearchParams(location.search).get('tab');
          if (tab !== 'slack' && tab !== 'email') {
            return;
          }
          const style = document.createElement('style');
          style.id = 'tab-init-style';
          style.textContent =
            '#panel-discord{display:none!important}' +
            (tab === 'slack'
              ? '#panel-email{display:none!important}'
              : '#panel-slack{display:none!important}') +
            '#tab-discord{border-color:transparent!important;color:hsl(var(--cc-main-black)/0.5)!important}' +
            `#tab-${tab}{border-color:hsl(var(--cc-main-orange))!important;color:hsl(var(--cc-main-orange))!important}`;
          document.head.appendChild(style);
        })();
      </script>

      <!-- タブナビゲーション -->
      <div
        class='flex border-b border-[hsl(var(--cc-gray))] mb-8'
        role='tablist'
        aria-label='通知サービスの選択'
      >
        <button
          type='button'
          id='tab-discord'
          role='tab'
          aria-selected='true'
          aria-controls='panel-discord'
          class='flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 -mb-px transition-colors cursor-pointer
            border-[hsl(var(--cc-main-orange))] text-[hsl(var(--cc-main-orange))]'
        >
          <svg
            class='w-4 h-4'
            viewBox='0 0 24 24'
            fill='currentColor'
            aria-hidden='true'
          >
            <path
              d='M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.032.054A19.9 19.9 0 0 0 5.9 21.493a.077.077 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z'
            ></path>
          </svg>
          Discord
        </button>
        <button
          type='button'
          id='tab-slack'
          role='tab'
          aria-selected='false'
          aria-controls='panel-slack'
          class='flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 -mb-px transition-colors cursor-pointer
            border-transparent text-[hsl(var(--cc-main-black)/0.5)] hover:text-[hsl(var(--cc-main-black)/0.8)]'
        >
          <svg
            class='w-4 h-4'
            viewBox='0 0 24 24'
            fill='currentColor'
            aria-hidden='true'
          >
            <path
              d='M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z'
            ></path>
          </svg>
          Slack
        </button>
        <button
          type='button'
          id='tab-email'
          role='tab'
          aria-selected='false'
          aria-controls='panel-email'
          class='flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 -mb-px transition-colors cursor-pointer
            border-transparent text-[hsl(var(--cc-main-black)/0.5)] hover:text-[hsl(var(--cc-main-black)/0.8)]'
        >
          <svg
            class='w-4 h-4'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
            ></path>
          </svg>
          メール
          <span
            class='inline-flex items-center px-1.5 py-px rounded text-[10px] font-semibold leading-none bg-[hsl(var(--cc-main-orange)/0.1)] text-[hsl(var(--cc-main-orange))] border border-[hsl(var(--cc-main-orange)/0.3)]'
            aria-label='プレビュー版'
          >
            Preview
          </span>
        </button>
      </div>

      <!-- Discord パネル -->
      <div id='panel-discord' role='tabpanel' aria-labelledby='tab-discord'>
        <!-- セットアップガイド -->
        <section
          class='mb-8 rounded-xl border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))]'
        >
          <details class='group'>
            <summary
              class='flex items-center justify-between gap-3 px-5 py-4 cursor-pointer select-none'
            >
              <span
                class='text-sm font-medium text-[hsl(var(--cc-main-black)/0.8)]'
              >
                Webhook URLの取得方法
              </span>
              <svg
                class='w-4 h-4 text-[hsl(var(--cc-main-black)/0.4)] transition-transform duration-200 group-open:rotate-180'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
                aria-hidden='true'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M19 9l-7 7-7-7'></path>
              </svg>
            </summary>
            <div class='px-5 pb-5'>
              <div class='border-t border-[hsl(var(--cc-gray))] pt-4'>
                <ol
                  class='ml-5 list-decimal list-outside space-y-2 text-sm text-[hsl(var(--cc-main-black)/0.7)] leading-relaxed'
                >
                  <li>Discordで通知を受け取りたいサーバーを開く</li>
                  <li>
                    <strong>サーバー設定</strong> → <strong>連携サービス</strong
                    >
                    → <strong>ウェブフック</strong>
                  </li>
                  <li>
                    <strong>新しいウェブフック</strong
                    >を作成し、通知先のチャンネルを選択
                  </li>
                  <li>
                    <strong>URLをコピー</strong>して下のフォームに貼り付け
                  </li>
                </ol>
              </div>
            </div>
          </details>
        </section>

        <!-- 登録フォーム -->
        <section
          class='rounded-xl border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] p-5 sm:p-6'
        >
          <form
            id='discord-form'
            data-worker-url={url}
            data-channel-type='DSC'
            class='space-y-5'
          >
            <div>
              <label
                for='discord-webhook-url'
                class='block text-sm font-medium text-[hsl(var(--cc-main-black)/0.8)] mb-2'
              >
                Webhook URL
              </label>
              <input
                type='url'
                id='discord-webhook-url'
                name='webhook_url'
                required
                placeholder='https://discord.com/api/webhooks/...'
                class='w-full px-4 py-3 rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] text-sm text-[hsl(var(--cc-main-black))] placeholder-[hsl(var(--cc-main-black)/0.3)] focus:outline-none focus:border-[hsl(var(--cc-main-orange))] focus:ring-2 focus:ring-[hsl(var(--cc-main-orange)/0.2)] transition-[border-color,box-shadow] invalid:not-placeholder-shown:border-[#ff6b6b]'
              />
              <p
                id='discord-webhook-url-error'
                class='mt-1.5 text-xs text-[#ff6b6b] hidden'
              >
                Discord Webhook URLの形式が正しくありません
              </p>
            </div>

            <div
              id='discord-turnstile'
              class='cf-turnstile'
              data-sitekey='0x4AAAAAACiQA9X81J2ub2Qt'
              data-callback='onDiscordTurnstileSuccess'
              data-expired-callback='onDiscordTurnstileExpired'
            >
            </div>

            <button
              type='submit'
              id='discord-submit-btn'
              disabled
              class='w-full sm:w-auto inline-flex items-center justify-center gap-2 h-11 px-6 rounded-lg bg-[hsl(var(--cc-main-orange))] text-sm font-medium text-[hsl(var(--cc-main-white))] cursor-pointer transition-[background-color,box-shadow,transform] hover:bg-[hsl(var(--cc-orange-hover))] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(var(--cc-main-orange))] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-40 active:scale-[0.96]'
            >
              <span id='discord-submit-text'>登録する</span>
              <svg
                id='discord-submit-spinner'
                class='w-4 h-4 animate-spin hidden'
                fill='none'
                viewBox='0 0 24 24'
                aria-hidden='true'
              >
                <circle
                  class='opacity-25'
                  cx='12'
                  cy='12'
                  r='10'
                  stroke='currentColor'
                  stroke-width='4'></circle>
                <path
                  class='opacity-75'
                  fill='currentColor'
                  d='M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z'
                ></path>
              </svg>
            </button>
          </form>

          <div id='discord-result-message' class='mt-5 hidden'></div>
        </section>
      </div>

      <!-- Slack パネル -->
      <div
        id='panel-slack'
        role='tabpanel'
        aria-labelledby='tab-slack'
        class='hidden'
      >
        <!-- セットアップガイド -->
        <section
          class='mb-8 rounded-xl border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))]'
        >
          <details class='group'>
            <summary
              class='flex items-center justify-between gap-3 px-5 py-4 cursor-pointer select-none'
            >
              <span
                class='text-sm font-medium text-[hsl(var(--cc-main-black)/0.8)]'
              >
                Webhook URLの取得方法
              </span>
              <svg
                class='w-4 h-4 text-[hsl(var(--cc-main-black)/0.4)] transition-transform duration-200 group-open:rotate-180'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
                aria-hidden='true'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M19 9l-7 7-7-7'></path>
              </svg>
            </summary>
            <div class='px-5 pb-5'>
              <div class='border-t border-[hsl(var(--cc-gray))] pt-4'>
                <ol
                  class='ml-5 list-decimal list-outside space-y-3 text-sm text-[hsl(var(--cc-main-black)/0.7)] leading-relaxed'
                >
                  <li>
                    Slack の管理画面( <a
                      href='https://api.slack.com/apps'
                      target='_blank'
                      rel='noopener noreferrer'
                      class='text-[hsl(var(--cc-main-orange))] hover:underline'
                      >https://api.slack.com/apps
                    </a>) に遷移
                  </li>
                  <li>
                    <strong>Create New App</strong> から <strong
                      >Create app from manifest</strong
                    > を選択し、下記のマニフェストを貼り付ける
                  </li>
                </ol>

                <!-- マニフェスト表示ブロック -->
                <div
                  class='relative mt-4 rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-black)/0.04)] overflow-hidden'
                >
                  <div
                    class='flex items-center justify-between px-4 py-2 border-b border-[hsl(var(--cc-gray))]'
                  >
                    <span
                      class='text-xs font-medium text-[hsl(var(--cc-main-black)/0.5)]'
                    >
                      slack-app-manifest.yaml
                    </span>
                    <button
                      id='copy-manifest-btn'
                      type='button'
                      class='flex items-center gap-1.5 text-xs text-[hsl(var(--cc-main-black)/0.5)] hover:text-[hsl(var(--cc-main-orange))] transition-colors cursor-pointer'
                      aria-label='マニフェストをコピー'
                    >
                      <svg
                        id='copy-icon'
                        class='w-3.5 h-3.5'
                        fill='none'
                        viewBox='0 0 24 24'
                        stroke='currentColor'
                        stroke-width='2'
                        aria-hidden='true'
                      >
                        <rect x='9' y='9' width='13' height='13' rx='2' ry='2'
                        ></rect>
                        <path
                          d='M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1'
                        ></path>
                      </svg>
                      <svg
                        id='check-icon'
                        class='w-3.5 h-3.5 hidden text-[hsl(var(--cc-main-orange))]'
                        fill='none'
                        viewBox='0 0 24 24'
                        stroke='currentColor'
                        stroke-width='2.5'
                        aria-hidden='true'
                      >
                        <path
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          d='M5 13l4 4L19 7'></path>
                      </svg>
                      <span id='copy-label'>コピー</span>
                    </button>
                  </div>
                  <pre
                    class='p-4 text-xs leading-relaxed overflow-x-auto text-[hsl(var(--cc-main-black)/0.75)] font-mono'><code>{slackManifestContent}</code></pre>
                </div>

                <ol
                  class='ml-5 list-decimal list-outside space-y-2 text-sm text-[hsl(var(--cc-main-black)/0.7)] leading-relaxed mt-3'
                  start='3'
                >
                  <li>
                    App 作成後、アプリ設定ページの <strong
                      >Incoming Webhooks</strong
                    > を選択
                  </li>
                  <li>
                    <strong>Webhook URLs for Your Workspace</strong> にある <strong
                      >Add New Webhook to Workspace</strong
                    > から投稿したいチャンネルを選択
                  </li>
                  <li>認証画面で投稿先チャンネルを選択して許可</li>
                  <li>
                    表示された <strong>Webhook URL をコピー</strong
                    >して下のフォームに貼り付け
                  </li>
                </ol>
              </div>
            </div>
          </details>
        </section>

        <!-- 登録フォーム -->
        <section
          class='rounded-xl border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] p-5 sm:p-6'
        >
          <form
            id='slack-form'
            data-worker-url={url}
            data-channel-type='SLK'
            class='space-y-5'
          >
            <div>
              <label
                for='slack-webhook-url'
                class='block text-sm font-medium text-[hsl(var(--cc-main-black)/0.8)] mb-2'
              >
                Webhook URL
              </label>
              <input
                type='url'
                id='slack-webhook-url'
                name='webhook_url'
                required
                placeholder='https://hooks.slack.com/services/...'
                class='w-full px-4 py-3 rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] text-sm text-[hsl(var(--cc-main-black))] placeholder-[hsl(var(--cc-main-black)/0.3)] focus:outline-none focus:border-[hsl(var(--cc-main-orange))] focus:ring-2 focus:ring-[hsl(var(--cc-main-orange)/0.2)] transition-[border-color,box-shadow] invalid:not-placeholder-shown:border-[#ff6b6b]'
              />
              <p
                id='slack-webhook-url-error'
                class='mt-1.5 text-xs text-[#ff6b6b] hidden'
              >
                Slack Incoming Webhook URLの形式が正しくありません
              </p>
            </div>

            <div
              id='slack-turnstile'
              class='cf-turnstile'
              data-sitekey='0x4AAAAAACiQA9X81J2ub2Qt'
              data-callback='onSlackTurnstileSuccess'
              data-expired-callback='onSlackTurnstileExpired'
            >
            </div>

            <button
              type='submit'
              id='slack-submit-btn'
              disabled
              class='w-full sm:w-auto inline-flex items-center justify-center gap-2 h-11 px-6 rounded-lg bg-[hsl(var(--cc-main-orange))] text-sm font-medium text-[hsl(var(--cc-main-white))] cursor-pointer transition-[background-color,box-shadow,transform] hover:bg-[hsl(var(--cc-orange-hover))] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(var(--cc-main-orange))] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-40 active:scale-[0.96]'
            >
              <span id='slack-submit-text'>登録する</span>
              <svg
                id='slack-submit-spinner'
                class='w-4 h-4 animate-spin hidden'
                fill='none'
                viewBox='0 0 24 24'
                aria-hidden='true'
              >
                <circle
                  class='opacity-25'
                  cx='12'
                  cy='12'
                  r='10'
                  stroke='currentColor'
                  stroke-width='4'></circle>
                <path
                  class='opacity-75'
                  fill='currentColor'
                  d='M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z'
                ></path>
              </svg>
            </button>
          </form>

          <div id='slack-result-message' class='mt-5 hidden'></div>
        </section>
      </div>

      <!-- Email パネル -->
      <div
        id='panel-email'
        role='tabpanel'
        aria-labelledby='tab-email'
        class='hidden'
      >
        <!-- プレビュー版バナー -->
        <div
          class='mb-6 flex gap-3 items-start rounded-xl border border-[hsl(var(--cc-main-orange)/0.3)] bg-[hsl(var(--cc-main-orange)/0.06)] px-4 py-3.5'
          role='note'
          aria-label='プレビュー版に関する注意'
        >
          <svg
            class='w-4 h-4 text-[hsl(var(--cc-main-orange))] mt-px shrink-0'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z'
            ></path>
          </svg>
          <div>
            <p class='text-sm font-semibold text-[hsl(var(--cc-main-orange))]'>
              プレビュー版
            </p>
            <p
              class='mt-0.5 text-xs leading-relaxed text-[hsl(var(--cc-main-black)/0.6)]'
            >
              メール通知はプレビュー版です。予告なく停止する場合があります。
            </p>
          </div>
        </div>

        <!-- セットアップガイド -->
        <section
          class='mb-8 rounded-xl border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))]'
        >
          <details class='group'>
            <summary
              class='flex items-center justify-between gap-3 px-5 py-4 cursor-pointer select-none'
            >
              <span
                class='text-sm font-medium text-[hsl(var(--cc-main-black)/0.8)]'
              >
                メール通知について
              </span>
              <svg
                class='w-4 h-4 text-[hsl(var(--cc-main-black)/0.4)] transition-transform duration-200 group-open:rotate-180'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
                aria-hidden='true'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M19 9l-7 7-7-7'></path>
              </svg>
            </summary>
            <div class='px-5 pb-5'>
              <div class='border-t border-[hsl(var(--cc-gray))] pt-4'>
                <ol
                  class='ml-5 list-decimal list-outside space-y-2 text-sm text-[hsl(var(--cc-main-black)/0.7)] leading-relaxed'
                >
                  <li>受け取りたいメールアドレスを入力する</li>
                  <li>登録ボタンを押すと、確認メールが届く</li>
                  <li>
                    Claude Code
                    の新バージョンがリリースされると自動でメールが届く
                  </li>
                  <li>通知停止はメール内の「通知を停止する」リンクから行う</li>
                </ol>
              </div>
            </div>
          </details>
        </section>

        <!-- 登録フォーム -->
        <section
          class='rounded-xl border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] p-5 sm:p-6'
        >
          <form
            id='email-form'
            data-worker-url={url}
            data-channel-type='EML'
            class='space-y-5'
          >
            <div>
              <label
                for='email-address'
                class='block text-sm font-medium text-[hsl(var(--cc-main-black)/0.8)] mb-2'
              >
                メールアドレス
              </label>
              <input
                type='email'
                id='email-address'
                name='email_address'
                required
                placeholder='you@example.com'
                class='w-full px-4 py-3 rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] text-sm text-[hsl(var(--cc-main-black))] placeholder-[hsl(var(--cc-main-black)/0.3)] focus:outline-none focus:border-[hsl(var(--cc-main-orange))] focus:ring-2 focus:ring-[hsl(var(--cc-main-orange)/0.2)] transition-[border-color,box-shadow] invalid:not-placeholder-shown:border-[#ff6b6b]'
              />
              <p
                id='email-address-error'
                class='mt-1.5 text-xs text-[#ff6b6b] hidden'
              >
                メールアドレスの形式が正しくありません
              </p>
            </div>

            <div
              id='email-turnstile'
              class='cf-turnstile'
              data-sitekey='0x4AAAAAACiQA9X81J2ub2Qt'
              data-callback='onEmailTurnstileSuccess'
              data-expired-callback='onEmailTurnstileExpired'
            >
            </div>

            <button
              type='submit'
              id='email-submit-btn'
              disabled
              class='w-full sm:w-auto inline-flex items-center justify-center gap-2 h-11 px-6 rounded-lg bg-[hsl(var(--cc-main-orange))] text-sm font-medium text-[hsl(var(--cc-main-white))] cursor-pointer transition-[background-color,box-shadow,transform] hover:bg-[hsl(var(--cc-orange-hover))] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(var(--cc-main-orange))] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-40 active:scale-[0.96]'
            >
              <span id='email-submit-text'>登録する</span>
              <svg
                id='email-submit-spinner'
                class='w-4 h-4 animate-spin hidden'
                fill='none'
                viewBox='0 0 24 24'
                aria-hidden='true'
              >
                <circle
                  class='opacity-25'
                  cx='12'
                  cy='12'
                  r='10'
                  stroke='currentColor'
                  stroke-width='4'></circle>
                <path
                  class='opacity-75'
                  fill='currentColor'
                  d='M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z'
                ></path>
              </svg>
            </button>
          </form>

          <div id='email-result-message' class='mt-5 hidden'></div>
        </section>
      </div>
    </div>
  </div>

  <script is:inline>
    window.onDiscordTurnstileSuccess = () => {
      const btn = document.getElementById('discord-submit-btn');
      if (btn) {
        btn.disabled = false;
      }
    };
    window.onDiscordTurnstileExpired = () => {
      const btn = document.getElementById('discord-submit-btn');
      if (btn) {
        btn.disabled = true;
      }
    };
    window.onSlackTurnstileSuccess = () => {
      const btn = document.getElementById('slack-submit-btn');
      if (btn) {
        btn.disabled = false;
      }
    };
    window.onSlackTurnstileExpired = () => {
      const btn = document.getElementById('slack-submit-btn');
      if (btn) {
        btn.disabled = true;
      }
    };
    window.onEmailTurnstileSuccess = () => {
      const btn = document.getElementById('email-submit-btn');
      if (btn) {
        btn.disabled = false;
      }
    };
    window.onEmailTurnstileExpired = () => {
      const btn = document.getElementById('email-submit-btn');
      if (btn) {
        btn.disabled = true;
      }
    };
  </script>
  <script
    is:inline
    src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'
    async
    defer></script>

  <script>
    import { setupCopyButton } from '../lib/notify/copy-button';
    import { setupForm } from '../lib/notify/form';
    import { setupTabs } from '../lib/notify/tabs';
    import { renderTurnstileFor } from '../lib/notify/turnstile';

    document.addEventListener('astro:page-load', () => {
      setupTabs();
      setupCopyButton();

      // Discord Turnstile の初期レンダリング(デフォルトタブ)
      if (window.turnstile) {
        renderTurnstileFor('discord-turnstile', 'discord');
      } else {
        const script = document.querySelector<HTMLScriptElement>(
          'script[src*="turnstile"]',
        );
        script?.addEventListener('load', () => {
          renderTurnstileFor('discord-turnstile', 'discord');
        });
      }

      setupForm({
        formId: 'discord-form',
        webhookInputId: 'discord-webhook-url',
        webhookErrorId: 'discord-webhook-url-error',
        submitButtonId: 'discord-submit-btn',
        submitTextId: 'discord-submit-text',
        submitSpinnerId: 'discord-submit-spinner',
        resultMessageId: 'discord-result-message',
        inputFieldName: 'webhook_url',
        validateUrl: (url) =>
          /^https:\/\/discord\.com\/api\/webhooks\/\d+\/[\w-]+$/.test(url),
      });

      setupForm({
        formId: 'slack-form',
        webhookInputId: 'slack-webhook-url',
        webhookErrorId: 'slack-webhook-url-error',
        submitButtonId: 'slack-submit-btn',
        submitTextId: 'slack-submit-text',
        submitSpinnerId: 'slack-submit-spinner',
        resultMessageId: 'slack-result-message',
        inputFieldName: 'webhook_url',
        validateUrl: (url) =>
          /^https:\/\/hooks\.slack\.com\/services\/[A-Z0-9]+\/[A-Z0-9]+\/[A-Za-z0-9]+$/.test(
            url,
          ),
      });

      setupForm({
        formId: 'email-form',
        webhookInputId: 'email-address',
        webhookErrorId: 'email-address-error',
        submitButtonId: 'email-submit-btn',
        submitTextId: 'email-submit-text',
        submitSpinnerId: 'email-submit-spinner',
        resultMessageId: 'email-result-message',
        inputFieldName: 'email_address',
        validateUrl: (email) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email),
      });
    });
  </script>
</Layout>
