---
import WeeklySelection from '../../components/admin/WeeklySelection.astro';
import Layout from '../../layouts/Layout.astro';
import { getWeeklyAdminWeeks } from '../../lib/weekly-admin';

// 最新週はこのページが担当する。2週目以降は /admin/weekly/[week] が生成する
const weeks = await getWeeklyAdminWeeks();
const latest = weeks[0];
---

{
  latest ? (
    <WeeklySelection current={latest} weeks={weeks} />
  ) : (
    <Layout
      title='週次アップデート記事の選定'
      description='週次アップデート記事に掲載する Claude Code の変更を選定します。'
      noindex
    >
      <div class='min-h-dvh px-4 py-10 sm:py-14'>
        <div class='mx-auto max-w-4xl'>
          <h1 class='text-3xl font-bold tracking-tight text-[hsl(var(--cc-main-black))]'>
            週次アップデート記事の選定
          </h1>
          <p class='mt-4 text-sm text-[hsl(var(--cc-main-black)/0.65)]'>
            対象週を特定できませんでした。ビルド時に GitHub Releases
            の公開日を取得できなかった可能性があります。
          </p>
        </div>
      </div>
    </Layout>
  )
}
