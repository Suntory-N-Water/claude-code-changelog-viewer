---
import { getCollection } from 'astro:content';
import { TZDate } from '@date-fns/tz';
import {
  endOfISOWeek,
  format,
  getISOWeek,
  getISOWeekYear,
  startOfISOWeek,
} from 'date-fns';
import ChangelogItemCard from '../../components/changelog/ChangelogItemCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getReleaseMap } from '../../lib/release-map';
import { semverCompareDesc } from '../../lib/semver';

const releaseMap = await getReleaseMap();
const changelogs = await getCollection('changelog');

const weeklyItems = changelogs
  .flatMap((entry) => {
    const publishedAt = releaseMap.get(entry.data.version);
    if (!publishedAt) {
      return [];
    }

    const date = new TZDate(publishedAt, 'Asia/Tokyo');
    const periodStart = startOfISOWeek(date);
    const periodEnd = endOfISOWeek(date);

    return entry.data.items.map((item) => ({
      item,
      version: entry.data.version,
      week: `${getISOWeekYear(date)}-w${String(getISOWeek(date)).padStart(2, '0')}`,
      periodStart: format(periodStart, 'yyyy-MM-dd'),
      periodEnd: format(periodEnd, 'yyyy-MM-dd'),
    }));
  })
  .sort((a, b) => semverCompareDesc(a.version, b.version));

const weeks = [
  ...new Map(
    weeklyItems.map(({ week, periodStart, periodEnd }) => [
      week,
      { week, periodStart, periodEnd },
    ]),
  ).values(),
].toSorted((a, b) => b.week.localeCompare(a.week));
---

<Layout
  title='週次アップデート記事の選定'
  description='週次アップデート記事に掲載する Claude Code の変更を選定します。'
  noindex
>
  <div class='min-h-dvh py-10 sm:py-14 px-4'>
    <div class='max-w-4xl mx-auto'>
      <header class='mb-8'>
        <h1
          class='text-3xl font-bold tracking-tight text-[hsl(var(--cc-main-black))]'
        >
          週次アップデート記事の選定
        </h1>
        <p class='mt-2 text-sm text-[hsl(var(--cc-main-black)/0.65)]'>
          掲載する変更を選び、体験や補足をコメントしてください。
        </p>
      </header>

      <section
        class='sticky top-14 z-40 mb-8 rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white)/0.95)] p-4 shadow-sm backdrop-blur'
      >
        <div
          class='flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between'
        >
          <label class='block'>
            <span
              class='block text-sm font-medium text-[hsl(var(--cc-main-black))]'
              >対象週</span
            >
            <select
              id='week-select'
              class='mt-1.5 min-w-56 rounded-md border border-[hsl(var(--cc-gray))] bg-white px-3 py-2 text-sm'
            >
              {
                weeks.map(({ week, periodStart, periodEnd }) => (
                  <option value={week}>
                    {week} ({periodStart} – {periodEnd})
                  </option>
                ))
              }
            </select>
          </label>
          <button
            id='copy-button'
            type='button'
            class='rounded-md bg-[hsl(var(--cc-main-orange))] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[hsl(var(--cc-orange-hover))] disabled:cursor-not-allowed disabled:opacity-50'
          >
            選定内容をコピー
          </button>
        </div>
      </section>

      <p
        id='empty-message'
        class='hidden py-12 text-center text-sm text-[hsl(var(--cc-main-black)/0.6)]'
      >
        この週に公開された変更はありません。
      </p>

      <div class='space-y-5'>
        {
          weeklyItems.map(({ item, version, week }) => (
            <section data-week={week} class='weekly-item'>
              <div class='mb-2 flex items-center gap-3'>
                <label class='inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-[hsl(var(--cc-main-black))]'>
                  <input
                    type='checkbox'
                    data-item-id={item.id}
                    data-version={version}
                    class='size-4 accent-[hsl(var(--cc-main-orange))]'
                  />
                  記事に掲載する
                </label>
                <span class='font-mono text-xs text-[hsl(var(--cc-main-black)/0.5)]'>
                  v{version}
                </span>
              </div>
              <ChangelogItemCard item={item} />
              <label data-comment hidden class='mt-3'>
                <span class='text-sm font-medium text-[hsl(var(--cc-main-black))]'>
                  コメント
                </span>
                <textarea
                  data-comment-for={item.id}
                  rows='3'
                  disabled
                  class='mt-1.5 block w-full rounded-md border border-[hsl(var(--cc-gray))] bg-white px-3 py-2 text-sm leading-relaxed focus:border-[hsl(var(--cc-main-orange))] focus:outline-none focus:ring-2 focus:ring-[hsl(var(--cc-main-orange)/0.2)]'
                  placeholder='この変更を使った体験や、読者に伝えたいこと'
                />
              </label>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ weeks }}>
  const weekSelect = document.querySelector('#week-select');
  const copyButton = document.querySelector('#copy-button');
  const emptyMessage = document.querySelector('#empty-message');

  function filterItems() {
    const week = weekSelect.value;
    let count = 0;
    document.querySelectorAll('.weekly-item').forEach((element) => {
      const hidden = element.dataset.week !== week;
      element.hidden = hidden;
      if (!hidden) {
        count += 1;
      }
    });
    emptyMessage.classList.toggle('hidden', count > 0);
  }

  weekSelect.addEventListener('change', filterItems);
  filterItems();

  document
    .querySelectorAll('.weekly-item input[type="checkbox"]')
    .forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        const comment = checkbox
          .closest('.weekly-item')
          .querySelector('[data-comment]');
        const textarea = comment.querySelector('textarea');
        comment.hidden = !checkbox.checked;
        textarea.disabled = !checkbox.checked;
      });
    });

  copyButton.addEventListener('click', async () => {
    const selectedWeek = weeks.find(({ week }) => week === weekSelect.value);
    if (!selectedWeek) {
      return;
    }

    const items = [
      ...document.querySelectorAll(
        '.weekly-item:not([hidden]) input[type="checkbox"]:checked',
      ),
    ].map((checkbox) => ({
      id: checkbox.dataset.itemId,
      version: checkbox.dataset.version,
      comment: document.querySelector(
        `[data-comment-for="${checkbox.dataset.itemId}"]`,
      ).value,
    }));
    const content = JSON.stringify(
      {
        week: selectedWeek.week,
        period_start: selectedWeek.periodStart,
        period_end: selectedWeek.periodEnd,
        items,
      },
      null,
      2,
    );

    try {
      await navigator.clipboard.writeText(content);
      const label = copyButton.textContent;
      copyButton.textContent = 'コピーしました';
      setTimeout(() => {
        copyButton.textContent = label;
      }, 2000);
    } catch {
      const textarea = document.createElement('textarea');
      textarea.value = content;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
    }
  });
</script>
