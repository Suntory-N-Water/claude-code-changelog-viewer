---
import { getCollection } from 'astro:content';
import { TZDate } from '@date-fns/tz';
import {
  endOfISOWeek,
  format,
  getISOWeek,
  getISOWeekYear,
  startOfISOWeek,
} from 'date-fns';
import ChangelogItemCard from '../../components/changelog/ChangelogItemCard.astro';
import WeeklyImageUpload from '../../components/admin/WeeklyImageUpload.astro';
import Button from '../../components/ui/Button.astro';
import Select from '../../components/ui/Select.astro';
import Card from '../../components/ui/Card.astro';
import Layout from '../../layouts/Layout.astro';
import { getReleaseMap } from '../../lib/release-map';
import { semverCompareDesc } from '../../lib/semver';

const releaseMap = await getReleaseMap();
const changelogs = await getCollection('changelog');

const weeklyItems = changelogs
  .flatMap((entry) => {
    const publishedAt = releaseMap.get(entry.data.version);
    if (!publishedAt) {
      return [];
    }

    const date = new TZDate(publishedAt, 'Asia/Tokyo');
    const periodStart = startOfISOWeek(date);
    const periodEnd = endOfISOWeek(date);

    return entry.data.items.map((item) => ({
      item,
      version: entry.data.version,
      week: `${getISOWeekYear(date)}-w${String(getISOWeek(date)).padStart(2, '0')}`,
      periodStart: format(periodStart, 'yyyy-MM-dd'),
      periodEnd: format(periodEnd, 'yyyy-MM-dd'),
    }));
  })
  .sort((a, b) => semverCompareDesc(a.version, b.version));

const weeks = [
  ...new Map(
    weeklyItems.map(({ week, periodStart, periodEnd }) => [
      week,
      { week, periodStart, periodEnd },
    ]),
  ).values(),
].toSorted((a, b) => b.week.localeCompare(a.week));

// デフォルトは最新週(先頭)。ビルド時点で他週の <section> を hidden にして初期表示を最新週だけに揃える。
const defaultWeek = weeks[0]?.week;
---

<Layout
  title='週次アップデート記事の選定'
  description='週次アップデート記事に掲載する Claude Code の変更を選定します。'
  noindex
>
  <div class='min-h-dvh py-10 sm:py-14 px-4'>
    <div class='max-w-4xl mx-auto'>
      <header class='mb-8'>
        <h1
          class='text-3xl font-bold tracking-tight text-[hsl(var(--cc-main-black))]'
        >
          週次アップデート記事の選定
        </h1>
        <p class='mt-2 text-sm text-[hsl(var(--cc-main-black)/0.65)]'>
          掲載する変更を選び、体験や補足をコメントしてください。
        </p>
      </header>

      <Card
        as='section'
        padding='sm'
        radius='lg'
        class='mb-8 bg-[hsl(var(--cc-main-white)/0.95)] shadow-sm'
      >
        <div
          class='flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between'
        >
          <label for='week-select' class='block'>
            <span
              class='block text-sm font-medium text-[hsl(var(--cc-main-black))]'
              >対象週</span
            >
            <Select
              id='week-select'
              class='mt-1.5 min-w-56 rounded-md bg-white'
            >
              {
                weeks.map(({ week, periodStart, periodEnd }) => (
                  <option value={week} selected={week === defaultWeek}>
                    {week} ({periodStart} – {periodEnd})
                  </option>
                ))
              }
            </Select>
          </label>
          <div class='flex gap-2'>
            <Button
              id='clear-button'
              type='button'
              variant='outline'
              size='sm'
              class='rounded-md bg-white font-semibold text-[hsl(var(--cc-main-black))] hover:bg-[hsl(var(--cc-gray)/0.15)]'
            >
              一括削除
            </Button>
            <Button
              id='copy-button'
              type='button'
              size='sm'
              class='rounded-md font-semibold disabled:cursor-not-allowed'
            >
              選定内容をコピー
            </Button>
          </div>
        </div>
      </Card>

      <p
        id='empty-message'
        class='hidden py-12 text-center text-sm text-[hsl(var(--cc-main-black)/0.6)]'
      >
        この週に公開された変更はありません。
      </p>

      <div class='space-y-5'>
        {
          weeklyItems.map(({ item, version, week }) => (
            <section
              data-week={week}
              class='weekly-item'
              hidden={week !== defaultWeek}
            >
              <div class='mb-2 flex items-center gap-3'>
                <label class='inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-[hsl(var(--cc-main-black))]'>
                  <input
                    type='checkbox'
                    data-item-id={item.id}
                    data-version={version}
                    class='size-4 accent-[hsl(var(--cc-main-orange))]'
                  />
                  記事に掲載する
                </label>
                <span class='font-mono text-xs text-[hsl(var(--cc-main-black)/0.5)]'>
                  v{version}
                </span>
              </div>
              <ChangelogItemCard item={item} />
              <label data-comment hidden class='mt-3'>
                <span class='text-sm font-medium text-[hsl(var(--cc-main-black))]'>
                  コメント
                </span>
                <textarea
                  data-comment-for={item.id}
                  rows='3'
                  disabled
                  class='mt-1.5 block w-full rounded-md border border-[hsl(var(--cc-gray))] bg-white px-3 py-2 text-sm leading-relaxed focus:border-[hsl(var(--cc-main-orange))] focus:outline-none focus:ring-2 focus:ring-[hsl(var(--cc-main-orange)/0.2)]'
                  placeholder='この変更を使った体験や、読者に伝えたいこと'
                />
              </label>
              <WeeklyImageUpload week={week} itemId={item.id} />
            </section>
          ))
        }
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ weeks }}>
  const weekSelect = document.querySelector('#week-select');
  const copyButton = document.querySelector('#copy-button');
  const clearButton = document.querySelector('#clear-button');
  const emptyMessage = document.querySelector('#empty-message');

  const STORAGE_KEY = 'weekly-admin-selection';

  customElements.whenDefined('weekly-image-upload').then(() => {
    const state = (() => {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? {};
      } catch {
        return {};
      }
    })();

    function updateState(itemId, patch) {
      const current = state[itemId] ?? { checked: false, comment: '' };
      const next = { ...current, ...patch };
      if (next.checked || next.comment || next.imageUrl) {
        state[itemId] = next;
      } else {
        delete state[itemId];
      }
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    function syncItem(checkbox) {
      const section = checkbox.closest('.weekly-item');
      const comment = section.querySelector('[data-comment]');
      const imageUpload = section.querySelector('weekly-image-upload');
      comment.hidden = !checkbox.checked;
      comment.querySelector('textarea').disabled = !checkbox.checked;
      imageUpload.hidden = !checkbox.checked;
    }

    function filterItems() {
      const week = weekSelect.value;
      const items = [...document.querySelectorAll('.weekly-item')];
      for (const element of items) {
        element.hidden = element.dataset.week !== week;
      }
      emptyMessage.classList.toggle(
        'hidden',
        items.some((element) => !element.hidden),
      );
    }

    weekSelect.addEventListener('change', filterItems);
    filterItems();

    document.querySelectorAll('.weekly-item').forEach((section) => {
      const checkbox = section.querySelector('input[type="checkbox"]');
      const textarea = section.querySelector('textarea');
      const imageUpload = section.querySelector('weekly-image-upload');
      const itemId = checkbox.dataset.itemId;
      const saved = state[itemId];
      if (saved) {
        checkbox.checked = saved.checked;
        textarea.value = saved.comment;
      }
      syncItem(checkbox);
      imageUpload.imageUrl = saved?.imageUrl;

      checkbox.addEventListener('change', () => {
        syncItem(checkbox);
        updateState(itemId, { checked: checkbox.checked });
      });
      textarea.addEventListener('input', () => {
        updateState(itemId, { comment: textarea.value });
      });
      imageUpload.addEventListener('image-change', (event) => {
        updateState(itemId, { imageUrl: event.detail.imageUrl });
      });
    });

    clearButton.addEventListener('click', () => {
      if (!confirm('入力した選定内容をすべて削除します。よろしいですか？')) {
        return;
      }
      document
        .querySelectorAll('.weekly-item input[type="checkbox"]')
        .forEach((checkbox) => {
          const section = checkbox.closest('.weekly-item');
          checkbox.checked = false;
          document.querySelector(
            `[data-comment-for="${checkbox.dataset.itemId}"]`,
          ).value = '';
          syncItem(checkbox);
          section.querySelector('weekly-image-upload').clear();
        });
      for (const itemId of Object.keys(state)) {
        delete state[itemId];
      }
      localStorage.removeItem(STORAGE_KEY);
    });

    copyButton.addEventListener('click', async () => {
      const selectedWeek = weeks.find(({ week }) => week === weekSelect.value);
      if (!selectedWeek) {
        return;
      }

      const items = [
        ...document.querySelectorAll(
          '.weekly-item:not([hidden]) input[type="checkbox"]:checked',
        ),
      ].map((checkbox) => {
        const imageUrl = state[checkbox.dataset.itemId]?.imageUrl;
        return {
          id: checkbox.dataset.itemId,
          version: checkbox.dataset.version,
          comment: document.querySelector(
            `[data-comment-for="${checkbox.dataset.itemId}"]`,
          ).value,
          ...(imageUrl ? { image_url: imageUrl } : {}),
        };
      });
      const totalItems = document.querySelectorAll(
        '.weekly-item:not([hidden])',
      ).length;
      const content = JSON.stringify(
        {
          week: selectedWeek.week,
          period_start: selectedWeek.periodStart,
          period_end: selectedWeek.periodEnd,
          total_items: totalItems,
          items,
        },
        null,
        2,
      );

      try {
        await navigator.clipboard.writeText(content);
        const label = copyButton.textContent;
        copyButton.textContent = 'コピーしました';
        setTimeout(() => {
          copyButton.textContent = label;
        }, 2000);
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = content;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }
    });
  });
</script>
