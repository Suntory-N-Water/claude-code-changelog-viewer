---
import { getCollection, render } from 'astro:content';
import { format, parseISO } from 'date-fns';
import { ja } from 'date-fns/locale';
import PostBody from '../../../components/posts/PostBody.astro';
import PostShare from '../../../components/posts/PostShare.astro';
import PostTocAccordion from '../../../components/posts/PostTocAccordion.astro';
import PostTocSidebar from '../../../components/posts/PostTocSidebar.astro';
import BackLink from '../../../components/ui/BackLink.astro';
import Layout from '../../../layouts/Layout.astro';
import { SITE_TITLE } from '../../../lib/constants';

export async function getStaticPaths() {
  const posts = await getCollection('column');

  return posts.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const { title, slug, description, date, modified_time } = entry.data;

const formattedDate = format(parseISO(date), 'yyyy年M月d日', { locale: ja });
const formattedModified = modified_time
  ? format(parseISO(modified_time), 'yyyy年M月d日', { locale: ja })
  : null;

// ## / ### のみを目次対象にする
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const baseUrl = Astro.site?.href ?? '/';
const shareUrl = new URL(`posts/column/${slug}`, baseUrl).href;
const ogImage = new URL(`posts/column/og/${slug}.png`, baseUrl).href;
---

<Layout
  title={`${title} - ${SITE_TITLE}`}
  description={description}
  image={ogImage}
  jsonLd={{
    type: 'article',
    datePublished: date,
    dateModified: modified_time,
  }}
  breadcrumbs={[
    { name: 'ホーム', url: baseUrl },
    { name: 'コラム', url: `${baseUrl}posts/column` },
    { name: title, url: shareUrl },
  ]}
>
  <div class='pt-8 sm:pt-10 pb-24'>
    <div class='max-w-6xl mx-auto px-4 sm:px-6'>
      <div>
        <BackLink href='/posts/column'>コラム一覧に戻る</BackLink>
      </div>

      <header class='mt-8 mb-12 pb-8 max-w-3xl border-b border-rule'>
        <h1 class='text-[clamp(1.875rem,2.2vw+1.25rem,3rem)] leading-[1.35] text-ink mb-5'>
          {title}
        </h1>
        <div class='flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-muted tabular-nums'>
          <span>
            投稿日{' '}
            <time datetime={date} class='text-ink-2'>
              {formattedDate}
            </time>
          </span>
          {formattedModified && modified_time && (
            <span>
              更新日{' '}
              <time datetime={modified_time} class='text-ink-2'>
                {formattedModified}
              </time>
            </span>
          )}
        </div>
      </header>

      <div class='lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-10'>
        <div class='min-w-0 max-w-3xl'>
          {toc.length > 0 && <PostTocAccordion headings={toc} class='lg:hidden mb-6' />}

          <PostBody>
            <Content />
          </PostBody>

          <PostShare shareUrl={shareUrl} title={title} class='mt-12' />
        </div>

        {toc.length > 0 && <PostTocSidebar headings={toc} />}
      </div>
    </div>
  </div>
</Layout>
