---
import { getCollection, render } from 'astro:content';
import { format, parseISO } from 'date-fns';
import { ja } from 'date-fns/locale';
import Icon from '../../../components/Icon.astro';
import BackLink from '../../../components/ui/BackLink.astro';
import Button from '../../../components/ui/Button.astro';
import Accordion from '../../../components/ui/Accordion.astro';
import Badge from '../../../components/ui/Badge.astro';
import Layout from '../../../layouts/Layout.astro';
import { SITE_TITLE } from '../../../lib/constants';
import { semverCompareDesc } from '../../../lib/semver';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((entry) =>
    entry.id.startsWith('weekly/'),
  );

  return posts.map((entry) => ({
    params: { slug: entry.id.split('/').pop() },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const { title, description, date, period_start, period_end, versions } =
  entry.data;

const formattedDate = format(parseISO(date), 'yyyy年M月d日', { locale: ja });
const period = `${format(parseISO(period_start), 'yyyy年M月d日')}〜${format(parseISO(period_end), 'M月d日')}`;

// frontmatter の description を優先し、未記入なら期間から自動生成する
const metaDescription =
  description ||
  `${period} の Claude Code アップデートから注目の変更をピックアップして解説します。`;

// ## / ### のみを目次対象にする
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// バージョンは新しい順に並べて changelog へリンクする
const sortedVersions = [...versions].sort(semverCompareDesc);

const baseUrl = Astro.site?.href ?? '/';

const shareUrl = new URL(`posts/weekly/${entry.id.split('/').pop()}`, baseUrl)
  .href;
const shareUrlParts = new URL(shareUrl);
const hatenaShareUrl = `https://b.hatena.ne.jp/entry/s/${shareUrlParts.host}${shareUrlParts.pathname}`;
---

<Layout
  title={`${title} - ${SITE_TITLE}`}
  description={metaDescription}
  jsonLd={{
    type: 'article',
    version: sortedVersions[0] ?? '',
    datePublished: date,
  }}
  breadcrumbs={[
    { name: 'ホーム', url: baseUrl },
    { name: '週次まとめ', url: `${baseUrl}posts/weekly` },
    { name: title, url: `${baseUrl}posts/weekly/${entry.id.split('/').pop()}` },
  ]}
>
  <div class='min-h-dvh py-8 sm:py-12 px-4'>
    <div class='max-w-6xl mx-auto'>
      <!-- 戻るリンク -->
      <div class='mb-6'>
        <BackLink href='/posts/weekly'>週次まとめ一覧に戻る</BackLink>
      </div>

      <header class='mb-8 max-w-3xl'>
        <h1
          class='text-2xl sm:text-3xl font-bold tracking-tight text-balance [word-break:auto-phrase] text-[hsl(var(--cc-main-black))] mb-3'
        >
          {title}
        </h1>
        <div
          class='flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[hsl(var(--cc-main-black)/0.55)] tabular-nums'
        >
          <span
            >投稿日 <time datetime={date} class='font-medium'
              >{formattedDate}</time
            ></span
          >
          <span aria-hidden='true'>·</span>
          <span>対象期間 {period}</span>
        </div>
      </header>

      <div class='lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-10'>
        <div class='min-w-0 max-w-3xl'>
          {
            toc.length > 0 && (
              <Accordion variant='muted' class='lg:hidden mb-6'>
                <summary class='cursor-pointer select-none px-4 py-3 text-sm font-semibold text-[hsl(var(--cc-main-black)/0.7)] flex items-center gap-2'>
                  <Icon
                    name='chevron-down'
                    class='w-4 h-4 transition-transform'
                    aria-hidden='true'
                  />
                  目次
                </summary>
                <ul class='px-4 pb-4 space-y-1.5'>
                  {toc.map((h) => (
                    <li class={h.depth === 3 ? 'pl-4' : ''}>
                      <a
                        href={`#${h.slug}`}
                        class='block text-sm [word-break:auto-phrase] text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors'
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </Accordion>
            )
          }

          <article class='weekly-prose'>
            <Content />
          </article>

          {
            sortedVersions.length > 0 && (
              <section
                class='mt-12 pt-6 border-t border-[hsl(var(--cc-gray))]'
                aria-labelledby='related-versions'
              >
                <h2
                  id='related-versions'
                  class='text-sm font-semibold text-[hsl(var(--cc-main-black)/0.6)] uppercase tracking-wide mb-3'
                >
                  この記事で扱ったバージョン
                </h2>
                <ul class='flex flex-wrap gap-2'>
                  {sortedVersions.map((version) => (
                    <li>
                      <Badge
                        href={`/changelog/v${version}`}
                        variant='outline'
                        class='gap-1 px-3 py-1 text-sm font-medium tabular-nums hover:border-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-main-orange))] transition-colors'
                      >
                        v{version}
                        <Icon
                          name='chevron-right'
                          class='w-3.5 h-3.5'
                          aria-hidden='true'
                        />
                      </Badge>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <section
            class='mt-8 pt-6 border-t border-[hsl(var(--cc-gray))]'
            aria-labelledby='share-heading'
          >
            <div id='share-section' class='flex flex-wrap items-center gap-2.5'>
              <span
                id='share-heading'
                class='text-sm text-[hsl(var(--cc-main-black)/0.5)]'
              >
                シェア
              </span>
              <Button
                id='web-share-btn'
                type='button'
                hidden
                variant='outline'
                size='xs'
                shape='pill'
                class='px-4 hover:border-[hsl(var(--cc-main-black)/0.3)] hover:bg-[hsl(var(--cc-gray)/0.3)]'
                aria-label='シェア'
              >
                <Icon
                  name='external-link'
                  class='w-3.5 h-3.5'
                  aria-hidden='true'
                />
                シェアする
              </Button>
              <Button
                href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(title)}`}
                target='_blank'
                rel='noopener noreferrer'
                variant='outline'
                size='xs'
                shape='pill'
                class='hover:border-[hsl(var(--cc-main-black)/0.3)] hover:text-[hsl(var(--cc-main-black)/0.85)] hover:bg-[hsl(var(--cc-gray)/0.3)]'
                aria-label='Xでシェア'
                data-share='x'
              >
                <Icon name='x-twitter' class='w-3.5 h-3.5' aria-hidden='true' />
                X
              </Button>
              <Button
                href={hatenaShareUrl}
                target='_blank'
                rel='noopener noreferrer'
                variant='outline'
                size='xs'
                shape='pill'
                class='hover:border-[hsl(var(--cc-main-black)/0.3)] hover:text-[hsl(var(--cc-main-black)/0.85)] hover:bg-[hsl(var(--cc-gray)/0.3)]'
                aria-label='はてなブックマークに追加'
                data-share='hatena'
              >
                <Icon name='hatena-b' class='w-3.5 h-3.5' aria-hidden='true' />
                はてブ
              </Button>
              <Button
                id='copy-url-btn'
                type='button'
                variant='outline'
                size='xs'
                shape='pill'
                class='hover:border-[hsl(var(--cc-main-black)/0.3)] hover:text-[hsl(var(--cc-main-black)/0.85)] hover:bg-[hsl(var(--cc-gray)/0.3)]'
                aria-label='URLをコピー'
              >
                <Icon
                  name='copy'
                  id='copy-url-icon'
                  class='w-3.5 h-3.5'
                  aria-hidden='true'
                />
                <span id='copy-url-label'>URLをコピー</span>
              </Button>
            </div>
          </section>
        </div>

        {
          toc.length > 0 && (
            <aside class='hidden lg:block'>
              <nav
                aria-label='目次'
                class='sticky top-16 max-h-[calc(100dvh-5rem)] overflow-y-auto'
              >
                <p class='text-xs font-semibold text-[hsl(var(--cc-main-black)/0.5)] uppercase tracking-wide mb-3'>
                  目次
                </p>
                <ul class='space-y-1.5 border-l border-[hsl(var(--cc-gray))]'>
                  {toc.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class={`block border-l-2 border-transparent -ml-px pr-2 text-sm [word-break:auto-phrase] text-[hsl(var(--cc-main-black)/0.6)] hover:border-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-main-orange))] transition-colors ${h.depth === 3 ? 'pl-6' : 'pl-3 font-medium'}`}
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </aside>
          )
        }
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const shareSection = document.getElementById('share-section');
      if (!shareSection) {
        return;
      }

      const title =
        document.querySelector<HTMLHeadingElement>('h1')?.textContent?.trim() ??
        '';
      const slug = location.pathname.split('/').filter(Boolean).pop() ?? '';

      // Web Share API 対応環境では統合ボタンを表示し、個別リンクは隠す
      const webShareBtn = document.getElementById('web-share-btn');
      if (webShareBtn instanceof HTMLButtonElement && 'share' in navigator) {
        const shareData = { title, text: title, url: location.href };
        const canShareData =
          typeof navigator.canShare === 'function'
            ? navigator.canShare(shareData)
            : true;
        if (canShareData) {
          webShareBtn.hidden = false;
          document
            .querySelectorAll<HTMLElement>(
              '#share-section [data-share], #share-section #copy-url-btn',
            )
            .forEach((el) => {
              el.hidden = true;
            });
          webShareBtn.addEventListener('click', async () => {
            try {
              await navigator.share(shareData);
              window.gtag?.('event', 'share_clicked', {
                event_category: 'engagement',
                share_method: 'web_share',
                slug,
              });
            } catch {
              // ユーザーキャンセル等は無視
            }
          });
        }
      }

      // URLコピーボタン
      const btn = document.getElementById('copy-url-btn');
      const label = document.getElementById('copy-url-label');
      const icon = document.getElementById('copy-url-icon');
      if (btn && label && icon) {
        btn.addEventListener('click', async () => {
          await navigator.clipboard.writeText(location.href);
          window.gtag?.('event', 'share_clicked', {
            event_category: 'engagement',
            share_method: 'copy_url',
            slug,
          });
          label.textContent = 'コピーしました';
          icon.innerHTML =
            '<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>';
          setTimeout(() => {
            label.textContent = 'URLをコピー';
            icon.innerHTML =
              '<path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>';
          }, 2000);
        });
      }

      // シェアリンク (X / はてブ)
      document
        .querySelectorAll<HTMLAnchorElement>('#share-section [data-share]')
        .forEach((el) => {
          el.addEventListener('click', () => {
            window.gtag?.('event', 'share_clicked', {
              event_category: 'engagement',
              share_method: el.dataset.share,
              slug,
            });
          });
        });
    });
  </script>
</Layout>
