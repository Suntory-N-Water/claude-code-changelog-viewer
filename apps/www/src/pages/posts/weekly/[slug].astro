---
import { getCollection, render } from 'astro:content';
import { format, parseISO } from 'date-fns';
import { ja } from 'date-fns/locale';
import Icon from '../../../components/Icon.astro';
import PostBody from '../../../components/posts/PostBody.astro';
import PostShare from '../../../components/posts/PostShare.astro';
import PostTocAccordion from '../../../components/posts/PostTocAccordion.astro';
import PostTocSidebar from '../../../components/posts/PostTocSidebar.astro';
import BackLink from '../../../components/ui/BackLink.astro';
import Badge from '../../../components/ui/Badge.astro';
import Layout from '../../../layouts/Layout.astro';
import { SITE_TITLE } from '../../../lib/constants';
import { semverCompareDesc } from '../../../lib/semver';

export async function getStaticPaths() {
  const posts = await getCollection('postsWeekly');

  return posts.map((entry) => ({
    params: { slug: entry.id.replace(/^weekly\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const { title, description, date, period_start, period_end, versions } =
  entry.data;

const slug = entry.id.replace(/^weekly\//, '');
const formattedDate = format(parseISO(date), 'yyyy年M月d日', { locale: ja });
const period = `${format(parseISO(period_start), 'yyyy年M月d日')}〜${format(parseISO(period_end), 'M月d日')}`;

// frontmatter の description を優先し、未記入なら期間から自動生成する
const metaDescription =
  description ||
  `${period} の Claude Code アップデートから注目の変更をピックアップして解説します。`;

// ## / ### のみを目次対象にする
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// バージョンは新しい順に並べて changelog へリンクする
const sortedVersions = [...versions].sort(semverCompareDesc);

const baseUrl = Astro.site?.href ?? '/';
const shareUrl = new URL(`posts/weekly/${slug}`, baseUrl).href;
---

<Layout
  title={`${title} - ${SITE_TITLE}`}
  description={metaDescription}
  jsonLd={{ type: 'article', datePublished: date }}
  breadcrumbs={[
    { name: 'ホーム', url: baseUrl },
    { name: '週次まとめ', url: `${baseUrl}posts/weekly` },
    { name: title, url: shareUrl },
  ]}
>
  <div class='min-h-dvh py-8 sm:py-12 px-4'>
    <div class='max-w-6xl mx-auto'>
      <div class='mb-6'>
        <BackLink href='/posts/weekly'>週次まとめ一覧に戻る</BackLink>
      </div>

      <header class='mb-8 max-w-3xl'>
        <h1
          class='text-2xl sm:text-3xl font-bold tracking-tight text-balance [word-break:auto-phrase] text-[hsl(var(--cc-main-black))] mb-3'
        >
          {title}
        </h1>
        <div
          class='flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[hsl(var(--cc-main-black)/0.55)] tabular-nums'
        >
          <span
            >投稿日 <time datetime={date} class='font-medium'
              >{formattedDate}</time
            ></span
          >
          <span aria-hidden='true'>·</span>
          <span>対象期間 {period}</span>
        </div>
      </header>

      <div class='lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-10'>
        <div class='min-w-0 max-w-3xl'>
          {
            toc.length > 0 && (
              <PostTocAccordion headings={toc} class='lg:hidden mb-6' />
            )
          }

          <PostBody>
            <Content />
          </PostBody>

          {
            sortedVersions.length > 0 && (
              <section
                class='mt-12 pt-6 border-t border-[hsl(var(--cc-gray))]'
                aria-labelledby='related-versions'
              >
                <h2
                  id='related-versions'
                  class='text-sm font-semibold text-[hsl(var(--cc-main-black)/0.6)] uppercase tracking-wide mb-3'
                >
                  この記事で扱ったバージョン
                </h2>
                <ul class='flex flex-wrap gap-2'>
                  {sortedVersions.map((version) => (
                    <li>
                      <Badge
                        href={`/changelog/v${version}`}
                        variant='outline'
                        class='gap-1 px-3 py-1 text-sm font-medium tabular-nums hover:border-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-main-orange))] transition-colors'
                      >
                        v{version}
                        <Icon
                          name='chevron-right'
                          class='w-3.5 h-3.5'
                          aria-hidden='true'
                        />
                      </Badge>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <PostShare shareUrl={shareUrl} title={title} class='mt-8' />
        </div>

        {toc.length > 0 && <PostTocSidebar headings={toc} />}
      </div>
    </div>
  </div>
</Layout>
