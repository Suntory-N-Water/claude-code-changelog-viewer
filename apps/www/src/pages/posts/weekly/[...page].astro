---
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import { format, parseISO } from 'date-fns';
import { ja } from 'date-fns/locale';
import PostArchive from '../../../components/posts/PostArchive.astro';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection('postsWeekly')).sort((a, b) =>
    b.data.date.localeCompare(a.data.date),
  );

  const articles = posts.map((entry) => {
    const period = `${format(parseISO(entry.data.period_start), 'M月d日')}〜${format(parseISO(entry.data.period_end), 'M月d日')}`;
    return {
      slug: entry.id.replace(/^weekly\//, ''),
      title: entry.data.title,
      date: entry.data.date,
      formattedDate: format(parseISO(entry.data.date), 'yyyy年M月d日', {
        locale: ja,
      }),
      description:
        entry.data.description ||
        `${period} の Claude Code アップデートから注目の変更をピックアップして解説します。`,
    };
  });

  return paginate(articles, { pageSize: 10 });
}

type Article = {
  slug: string;
  title: string;
  date: string;
  formattedDate: string;
  description: string;
};

type Props = {
  page: {
    data: Article[];
    currentPage: number;
    lastPage: number;
    url: { first?: string; prev?: string; next?: string };
  };
};

const { page } = Astro.props;

const pageNum = page.currentPage > 1 ? ` (${page.currentPage}ページ目)` : '';
const pageTitle = `週次まとめ${pageNum}`;
const pageDescription =
  'Claude Code の 1 週間分のアップデートから、注目の変更をピックアップして日本語で解説する週次まとめ記事の一覧です。';
---

<Layout
  title={`${pageTitle} - CCログ超訳: Claude Codeの変更履歴`}
  description={pageDescription}
  jsonLd={{
    type: 'collection',
    title: '週次まとめ',
    description: 'Claude Code 週次アップデートまとめ記事一覧',
  }}
  breadcrumbs={[
    { name: 'ホーム', url: 'https://claude-code-log.com/' },
    { name: '週次まとめ', url: 'https://claude-code-log.com/posts/weekly' },
  ]}
>
  <PostArchive
    heading='週次まとめ'
    lead='1 週間分の Claude Code アップデートから、注目の変更をピックアップして解説します。'
    basePath='/posts/weekly'
    articles={page.data}
    page={page}
  />
</Layout>
