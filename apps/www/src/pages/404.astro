---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import { semverCompareDesc } from '../lib/semver';

// ビルド時に全 URL を生成してクライアントサイド JS にインライン埋め込み
const changelogs = await getCollection('changelog');

const changelogUrls = changelogs.map((e) => `/changelog/v${e.data.version}`);

const staticUrls = ['/', '/about', '/notify', '/privacy'];

const allUrls = JSON.stringify([
  ...staticUrls,
  ...changelogUrls.sort((a, b) => {
    const av = a.replace('/changelog/v', '');
    const bv = b.replace('/changelog/v', '');
    return semverCompareDesc(av, bv);
  }),
]);
---

<Layout
  title='ページが見つかりません - CCログ超訳'
  description='お探しのページは存在しないか、移動した可能性があります。'
  jsonLd={{ type: 'page' }}
>
  <div class='max-w-6xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-32'>
    <div class='max-w-2xl'>
      <p class='text-[clamp(5rem,12vw,10rem)] font-bold leading-none tracking-[-0.03em] text-accent-display tabular-nums'>
        404
      </p>
      <h1 class='mt-6 text-[clamp(2rem,2vw+1.25rem,3rem)] text-ink mb-10'>
        ページが見つかりません
      </h1>

      <Card id='suggestions' variant='muted' padding='none' class='hidden mb-10 p-6'>
        <p class='text-sm font-semibold text-ink-2 mb-3'>もしかして</p>
        <ul id='suggestions-list' class='space-y-2'></ul>
      </Card>

      <Button href='/' shape='pill'>
        トップページに戻る
      </Button>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ allUrls }}>
  const urls = JSON.parse(allUrls);

  /** Levenshtein 距離(DP)*/
  function levenshtein(a, b) {
    const m = a.length;
    const n = b.length;
    const dp = Array.from({ length: m + 1 }, (_, i) =>
      Array.from({ length: n + 1 }, (_, j) => (i === 0 ? j : j === 0 ? i : 0)),
    );
    for (let i = 1; i <= m; i += 1) {
      for (let j = 1; j <= n; j += 1) {
        dp[i][j] =
          a[i - 1] === b[j - 1]
            ? dp[i - 1][j - 1]
            : 1 + Math.min(dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 1]);
      }
    }
    return dp[m][n];
  }

  function findCandidates(currentPath, maxResults = 3) {
    const threshold = Math.max(5, Math.floor(currentPath.length * 0.4));
    return urls
      .map((url) => ({ url, dist: levenshtein(currentPath, url) }))
      .filter(({ dist }) => dist <= threshold)
      .sort((a, b) => a.dist - b.dist)
      .slice(0, maxResults);
  }

  function initSuggestions() {
    const suggestionsEl = document.getElementById('suggestions');
    const listEl = document.getElementById('suggestions-list');
    if (!suggestionsEl || !listEl) {
      return;
    }

    listEl.innerHTML = '';
    suggestionsEl.classList.add('hidden');

    const candidates = findCandidates(window.location.pathname);
    if (candidates.length > 0) {
      for (const { url } of candidates) {
        const li = document.createElement('li');
        li.innerHTML = `<a href="${url}" class="text-sm text-[hsl(var(--cc-main-orange))] hover:underline break-all">${url}</a>`;
        listEl.appendChild(li);
      }
      suggestionsEl.classList.remove('hidden');
    }
  }
  initSuggestions();
</script>
