---
import { getCollection } from 'astro:content';
import Icon from '../../../components/Icon.astro';
import ChangelogItemCard from '../../../components/changelog/ChangelogItemCard.astro';
import Layout from '../../../layouts/Layout.astro';
import {
  extractChangelogData,
  getLinkedAreas,
  groupByVersion,
  toFeatureAreaSlug,
  getFeatureAreaLabel,
} from '../../../lib/feature-area';
import {
  formatSettingDescription,
  formatUseCaseJa,
} from '../../../lib/format-changelog-content';
import {
  collectFeatureAreas,
  extractOfficialDocUrls,
  findRelatedChangelogs,
  getSourceLabel,
} from '../../../lib/settings-reference';
import { semverCompareDesc } from '../../../lib/semver';

export async function getStaticPaths() {
  const settings = await getCollection('settingsReference');
  const changelogs = await getCollection('changelog');
  const changelogData = extractChangelogData(changelogs);
  const linkedAreas = getLinkedAreas(changelogData);

  return settings.map((entry) => {
    const relatedItems = findRelatedChangelogs(entry.data.key, changelogData);
    const settingAreas = collectFeatureAreas(relatedItems);
    return {
      params: { slug: entry.data.slug },
      props: { entry: entry.data, relatedItems, linkedAreas, settingAreas },
    };
  });
}

const { entry, relatedItems, linkedAreas, settingAreas } = Astro.props;

const versionGroups = groupByVersion(relatedItems, semverCompareDesc);
const sourceLabel = getSourceLabel(entry.source);
const descriptionJaHtml = formatSettingDescription(entry.description_ja);
const descriptionEnHtml = formatSettingDescription(entry.description_en);
const useCaseHtml = entry.use_case_ja
  ? formatUseCaseJa(entry.use_case_ja)
  : null;
const officialLinks = extractOfficialDocUrls(entry.description_en);

const relatedAreaLinks = [...settingAreas]
  .filter((area) => linkedAreas.has(area))
  .map((area) => ({
    slug: toFeatureAreaSlug(area),
    label: getFeatureAreaLabel(area),
  }));

const displayName = entry.leaf_name ?? entry.key.split('.').at(-1) ?? entry.key;

const siteUrl = import.meta.env.SITE;
const pageTitle = `${displayName} - Claude Code 設定リファレンス`;
const pageDescription = entry.description_ja.slice(0, 120);

const hasContent = useCaseHtml !== null || versionGroups.length > 0;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jsonLd={{ type: 'page' }}
  breadcrumbs={[
    { name: 'トップ', url: siteUrl },
    { name: '設定リファレンス', url: `${siteUrl}/reference/settings` },
    {
      name: displayName,
      url: `${siteUrl}/reference/settings/${entry.slug}`,
    },
  ]}
>
  <div class='min-h-dvh py-12 sm:py-16 px-4' data-pagefind-body>
    <div class='max-w-4xl mx-auto'>
      <nav class='mb-8' aria-label='パンくずリスト' data-pagefind-ignore>
        <a
          href='/reference/settings'
          data-direction='back'
          class='text-sm text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline inline-flex items-center gap-1 transition-colors'
        >
          <Icon name='arrow-left' class='w-4 h-4' aria-hidden='true' />
          設定リファレンス一覧に戻る
        </a>
      </nav>

      <header class='mb-8'>
        <div class='mb-2'>
          <span
            class='inline-block px-2.5 py-1 rounded-full text-xs font-medium bg-[hsl(var(--cc-gray)/0.5)] text-[hsl(var(--cc-main-black)/0.7)]'
          >
            {sourceLabel}
          </span>
        </div>
        <h1
          class='text-2xl sm:text-3xl font-bold font-mono break-all text-[hsl(var(--cc-main-black))] mb-4'
        >
          {displayName}
        </h1>
        <p
          class='text-base leading-relaxed text-[hsl(var(--cc-main-black))] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-[hsl(var(--cc-gray))] [&_code]:text-sm [&_code]:font-mono'
          set:html={descriptionJaHtml}
        />
      </header>

      {
        useCaseHtml && (
          <section class='mb-8 p-5 rounded-xl bg-[hsl(var(--cc-main-orange)/0.05)] border border-[hsl(var(--cc-main-orange)/0.2)]'>
            <h2 class='text-base font-bold text-[hsl(var(--cc-main-black))] mb-3'>
              使い方・用途
            </h2>
            <div
              class='text-sm leading-relaxed text-[hsl(var(--cc-main-black))] space-y-1'
              set:html={useCaseHtml}
            />
          </section>
        )
      }

      <!-- 英語原文(公式ドキュメントより) -->
      <section
        class='mb-8 p-4 rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-gray)/0.15)]'
      >
        <div class='flex items-center gap-2 mb-2'>
          <Icon
            name='clipboard-doc'
            class='w-3.5 h-3.5 text-gray-400 shrink-0'
            aria-hidden='true'
          />
          <span class='text-xs font-medium text-gray-400'
            >英語原文(公式ドキュメントより)</span
          >
        </div>
        <p
          class='text-sm text-gray-600 leading-relaxed'
          set:html={descriptionEnHtml}
        />
        {
          officialLinks.length > 0 && (
            <div class='mt-3 flex flex-wrap gap-2'>
              {officialLinks.map(({ label, url }) => (
                <a
                  href={url}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='inline-flex items-center gap-1 text-xs text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline transition-colors'
                >
                  {label}
                  <Icon
                    name='external-link'
                    class='w-3 h-3 opacity-70'
                    aria-hidden='true'
                  />
                </a>
              ))}
            </div>
          )
        }
      </section>

      {
        versionGroups.length > 0 && (
          <section class='mb-8'>
            <h2 class='text-lg font-bold text-[hsl(var(--cc-main-black))] mb-6'>
              関連する変更履歴
            </h2>
            <div data-pagefind-ignore class='space-y-10'>
              {versionGroups.map((group) => (
                <div>
                  <div class='sticky top-12 z-10 bg-[hsl(var(--cc-main-white)/0.95)] backdrop-blur-sm py-3 -mx-4 px-4 mb-4 border-b border-[hsl(var(--cc-gray)/0.3)]'>
                    <h3 class='flex items-center gap-2 text-base font-bold text-[hsl(var(--cc-main-black))]'>
                      <a
                        href={`/changelog/v${group.version}`}
                        class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline transition-colors'
                      >
                        v{group.version}
                      </a>
                      <span class='text-sm font-normal text-gray-500 tabular-nums'>
                        ({group.items.length}件)
                      </span>
                    </h3>
                  </div>
                  <div class='space-y-6'>
                    {group.items.map((item) => (
                      <ChangelogItemCard
                        item={item}
                        linkedAreas={linkedAreas}
                      />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- 情報が少ないページ向けの補足 -->
      {
        !hasContent && (
          <section class='mb-8 py-10 text-center border border-dashed border-[hsl(var(--cc-gray))] rounded-xl'>
            <p class='text-sm text-gray-400'>
              まだ変更履歴との関連付けはありません
            </p>
          </section>
        )
      }

      {
        relatedAreaLinks.length > 0 && (
          <nav
            class='mt-8 pt-8 border-t border-[hsl(var(--cc-gray))]'
            data-pagefind-ignore
          >
            <h2 class='text-base font-bold text-[hsl(var(--cc-main-black))] mb-3'>
              関連する機能エリア
            </h2>
            <div class='flex flex-wrap gap-3'>
              {relatedAreaLinks.map(({ slug, label }) => (
                <a
                  href={`/features/${slug}`}
                  class='inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[hsl(var(--cc-gray))] hover:border-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-main-orange))] transition-[border-color,color,transform] active:scale-[0.96]'
                >
                  {label}
                </a>
              ))}
            </div>
          </nav>
        )
      }
    </div>
  </div>
</Layout>
