---
import { getCollection } from 'astro:content';
import VersionCard from '../components/changelog/VersionCard.astro';
import Layout from '../layouts/Layout.astro';

// Content Collectionsから全バージョンを取得
const allChangelogs = await getCollection('changelog');

// バージョン番号で降順ソート(セマンティックバージョニング対応)
const sortedChangelogs = allChangelogs.sort((a, b) => {
  // data.versionを使用(例: "2.1.27")
  const versionA = a.data.version;
  const versionB = b.data.version;

  const aParts = versionA.split('.').map(Number);
  const bParts = versionB.split('.').map(Number);

  // メジャー、マイナー、パッチの順で比較
  for (let i = 0; i < Math.max(aParts.length, bParts.length); i++) {
    const diff = (bParts[i] || 0) - (aParts[i] || 0);
    if (diff !== 0) {
      return diff;
    }
  }
  return 0;
});

const versionData = sortedChangelogs.map((entry) => ({
  version: entry.data.version,
  itemCount: entry.data.items.length,
}));

// v2.1.0 以降と以前で分割
const CUTOFF_VERSION = [2, 1, 0];

function isRecentVersion(version: string): boolean {
  const parts = version.split('.').map(Number);
  for (let i = 0; i < 3; i++) {
    const diff = (parts[i] || 0) - (CUTOFF_VERSION[i] || 0);
    if (diff !== 0) {
      return diff > 0;
    }
  }
  return true; // v2.1.0 自体は「以降」に含める
}

const recentVersions = versionData.filter((v) => isRecentVersion(v.version));
const olderVersions = versionData.filter((v) => !isRecentVersion(v.version));
---

<Layout
  title='Claude Code Changelog Viewer - AIによる変更履歴の分析と解説'
  description='Claude Codeの全バージョンの変更履歴をAIが分析し、各アップデートの内容とユーザーへの恩恵を日本語で分かりやすく解説するWebサイトです。'
>
  <div class='min-h-dvh py-12 sm:py-16 px-4'>
    <div class='max-w-6xl mx-auto'>
      <header class='mb-12 sm:mb-16 text-center max-w-2xl mx-auto'>
        <h1
          class='text-3xl sm:text-4xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-3'
        >
          Claude Code Changelog Viewer
        </h1>
        <p
          class='text-base sm:text-lg text-pretty text-gray-600 leading-relaxed'
        >
          Claude Codeの更新内容をAIが分析し、ユーザーへの恩恵を分かりやすく解説
        </p>
      </header>

      <div
        class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6'
      >
        {
          recentVersions.map(({ version, itemCount }) => (
            <VersionCard version={version} itemCount={itemCount} />
          ))
        }
      </div>

      {
        olderVersions.length > 0 && (
          <>
            <div id='show-older-wrapper' class='mt-8 text-center'>
              <button
                id='show-older-btn'
                type='button'
                class='inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-[hsl(var(--cc-gray))] text-[hsl(var(--cc-main-black))] hover:border-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-main-orange))] transition-colors'
              >
                過去のバージョンを表示({olderVersions.length}件)
                <svg
                  class='w-4 h-4'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'
                  aria-hidden='true'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M19 9l-7 7-7-7'
                  />
                </svg>
              </button>
            </div>

            <template id='older-versions-template'>
              {olderVersions.map(({ version, itemCount }) => (
                <VersionCard version={version} itemCount={itemCount} />
              ))}
            </template>
          </>
        )
      }
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const btn = document.getElementById('show-older-btn');
      const wrapper = document.getElementById('show-older-wrapper');
      if (!btn || !wrapper) {
        return;
      }

      btn.addEventListener('click', () => {
        const template = document.getElementById(
          'older-versions-template',
        ) as HTMLTemplateElement | null;
        if (!template) {
          return;
        }

        const container = document.createElement('div');
        container.className =
          'mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6';
        container.appendChild(template.content.cloneNode(true));
        wrapper.insertAdjacentElement('afterend', container);
        wrapper.remove();
      });
    });
  </script>
</Layout>
