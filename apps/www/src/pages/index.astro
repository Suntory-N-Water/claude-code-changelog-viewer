---
import { TZDate } from '@date-fns/tz';
import { getCollection } from 'astro:content';
import { format, parseISO } from 'date-fns';
import Icon from '../components/Icon.astro';
import VersionCard from '../components/changelog/VersionCard.astro';
import Button from '../components/ui/Button.astro';
import Accordion from '../components/ui/Accordion.astro';
import Layout from '../layouts/Layout.astro';
import { buildDiffMap, buildVersionData } from '../lib/changelog-diff';
import { SITE_TITLE } from '../lib/constants';
import { getPrefixSortOrder, PREFIX_LABELS, type Prefix } from '../lib/prefix';
import { getReleaseMap } from '../lib/release-map';
import { semverCompareDesc } from '../lib/semver';

const sortedChangelogs = await getCollection('changelog');
sortedChangelogs.sort((a, b) => semverCompareDesc(a.data.version, b.data.version));

const diffEntries = await getCollection('diff');
const diffMap = buildDiffMap(diffEntries);

const versionData = buildVersionData(sortedChangelogs, diffMap);

const TOP_PAGE_SIZE = 9;
const initialVersions = versionData.slice(0, TOP_PAGE_SIZE);
const remainingCount = versionData.length - TOP_PAGE_SIZE;

const releaseMap = await getReleaseMap();
const formatReleaseDate = (version: string, pattern: string) => {
  const releasedAt = releaseMap.get(version);
  return releasedAt ? format(new TZDate(releasedAt, 'Asia/Tokyo'), pattern) : undefined;
};

const latestColumn = (await getCollection('column')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
)[0];

const latestEntry = sortedChangelogs[0];
const latestVersion = latestEntry.data.version;
const latestReleaseDate = formatReleaseDate(latestVersion, 'yyyy年M月d日');
if (latestReleaseDate === undefined) {
  throw new Error(`Claude Code最新版 v${latestVersion} のリリース日を取得できませんでした`);
}
const latestVersionLabel = `v${latestVersion}(${latestReleaseDate}リリース)`;
const pageTitle = `Claude Code最新版 v${latestVersion} - ${SITE_TITLE}`;
const pageDescription = `Claude Codeの最新版は${latestVersionLabel}です。公式 CHANGELOG の変更履歴を AI が日本語で解説します。`;

const prefixCounts = new Map<string, number>();
for (const item of latestEntry.data.items) {
  prefixCounts.set(item.prefix, (prefixCounts.get(item.prefix) ?? 0) + 1);
}
const latestBreakdown = [...prefixCounts.entries()]
  .sort(([a], [b]) => getPrefixSortOrder(a) - getPrefixSortOrder(b))
  .map(([prefix, count]) => ({
    prefix,
    label: PREFIX_LABELS[prefix as Prefix] ?? prefix,
    count,
  }));

const faqItems = [
  {
    question: 'Claude Codeとは何ですか？',
    answer:
      'Claude Codeは、Anthropic社が提供するCLIベースのAIコーディングアシスタントです。ターミナルから直接Claudeを呼び出し、コードの生成・レビュー・リファクタリング・デバッグなどを行えます。',
  },
  {
    question: 'このサイトの更新頻度は？',
    answer:
      '公式 CHANGELOG の更新から1時間以内に反映します。',
  },
  {
    question: '公式との違いは？',
    answer:
      '公式 CHANGELOG を AI が日本語に訳した非公式サイトです。訳と解説には誤りが含まれることがあります。',
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jsonLd={{ type: 'website' }}
  faqItems={faqItems}
>
  <div class='max-w-6xl mx-auto px-4 sm:px-6'>
    <section
      class='grid lg:grid-cols-12 gap-x-8 gap-y-12 pt-12 sm:pt-16 pb-16 sm:pb-20 items-end'
      aria-labelledby='hero-title'
    >
      <div class='lg:col-span-7 @container min-w-0'>
        <p class='text-sm text-muted'>
          <time>{latestReleaseDate}</time> リリースの最新版
        </p>
        <a
          href={`/changelog/v${latestVersion}`}
          class='hero-version mt-2 block w-fit font-bold tabular-nums leading-[0.95] tracking-[-0.03em] text-accent-display hover:text-accent-text transition-colors rounded-md'
        >
          v{latestVersion}
        </a>
        <h1 id='hero-title' class='mt-8 sm:mt-10 max-w-[18ch] text-section text-ink'>
          Claude Code の変更履歴を、日本語で読む
        </h1>
        <div class='flex flex-wrap items-center gap-3 mt-8'>
          <Button href={`/changelog/v${latestVersion}`} shape='pill'>
            v{latestVersion} を読む
          </Button>
          <Button href='/notify' variant='outline' shape='pill'>
            <Icon name='bell' class='w-4 h-4' />
            更新通知を受け取る
          </Button>
        </div>
      </div>

      <aside
        class='lg:col-span-5 lg:col-start-8 min-w-0 rounded-xl bg-paper-2 p-6 sm:p-8'
        aria-labelledby='latest-breakdown'
      >
        <h2 id='latest-breakdown' class='font-sans text-base font-semibold text-ink'>
          v{latestVersion} の変更内訳
        </h2>
        <dl class='mt-5 border-b border-rule-2'>
          {latestBreakdown.map(({ prefix, label, count }) => (
            <div class='flex items-baseline justify-between gap-3 border-t border-rule-2 py-2.5'>
              <dt class='text-sm text-ink-2'>
                <a
                  href={`/changelog/v${latestVersion}#prefix-${prefix.toLowerCase()}`}
                  class='underline-offset-4 hover:underline hover:text-ink'
                >
                  {label}
                </a>
              </dt>
              <dd class='text-lg font-semibold tabular-nums text-ink'>{count}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </section>

    <section class='pb-24 sm:pb-32' aria-labelledby='recent-versions'>
      <div class='flex flex-wrap items-end justify-between gap-4 mb-6'>
        <h2 id='recent-versions' class='text-section text-ink'>
          最近のバージョン
        </h2>
        <a
          href='/changelog'
          class='inline-flex items-center gap-1 min-h-10 text-sm text-accent-text underline-offset-4 hover:underline'
        >
          全{versionData.length}バージョンの一覧
          <Icon name='chevron-right' class='w-4 h-4' />
        </a>
      </div>
      <ol id='versions-grid'>
        {initialVersions.map(({ version, itemCount, summary, diffStatus }) => (
          <VersionCard
            version={version}
            itemCount={itemCount}
            summary={summary}
            diffStatus={diffStatus}
            releaseDate={formatReleaseDate(version, 'yyyy/MM/dd')}
          />
        ))}
      </ol>
      {remainingCount > 0 && (
        <div class='mt-8'>
          <Button href='/changelog' variant='outline' shape='pill'>
            以前のバージョンを見る(他{remainingCount}件)
          </Button>
        </div>
      )}
    </section>
  </div>

  {latestColumn && (
    <section class='max-w-6xl mx-auto px-4 sm:px-6' aria-labelledby='latest-column'>
      <div class='grid lg:grid-cols-12 gap-x-8 gap-y-6'>
        <div class='lg:col-span-4'>
          <h2 id='latest-column' class='text-section text-ink'>
            コラム
          </h2>
          <a
            href='/posts/column'
            class='mt-3 inline-flex items-center gap-1 min-h-10 text-sm text-accent-text underline-offset-4 hover:underline'
          >
            コラムの一覧
            <Icon name='chevron-right' class='w-4 h-4' />
          </a>
        </div>
        <a
          href={`/posts/column/${latestColumn.data.slug}`}
          class='group lg:col-span-8 block border-t-2 border-ink pt-6'
        >
          <time class='text-sm text-muted tabular-nums'>
            {format(parseISO(latestColumn.data.date), 'yyyy年M月d日')}
          </time>
          <h3 class='mt-3 text-2xl sm:text-3xl font-bold leading-snug text-ink [word-break:auto-phrase] group-hover:text-accent-text transition-colors'>
            {latestColumn.data.title}
          </h3>
          <p class='mt-4 max-w-[60ch] text-base leading-relaxed text-ink-2'>
            {latestColumn.data.description}
          </p>
        </a>
      </div>
    </section>
  )}

  <section class='max-w-6xl mx-auto px-4 sm:px-6 py-24 sm:py-32' aria-labelledby='faq'>
    <div class='grid lg:grid-cols-12 gap-x-8 gap-y-8'>
      <h2 id='faq' class='lg:col-span-4 text-section text-ink'>
        よくある質問
      </h2>
      <div class='lg:col-span-8 border-t border-rule'>
        {faqItems.map(({ question, answer }) => (
          <Accordion variant='plain' class='details-animated group'>
            <summary class='flex items-center justify-between gap-4 py-5 min-h-11 cursor-pointer list-none text-base font-semibold text-ink [&::-webkit-details-marker]:hidden'>
              {question}
              <Icon
                name='plus'
                class='w-5 h-5 shrink-0 text-muted group-open:rotate-45 transition-transform duration-(--dur-short)'
              />
            </summary>
            <p class='pb-6 max-w-[60ch] text-[15px] leading-relaxed text-ink-2'>{answer}</p>
          </Accordion>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-version {
    font-size: min(var(--text-display), 16cqi);
  }
</style>
