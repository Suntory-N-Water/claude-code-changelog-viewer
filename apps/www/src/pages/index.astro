---
import { getCollection } from 'astro:content';
import { format, parseISO } from 'date-fns';
import Icon from '../components/Icon.astro';
import VersionCard from '../components/changelog/VersionCard.astro';
import Button from '../components/ui/Button.astro';
import Accordion from '../components/ui/Accordion.astro';
import Layout from '../layouts/Layout.astro';
import { buildDiffMap, buildVersionData } from '../lib/changelog-diff';
import type { IconName } from '../lib/icons';
import { SITE_TITLE } from '../lib/constants';
import {
  aggregateByFeatureArea,
  extractChangelogData,
  getFeatureAreaLabel,
  MIN_ITEMS_FOR_PAGE,
  toFeatureAreaSlug,
} from '../lib/feature-area';
import { semverCompareDesc } from '../lib/semver';

const sortedChangelogs = await getCollection('changelog');
sortedChangelogs.sort((a, b) =>
  semverCompareDesc(a.data.version, b.data.version),
);

// 差分データ読み込み
const diffEntries = await getCollection('diff');
const diffMap = buildDiffMap(diffEntries);

const versionData = buildVersionData(sortedChangelogs, diffMap);

// トップページは最新30件のみ表示、残りは /changelog へ
const TOP_PAGE_SIZE = 9;
const initialVersions = versionData.slice(0, TOP_PAGE_SIZE);
const remainingCount = versionData.length - TOP_PAGE_SIZE;

// 「読みもの」セクションの導線カード。記事が 1 本もないセクションは出さない
type ReadingCard = {
  kind: string;
  icon: IconName;
  meta: string;
  href: string;
  title: string;
  description: string;
  archiveHref: string;
  archiveLabel: string;
};

const latestWeekly = (await getCollection('postsWeekly')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
)[0];
const latestColumn = (await getCollection('column')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
)[0];

const readingCards: ReadingCard[] = [];
if (latestWeekly) {
  readingCards.push({
    kind: 'Weekly',
    icon: 'newspaper',
    meta: `${format(parseISO(latestWeekly.data.period_start), 'M月d日')}〜${format(parseISO(latestWeekly.data.period_end), 'M月d日')}`,
    href: `/posts/weekly/${latestWeekly.id.split('/').pop()}`,
    title: latestWeekly.data.title,
    description: latestWeekly.data.description ?? '',
    archiveHref: '/posts/weekly',
    archiveLabel: '週次まとめの一覧',
  });
}
if (latestColumn) {
  readingCards.push({
    kind: 'Column',
    icon: 'pencil-square',
    meta: format(parseISO(latestColumn.data.date), 'yyyy年M月d日'),
    href: `/posts/column/${latestColumn.data.slug}`,
    title: latestColumn.data.title,
    description: latestColumn.data.description,
    archiveHref: '/posts/column',
    archiveLabel: 'コラムの一覧',
  });
}

const latestVersion = sortedChangelogs[0].data.version;
const totalVersions = sortedChangelogs.length;
const totalChanges = sortedChangelogs.reduce(
  (sum, entry) => sum + entry.data.items.length,
  0,
);

const faqItems = [
  {
    question: 'Claude Codeとは何ですか？',
    answer:
      'Claude Codeは、Anthropic社が提供するCLIベースのAIコーディングアシスタントです。ターミナルから直接Claudeを呼び出し、コードの生成・レビュー・リファクタリング・デバッグなどを行えます。',
  },
  {
    question: 'このサイトの更新頻度は？',
    answer:
      'Claude Codeの公式changelog.mdの更新を毎時チェックで自動検出し、新バージョンが見つかるとAIによる分析結果を生成・反映しています。',
  },
  {
    question: '公式との違いは？',
    answer:
      '公式のchangelog.mdをAIが日本語で要約・分析した非公式サイトです。AI生成のため内容が不正確な場合があります。正確な情報は公式リリースノートをご確認ください。',
  },
];
// 機能エリアセクション用データ
const areaMap = aggregateByFeatureArea(extractChangelogData(sortedChangelogs));
const topAreas = [...areaMap.entries()]
  .filter(([, items]) => items.length >= MIN_ITEMS_FOR_PAGE)
  .sort(([, a], [, b]) => b.length - a.length)
  .slice(0, 8)
  .map(([area, items]) => ({
    slug: toFeatureAreaSlug(area),
    label: getFeatureAreaLabel(area),
    itemCount: items.length,
  }));
---

<Layout
  title='CCログ超訳: Claude Codeの変更履歴をAIが日本語解説'
  description='Claude Code(Anthropic公式CLIツール)の変更履歴。Skills・Hooks・MCP・Memoryなど機能別にアップデート内容を絞り込み、AIが新機能・バグ修正・改善点を日本語で解説します。'
  jsonLd={{ type: 'website' }}
  faqItems={faqItems}
>
  <div class='min-h-dvh py-12 sm:py-16 px-4'>
    <div class='max-w-6xl mx-auto'>
      <header class='mb-16 sm:mb-20 max-w-4xl'>
        <div
          class='flex flex-wrap items-end gap-x-6 gap-y-3 border-b border-[hsl(var(--cc-gray))] pb-6 mb-8'
        >
          <a
            href={`/changelog/v${latestVersion}`}
            class='font-mono text-5xl sm:text-6xl lg:text-7xl font-bold tabular-nums leading-none tracking-tight text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[hsl(var(--cc-main-orange))]'
            style={`view-transition-name: version-title-${latestVersion}`}
          >
            v{latestVersion}
          </a>
          <dl
            class='font-mono text-xs text-[hsl(var(--cc-main-black)/0.55)] flex flex-col gap-1 pb-1'
          >
            <div class='flex items-center gap-2'>
              <dt class='tabular-nums text-[hsl(var(--cc-main-black))]'>
                {new Intl.NumberFormat('ja-JP').format(totalVersions)}
              </dt>
              <dd>versions tracked</dd>
            </div>
            <div class='flex items-center gap-2'>
              <dt class='tabular-nums text-[hsl(var(--cc-main-black))]'>
                {new Intl.NumberFormat('ja-JP').format(totalChanges)}
              </dt>
              <dd>changes summarized</dd>
            </div>
          </dl>
        </div>
        <h1
          class='text-3xl sm:text-4xl font-bold text-balance tracking-tight text-[hsl(var(--cc-main-black))] mb-3'
        >
          {SITE_TITLE}
        </h1>
        <p class='text-base sm:text-lg text-gray-600 leading-relaxed max-w-2xl'>
          公式 CHANGELOG を毎時取り込み、Skills・Hooks・MCP
          など機能別に追跡。日本語サマリーと変更前後の比較を AI が生成します。
        </p>
        <div class='flex flex-wrap items-center gap-3 mt-7'>
          <Button href={`/changelog/v${latestVersion}`} shape='pill'>
            最新版を読む
            <Icon name='chevron-right' class='w-4 h-4' aria-hidden='true' />
          </Button>
          <Button href='/notify' variant='outline' shape='pill'>
            <Icon name='bell' class='w-4 h-4' aria-hidden='true' />
            更新通知を受け取る
          </Button>
        </div>
      </header>

      <section>
        <div
          class='flex items-baseline justify-between gap-4 mb-6 border-t border-[hsl(var(--cc-gray))] pt-8'
        >
          <div>
            <h2
              class='text-2xl font-bold tracking-tight text-[hsl(var(--cc-main-black))]'
            >
              最近のバージョン
            </h2>
          </div>
          <a
            href='/changelog'
            class='hidden sm:inline-flex items-center gap-1 font-mono text-xs text-[hsl(var(--cc-main-black)/0.55)] hover:text-[hsl(var(--cc-main-orange))] transition-colors'
          >
            すべて表示
            <Icon name='chevron-right' class='w-3 h-3' aria-hidden='true' />
          </a>
        </div>
        <div
          id='versions-grid'
          class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6'
        >
          {
            initialVersions.map(
              ({ version, itemCount, summary, diffStatus }) => (
                <VersionCard
                  version={version}
                  itemCount={itemCount}
                  summary={summary}
                  diffStatus={diffStatus}
                />
              ),
            )
          }
        </div>

        {
          remainingCount > 0 && (
            <div class='mt-8 text-center'>
              <Button
                href='/changelog'
                variant='outline'
                size='lg'
                class='text-[hsl(var(--cc-main-black))]'
              >
                全バージョン一覧を見る(他{remainingCount}件)
                <Icon name='chevron-right' class='w-4 h-4' aria-hidden='true' />
              </Button>
            </div>
          )
        }
      </section>

      {
        readingCards.length > 0 && (
          <section class='mt-20 max-w-4xl mx-auto'>
            <h2 class='text-2xl font-bold tracking-tight text-balance text-[hsl(var(--cc-main-black))] mb-3'>
              読みもの
            </h2>
            <p class='text-sm text-gray-600 mb-6 leading-relaxed'>
              1 週間分のアップデートをまとめた週次記事と、Claude Code
              の使い方や運用で得た知見を書いたコラムです。
            </p>
            <div
              class:list={[
                'grid gap-4',
                readingCards.length > 1 && 'sm:grid-cols-2',
              ]}
            >
              {readingCards.map((card) => (
                <a
                  href={card.href}
                  class='group flex flex-col rounded-lg border border-[hsl(var(--cc-gray))] p-5 hover:border-[hsl(var(--cc-main-orange))] transition-[border-color,transform] active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--cc-main-orange))]'
                >
                  <div class='flex items-center gap-2.5 mb-2 font-mono text-[11px] tabular-nums text-[hsl(var(--cc-main-black)/0.6)]'>
                    <span class='inline-flex items-center gap-1 font-bold uppercase tracking-widest'>
                      <Icon
                        name={card.icon}
                        class='w-3.5 h-3.5'
                        aria-hidden='true'
                      />
                      {card.kind}
                    </span>
                    <span>{card.meta}</span>
                  </div>
                  <h3 class='text-base sm:text-lg font-bold [word-break:auto-phrase] text-[hsl(var(--cc-main-black))] group-hover:text-[hsl(var(--cc-main-orange))] transition-colors mb-1.5 leading-snug'>
                    {card.title}
                  </h3>
                  <p class='text-sm text-[hsl(var(--cc-main-black)/0.6)] leading-relaxed line-clamp-2'>
                    {card.description}
                  </p>
                </a>
              ))}
            </div>
            <div class='mt-5 flex flex-wrap gap-x-6'>
              {readingCards.map((card) => (
                <a
                  href={card.archiveHref}
                  class='inline-flex items-center gap-1 min-h-11 font-mono text-xs text-[hsl(var(--cc-main-black)/0.6)] hover:text-[hsl(var(--cc-main-orange))] transition-colors rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--cc-main-orange))]'
                >
                  {card.archiveLabel}
                  <Icon
                    name='chevron-right'
                    class='w-3 h-3'
                    aria-hidden='true'
                  />
                </a>
              ))}
            </div>
          </section>
        )
      }

      <section class='mt-20 max-w-4xl mx-auto'>
        <h2
          class='text-2xl font-bold tracking-tight text-balance text-[hsl(var(--cc-main-black))] mb-3'
        >
          機能で絞り込む
        </h2>
        <p class='text-sm text-gray-600 mb-6 leading-relaxed'>
          Skills・Hooks・MCP
          など、特定の機能領域に関する変更だけをバージョン横断で読みます。
        </p>
        <div class='flex flex-wrap gap-2.5'>
          {
            topAreas.map(({ slug, label, itemCount }) => (
              <Button href={`/features/${slug}`} variant='outline' size='sm'>
                {label}
                <span class='font-mono text-[11px] text-gray-400 tabular-nums'>
                  {itemCount}
                </span>
              </Button>
            ))
          }
          <a
            href='/features'
            class='inline-flex items-center px-3 py-2 text-sm text-gray-500 hover:text-[hsl(var(--cc-main-orange))] transition-colors'
          >
            すべて見る &rarr;
          </a>
        </div>
      </section>

      <section class='mt-20 max-w-4xl mx-auto'>
        <h2
          class='text-2xl font-bold tracking-tight text-balance text-[hsl(var(--cc-main-black))] mb-8'
        >
          よくある質問
        </h2>
        <div class='faq-list space-y-4'>
          {
            faqItems.map(({ question, answer }) => (
              <Accordion
                variant='plain'
                class='details-animated p-5 group open:border-[hsl(var(--cc-main-orange)/0.4)]'
              >
                <summary class='font-medium cursor-pointer list-none flex items-center justify-between'>
                  {question}
                  <Icon
                    name='chevron-down'
                    class='w-4 h-4 text-gray-400 group-open:rotate-180 transition-transform shrink-0'
                    aria-hidden='true'
                  />
                </summary>
                <p class='mt-3 text-sm text-gray-600 leading-relaxed'>
                  {answer}
                </p>
              </Accordion>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>
