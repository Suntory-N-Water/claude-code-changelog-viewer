---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import VersionCard from '../components/changelog/VersionCard.astro';

// Content Collectionsから全バージョンを取得
const allChangelogs = await getCollection('changelog');

// バージョン番号で降順ソート(セマンティックバージョニング対応)
const sortedChangelogs = allChangelogs.sort((a, b) => {
  // data.versionを使用(例: "2.1.27")
  const versionA = a.data.version;
  const versionB = b.data.version;

  const aParts = versionA.split('.').map(Number);
  const bParts = versionB.split('.').map(Number);

  // メジャー、マイナー、パッチの順で比較
  for (let i = 0; i < Math.max(aParts.length, bParts.length); i++) {
    const diff = (bParts[i] || 0) - (aParts[i] || 0);
    if (diff !== 0) return diff;
  }
  return 0;
});

const versionData = sortedChangelogs.map((entry) => ({
  version: entry.data.version,
  itemCount: entry.data.items.length,
}));
---

<Layout
  title='Claude Code Changelog Viewer'
  description='Claude Codeの変更履歴をAIが分析した結果を表示'
>
  <div class='min-h-dvh py-12 sm:py-16 px-4'>
    <div class='max-w-6xl mx-auto'>
      <header class='mb-12 sm:mb-16 text-center max-w-2xl mx-auto'>
        <h1
          class='text-3xl sm:text-4xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-3'
        >
          Claude Code Changelog Viewer
        </h1>
        <p
          class='text-base sm:text-lg text-pretty text-gray-600 leading-relaxed'
        >
          Claude Codeの更新内容をAIが分析し、ユーザーへの恩恵を分かりやすく解説
        </p>
      </header>

      <div
        class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6'
      >
        {
          versionData.map(({ version, itemCount }) => (
            <VersionCard version={version} itemCount={itemCount} />
          ))
        }
      </div>
    </div>
  </div>
</Layout>
