---
import { getCollection } from 'astro:content';
import VersionCard from '../components/changelog/VersionCard.astro';
import Layout from '../layouts/Layout.astro';
import { buildDiffMap } from '../lib/changelog-diff';
import { SITE_TITLE } from '../lib/constants';
import {
  aggregateByFeatureArea,
  extractChangelogData,
  getFeatureAreaLabel,
  MIN_ITEMS_FOR_PAGE,
  toFeatureAreaSlug,
} from '../lib/feature-area';
import { semverCompareDesc } from '../lib/semver';

const sortedChangelogs = await getCollection('changelog');
sortedChangelogs.sort((a, b) =>
  semverCompareDesc(a.data.version, b.data.version),
);

// 差分データ読み込み
const diffEntries = await getCollection('diff');
const diffMap = buildDiffMap(diffEntries);

const versionData = sortedChangelogs.map((entry) => {
  const events = diffMap.get(`v${entry.data.version}`);
  const diffStatus = events?.some((e) => e.type === 'version_removed')
    ? ('removed' as const)
    : events?.some((e) => e.type === 'items_changed')
      ? ('changed' as const)
      : undefined;
  return {
    version: entry.data.version,
    itemCount: entry.data.items.length,
    summary: entry.data.summary,
    diffStatus,
  };
});

// トップページは最新30件のみ表示、残りは /changelog へ
const TOP_PAGE_SIZE = 9;
const initialVersions = versionData.slice(0, TOP_PAGE_SIZE);
const remainingCount = versionData.length - TOP_PAGE_SIZE;

const faqItems = [
  {
    question: 'Claude Codeとは何ですか？',
    answer:
      'Claude Codeは、Anthropic社が提供するCLIベースのAIコーディングアシスタントです。ターミナルから直接Claudeを呼び出し、コードの生成・レビュー・リファクタリング・デバッグなどを行えます。',
  },
  {
    question: 'このサイトの更新頻度は？',
    answer:
      'Claude Codeの公式changelog.mdの更新を毎時チェックで自動検出し、新バージョンが見つかるとAIによる分析結果を生成・反映しています。',
  },
  {
    question: '公式との違いは？',
    answer:
      '公式のchangelog.mdをAIが日本語で要約・分析した非公式サイトです。AI生成のため内容が不正確な場合があります。正確な情報は公式リリースノートをご確認ください。',
  },
];
// 機能エリアセクション用データ
const areaMap = aggregateByFeatureArea(extractChangelogData(sortedChangelogs));
const topAreas = [...areaMap.entries()]
  .filter(([, items]) => items.length >= MIN_ITEMS_FOR_PAGE)
  .sort(([, a], [, b]) => b.length - a.length)
  .slice(0, 8)
  .map(([area, items]) => ({
    slug: toFeatureAreaSlug(area),
    label: getFeatureAreaLabel(area),
    itemCount: items.length,
  }));
---

<Layout
  title='CCログ超訳: Claude Codeの変更履歴をAIが日本語解説'
  description='Claude Code(Anthropic公式CLIツール)の変更履歴。Skills・Hooks・MCP・Memoryなど機能別にアップデート内容を絞り込み、AIが新機能・バグ修正・改善点を日本語で解説します。'
  jsonLd={{ type: 'website' }}
  faqItems={faqItems}
>
  <div class='min-h-dvh py-12 sm:py-16 px-4'>
    <div class='max-w-6xl mx-auto'>
      <header class='mb-12 sm:mb-16 text-center max-w-4xl mx-auto'>
        <h1
          class='text-3xl sm:text-4xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-3'
        >
          {SITE_TITLE}
        </h1>
        <p
          class='text-base sm:text-lg text-pretty text-gray-600 leading-relaxed'
        >
          Claude
          Codeのアップデート内容を、AIが分析して日本語で分かりやすく解説。
        </p>
        <div class='flex flex-wrap items-center justify-center gap-3 mt-5'>
          <a
            href='/notify'
            class='inline-flex items-center gap-1.5 min-h-11 px-4 py-2 rounded-full border border-[hsl(var(--cc-gray))] text-sm text-[hsl(var(--cc-main-black)/0.6)] hover:border-[hsl(var(--cc-main-orange)/0.4)] hover:text-[hsl(var(--cc-main-orange))] hover:bg-[hsl(var(--cc-main-orange)/0.04)] transition-[border-color,color,background-color,transform] active:scale-[0.96] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--cc-main-orange))]'
          >
            <svg
              class='w-4 h-4'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
              stroke-width='2'
              aria-hidden='true'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9'
              ></path>
            </svg>
            更新通知を受け取る
          </a>
          <a
            href={`/changelog/v${sortedChangelogs[0].data.version}`}
            class='inline-flex items-center gap-1.5 min-h-11 px-4 py-2 rounded-full bg-[hsl(var(--cc-main-orange))] text-sm text-white hover:bg-[hsl(var(--cc-orange-hover))] transition-[background-color,transform] active:scale-[0.96] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--cc-main-orange))]'
          >
            <svg
              class='w-4 h-4'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
              stroke-width='2'
              aria-hidden='true'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M9 5l7 7-7 7'></path>
            </svg>
            最新バージョンを見る
          </a>
        </div>
        <a
          href='/docs'
          class='block mt-3 text-xs text-[hsl(var(--cc-main-black)/0.6)] hover:text-[hsl(var(--cc-main-orange))] transition-colors rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--cc-main-orange))]'
        >
          公式ドキュメントの変更履歴はこちら →
        </a>
      </header>

      <div
        id='versions-grid'
        class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6'
      >
        {
          initialVersions.map(({ version, itemCount, summary, diffStatus }) => (
            <VersionCard
              version={version}
              itemCount={itemCount}
              summary={summary}
              diffStatus={diffStatus}
            />
          ))
        }
      </div>

      {
        remainingCount > 0 && (
          <div class='mt-8 text-center'>
            <a
              href='/changelog'
              class='inline-flex cursor-pointer items-center gap-2 px-6 py-3 rounded-lg border border-[hsl(var(--cc-gray))] text-[hsl(var(--cc-main-black))] hover:border-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-main-orange))] transition-[border-color,color,transform] active:scale-[0.96]'
            >
              全バージョン一覧を見る(他{remainingCount}件)
              <svg
                class='w-4 h-4'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
                aria-hidden='true'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M9 5l7 7-7 7'
                />
              </svg>
            </a>
          </div>
        )
      }
      <section class='mt-16 max-w-3xl mx-auto'>
        <h2
          class='text-2xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-4'
        >
          機能エリア別に探す
        </h2>
        <p class='text-sm text-gray-600 mb-6'>
          特定の機能に関する変更履歴をバージョンを横断して確認できます。
        </p>
        <div class='flex flex-wrap gap-3'>
          {
            topAreas.map(({ slug, label, itemCount }) => (
              <a
                href={`/features/${slug}`}
                class='inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[hsl(var(--cc-gray))] hover:border-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-main-orange))] transition-[border-color,color,transform] active:scale-[0.96]'
              >
                {label}
                <span class='text-xs text-gray-400 tabular-nums'>
                  {itemCount}
                </span>
              </a>
            ))
          }
          <a
            href='/features'
            class='inline-flex items-center px-4 py-2 text-sm text-gray-500 hover:text-[hsl(var(--cc-main-orange))] transition-colors'
          >
            すべて見る &rarr;
          </a>
        </div>
      </section>

      <section class='mt-16 max-w-3xl mx-auto'>
        <h2
          class='text-2xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-4'
        >
          公式ドキュメントの更新を追う
        </h2>
        <p class='text-sm text-gray-600 mb-6'>
          Claude Code 公式ドキュメントの変更を3時間おきに自動取得し、diff
          形式で追跡。AIが各更新の概要を日本語で解説します。
        </p>
        <a
          href='/docs'
          class='inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[hsl(var(--cc-gray))] hover:border-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-main-orange))] transition-[border-color,color,transform] active:scale-[0.96]'
        >
          公式ドキュメント更新履歴
          <svg
            class='w-3.5 h-3.5'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2.5'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M9 5l7 7-7 7'></path>
          </svg>
        </a>
      </section>

      <section class='mt-16 max-w-3xl mx-auto'>
        <h2
          class='text-2xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-8'
        >
          よくある質問
        </h2>
        <div class='space-y-4'>
          {
            faqItems.map(({ question, answer }) => (
              <details class='border border-[hsl(var(--cc-gray))] rounded-lg p-5 group'>
                <summary class='font-medium cursor-pointer list-none flex items-center justify-between'>
                  {question}
                  <svg
                    class='w-4 h-4 text-gray-400 group-open:rotate-180 transition-transform shrink-0'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke='currentColor'
                    stroke-width='2'
                    aria-hidden='true'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M19 9l-7 7-7-7'
                    />
                  </svg>
                </summary>
                <p class='mt-3 text-sm text-gray-600 leading-relaxed'>
                  {answer}
                </p>
              </details>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>
