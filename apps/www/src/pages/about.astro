---
import Icon from '../components/Icon.astro';
import BackLink from '../components/ui/BackLink.astro';
import Button from '../components/ui/Button.astro';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../lib/constants';

const siteUrl = import.meta.env.SITE;
---

<Layout
  title={`このサイトについて - ${SITE_TITLE}`}
  description={`${SITE_TITLE}は、Claude Codeの変更履歴をAIが分析し、日本語で分かりやすく解説する非公式プロジェクトです。コンテンツの生成プロセスや運営方針について説明します。`}
  jsonLd={{ type: 'page' }}
  breadcrumbs={[
    { name: 'トップ', url: siteUrl },
    { name: 'このサイトについて', url: `${siteUrl}/about` },
  ]}
>
  <div class='pt-8 sm:pt-10 pb-24 px-4 sm:px-6'>
    <div class='max-w-2xl mx-auto'>
      <nav class='mb-8'>
        <BackLink href='/'>トップに戻る</BackLink>
      </nav>

      <h1 class='text-[clamp(2rem,2vw+1.25rem,3rem)] text-ink mb-12'>このサイトについて</h1>

      <div class='space-y-8'>
        <section class='border-t border-rule pt-8'>
          <h2 class='text-lg font-bold text-[hsl(var(--cc-main-black))] mb-3'>サイトの目的</h2>
          <div class='space-y-3 text-base leading-relaxed text-ink-2'>
            <p>
              CCログ超訳は、Anthropic社が提供するCLIコーディングツール
              <a
                href='https://github.com/anthropics/claude-code'
                target='_blank'
                rel='noopener noreferrer'
                class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
              >
                Claude Code
              </a>
              の変更履歴を日本語で分かりやすく解説するWebサイトです。
            </p>
            <p>
              公式リリースノートの内容をAIが分析し、各アップデートの日本語訳と、変更によって何が変わるのか(変更後)を整理して提供しています。
            </p>
          </div>
        </section>

        <section class='border-t border-rule pt-8'>
          <h2 class='text-lg font-bold text-[hsl(var(--cc-main-black))] mb-3'>
            コンテンツの生成プロセス
          </h2>
          <div class='space-y-3 text-base leading-relaxed text-ink-2'>
            <p class='font-medium text-[hsl(var(--cc-main-black)/0.8)] mb-1'>バージョン変更履歴</p>
            <ol class='ml-5 list-decimal list-outside space-y-2'>
              <li>公式CHANGELOG.mdの更新を毎時チェックで自動検出</li>
              <li>各変更項目のキーワードを抽出し、公式ドキュメントとの関連性を分析</li>
              <li>AIによる日本語翻訳と、関連ドキュメントを踏まえた「変更後」の推論</li>
            </ol>
          </div>
        </section>

        <section class='border-t border-rule pt-8'>
          <h2 class='text-lg font-bold text-[hsl(var(--cc-main-black))] mb-3'>
            Claude Codeについて
          </h2>
          <div class='space-y-3 text-base leading-relaxed text-ink-2'>
            <p>
              Claude
              Codeは、Anthropic社が開発したCLI(コマンドラインインターフェース)ベースのAIコーディングアシスタントです。ターミナルから直接Claudeモデルを呼び出し、コードの生成・編集・レビュー・デバッグを効率的に行えます。
            </p>
            <div class='flex flex-wrap gap-3 pt-2'>
              <Button href='/changelog' variant='outline' shape='pill'>
                バージョン一覧を見る
              </Button>
              <Button href='/notify' variant='outline' shape='pill'>
                <Icon name='bell' class='w-4 h-4' />
                更新通知を受け取る
              </Button>
            </div>
          </div>
        </section>

        <section class='border-t border-rule pt-8'>
          <h2 class='text-lg font-bold text-[hsl(var(--cc-main-black))] mb-3'>注意事項</h2>
          <div class='space-y-3 text-base leading-relaxed text-ink-2'>
            <p>
              当サイトはAnthropicの非公式プロジェクトです。AI生成コンテンツを含むため、内容の正確性・完全性を保証するものではありません。正確な情報は
              <a
                href='https://github.com/anthropics/claude-code/releases'
                target='_blank'
                rel='noopener noreferrer'
                class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
              >
                公式リリースノート
              </a>
              をご確認ください。
            </p>
          </div>
        </section>

        <section class='border-t border-rule pt-8'>
          <h2 class='text-lg font-bold text-[hsl(var(--cc-main-black))] mb-3'>お問い合わせ</h2>
          <p class='text-base leading-relaxed text-ink-2'>
            当サイトに関するお問い合わせやフィードバックは
            <a
              href='/contact'
              class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
            >
              お問い合わせページ
            </a>
            からお願いします。
          </p>
        </section>
      </div>
    </div>
  </div>
</Layout>
