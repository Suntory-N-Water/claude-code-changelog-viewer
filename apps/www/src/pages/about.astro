---
import BackLink from '../components/ui/BackLink.astro';
import Card from '../components/ui/Card.astro';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../lib/constants';

const siteUrl = import.meta.env.SITE;
---

<Layout
  title={`このサイトについて - ${SITE_TITLE}`}
  description={`${SITE_TITLE}は、Claude Codeの変更履歴をAIが分析し、日本語で分かりやすく解説する非公式プロジェクトです。コンテンツの生成プロセスや運営方針について説明します。`}
  jsonLd={{ type: 'page' }}
  breadcrumbs={[
    { name: 'トップ', url: siteUrl },
    { name: 'このサイトについて', url: `${siteUrl}/about` },
  ]}
>
  <div class='min-h-dvh py-12 sm:py-20 px-4'>
    <div class='max-w-xl mx-auto'>
      <nav class='mb-10'>
        <BackLink href='/'>トップに戻る</BackLink>
      </nav>

      <h1
        class='text-2xl sm:text-3xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-10'
      >
        このサイトについて
      </h1>

      <div class='space-y-8'>
        <Card as='section'>
          <h2 class='text-lg font-bold text-[hsl(var(--cc-main-black))] mb-3'>
            サイトの目的
          </h2>
          <div
            class='space-y-3 text-sm leading-relaxed text-[hsl(var(--cc-main-black)/0.7)]'
          >
            <p>
              CCログ超訳は、Anthropic社が提供するCLIコーディングツール
              <a
                href='https://github.com/anthropics/claude-code'
                target='_blank'
                rel='noopener noreferrer'
                class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
              >
                Claude Code
              </a>
              の変更履歴を日本語で分かりやすく解説するWebサイトです。
            </p>
            <p>
              公式リリースノートの内容をAIが分析し、各アップデートの「変更前」「変更後」「ユーザーへの恩恵」を整理して提供しています。
            </p>
          </div>
        </Card>

        <Card as='section'>
          <h2 class='text-lg font-bold text-[hsl(var(--cc-main-black))] mb-3'>
            コンテンツの生成プロセス
          </h2>
          <div
            class='space-y-3 text-sm leading-relaxed text-[hsl(var(--cc-main-black)/0.7)]'
          >
            <p class='font-medium text-[hsl(var(--cc-main-black)/0.8)] mb-1'>
              バージョン変更履歴
            </p>
            <ol class='ml-5 list-decimal list-outside space-y-2'>
              <li>公式CHANGELOG.mdの更新を毎時チェックで自動検出</li>
              <li>
                各変更項目のキーワードを抽出し、公式ドキュメントとの関連性を分析
              </li>
              <li>
                AIによる日本語翻訳と「変更前→変更後→ユーザーへの恩恵」の推論
              </li>
              <li>新バージョン検出時にDiscord Webhookで自動通知</li>
            </ol>
          </div>
        </Card>

        <Card as='section'>
          <h2 class='text-lg font-bold text-[hsl(var(--cc-main-black))] mb-3'>
            Claude Codeについて
          </h2>
          <div
            class='space-y-3 text-sm leading-relaxed text-[hsl(var(--cc-main-black)/0.7)]'
          >
            <p>
              Claude
              Codeは、Anthropic社が開発したCLI(コマンドラインインターフェース)ベースのAIコーディングアシスタントです。ターミナルから直接Claudeモデルを呼び出し、コードの生成・編集・レビュー・デバッグを効率的に行えます。
            </p>
            <p>
              最新の変更内容は
              <a
                href='/'
                class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
              >
                トップページのバージョン一覧
              </a>
              からご確認いただけます。新バージョンの自動通知は
              <a
                href='/notify'
                class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
              >
                通知設定ページ
              </a>
              から登録できます。
            </p>
          </div>
        </Card>

        <Card as='section'>
          <h2 class='text-lg font-bold text-[hsl(var(--cc-main-black))] mb-3'>
            注意事項
          </h2>
          <div
            class='space-y-3 text-sm leading-relaxed text-[hsl(var(--cc-main-black)/0.7)]'
          >
            <p>
              当サイトはAnthropicの非公式プロジェクトです。AI生成コンテンツを含むため、内容の正確性・完全性を保証するものではありません。正確な情報は
              <a
                href='https://github.com/anthropics/claude-code/releases'
                target='_blank'
                rel='noopener noreferrer'
                class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
              >
                公式リリースノート
              </a>
              をご確認ください。
            </p>
          </div>
        </Card>

        <Card as='section'>
          <h2 class='text-lg font-bold text-[hsl(var(--cc-main-black))] mb-3'>
            お問い合わせ
          </h2>
          <p
            class='text-sm leading-relaxed text-[hsl(var(--cc-main-black)/0.7)]'
          >
            当サイトに関するお問い合わせやフィードバックは
            <a
              href='/contact'
              class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
            >
              お問い合わせページ
            </a>
            からお願いします。
          </p>
        </Card>
      </div>
    </div>
  </div>
</Layout>
