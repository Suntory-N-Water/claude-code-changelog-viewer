---
import { CONTACT_EMAIL } from '../config/contact';
import Icon from '../components/Icon.astro';
import BackLink from '../components/ui/BackLink.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import TabButton from '../components/ui/TabButton.astro';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../lib/constants';

const siteUrl = import.meta.env.SITE;

const DETAIL_PLACEHOLDER = '{{DETAIL_DATA}}';
const tabs = [
  {
    id: 'bug',
    label: 'バグ報告',
    subject: `[バグ報告] ${SITE_TITLE}`,
    body: [
      '## 不具合の説明',
      '',
      '',
      '## 不具合の再現手順',
      '',
      '',
      '## 詳細データ(編集しないでください)',
      DETAIL_PLACEHOLDER,
    ].join('\n'),
  },
  {
    id: 'other',
    label: 'その他',
    subject: `[お問い合わせ] ${SITE_TITLE}`,
    body: [
      '## お問い合わせ内容',
      '',
      '',
      '## 詳細データ(編集しないでください)',
      DETAIL_PLACEHOLDER,
    ].join('\n'),
  },
] as const;
---

<Layout
  title={`お問い合わせ - ${SITE_TITLE}`}
  description={`${SITE_TITLE}に関するバグ報告、機能リクエスト、その他のお問い合わせはこちらからどうぞ。`}
  jsonLd={{ type: 'page' }}
  breadcrumbs={[
    { name: 'トップ', url: siteUrl },
    { name: 'お問い合わせ', url: `${siteUrl}/contact` },
  ]}
>
  <div class='min-h-dvh py-12 sm:py-20 px-4'>
    <div class='max-w-xl mx-auto'>
      <nav class='mb-10'>
        <BackLink href='/'>トップに戻る</BackLink>
      </nav>

      <h1
        class='text-2xl sm:text-3xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-4'
      >
        お問い合わせ
      </h1>

      <p
        class='text-sm leading-relaxed text-[hsl(var(--cc-main-black)/0.7)] mb-10'
      >
        以下のテンプレートを使ってメールでお問い合わせください。
      </p>

      <div class='space-y-6'>
        <!-- メールテンプレートカード -->
        <Card as='section' padding='none' class='overflow-hidden'>
          <!-- タブ -->
          <div
            class='flex border-b border-[hsl(var(--cc-gray))]'
            role='tablist'
            aria-label='お問い合わせの種類'
            id='contact-tablist'
          >
            {
              tabs.map((tab, i) => (
                <TabButton
                  role='tab'
                  id={`tab-${tab.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls={`panel-${tab.id}`}
                  tabindex={i === 0 ? 0 : -1}
                  active={i === 0}
                  class='contact-tab flex-1 px-3 hover:text-[hsl(var(--cc-main-orange))] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[hsl(var(--cc-main-orange))]'
                  data-tab-id={tab.id}
                >
                  {tab.label}
                </TabButton>
              ))
            }
          </div>

          <!-- タブパネル -->
          {
            tabs.map((tab, i) => (
              <div
                role='tabpanel'
                id={`panel-${tab.id}`}
                aria-labelledby={`tab-${tab.id}`}
                class:list={['contact-panel p-5 sm:p-6', i !== 0 && 'hidden']}
                data-panel-id={tab.id}
              >
                <div class='space-y-5'>
                  {/* 件名 */}
                  <div>
                    <div class='flex items-center justify-between mb-2'>
                      <span class='text-xs font-medium text-[hsl(var(--cc-main-black)/0.4)] tracking-wider uppercase'>
                        件名
                      </span>
                      <Button
                        type='button'
                        variant='ghost'
                        size='xs'
                        class='contact-copy-btn p-0 text-[hsl(var(--cc-main-black)/0.4)] hover:bg-transparent'
                        data-copy-target={`subject-${tab.id}`}
                        aria-label='件名をコピー'
                      >
                        <Icon
                          name='copy'
                          class='w-3.5 h-3.5'
                          aria-hidden='true'
                        />
                        <span class='contact-copy-label'>コピー</span>
                      </Button>
                    </div>
                    <div
                      class='rounded-lg bg-[hsl(var(--cc-main-black)/0.03)] border border-[hsl(var(--cc-gray))] px-4 py-3 text-sm text-[hsl(var(--cc-main-black)/0.8)] font-mono'
                      id={`subject-${tab.id}`}
                    >
                      {tab.subject}
                    </div>
                  </div>

                  {/* 本文 */}
                  <div>
                    <div class='flex items-center justify-between mb-2'>
                      <span class='text-xs font-medium text-[hsl(var(--cc-main-black)/0.4)] tracking-wider uppercase'>
                        本文
                      </span>
                      <Button
                        type='button'
                        variant='ghost'
                        size='xs'
                        class='contact-copy-btn p-0 text-[hsl(var(--cc-main-black)/0.4)] hover:bg-transparent'
                        data-copy-target={`body-${tab.id}`}
                        aria-label='本文をコピー'
                      >
                        <Icon
                          name='copy'
                          class='w-3.5 h-3.5'
                          aria-hidden='true'
                        />
                        <span class='contact-copy-label'>コピー</span>
                      </Button>
                    </div>
                    <pre
                      class='rounded-lg bg-[hsl(var(--cc-main-black)/0.03)] border border-[hsl(var(--cc-gray))] px-4 py-3 text-sm text-[hsl(var(--cc-main-black)/0.8)] font-mono whitespace-pre-wrap break-all leading-relaxed overflow-hidden'
                      id={`body-${tab.id}`}
                      set:text={tab.body}
                    />
                  </div>

                  {/* 送信先 */}
                  <div>
                    <span class='text-xs font-medium text-[hsl(var(--cc-main-black)/0.4)] tracking-wider uppercase block mb-2'>
                      送信先
                    </span>
                    <div class='rounded-lg bg-[hsl(var(--cc-main-black)/0.03)] border border-[hsl(var(--cc-gray))] px-4 py-3 text-sm text-[hsl(var(--cc-main-black)/0.8)] font-mono'>
                      {CONTACT_EMAIL}
                    </div>
                  </div>

                  {/* アクションボタン */}
                  <div class='flex flex-col sm:flex-row gap-3 pt-2'>
                    <Button
                      href={`https://mail.google.com/mail/?view=cm&to=${encodeURIComponent(CONTACT_EMAIL)}&su=${encodeURIComponent(tab.subject)}&body=${encodeURIComponent(tab.body)}`}
                      size='lg'
                      class='contact-gmail-btn px-5 text-sm font-medium'
                      target='_blank'
                      rel='noopener noreferrer'
                      data-tab-id={tab.id}
                      aria-label='Gmail でメールを作成する'
                    >
                      <Icon name='mail' class='w-4 h-4' aria-hidden='true' />
                      Gmail で開く
                    </Button>
                    <Button
                      href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(tab.subject)}&body=${encodeURIComponent(tab.body)}`}
                      variant='outline'
                      size='lg'
                      class='contact-mailto-btn px-5 text-sm'
                      data-tab-id={tab.id}
                      aria-label='デフォルトのメーラーで開く'
                    >
                      <Icon
                        name='external-link'
                        class='w-4 h-4'
                        aria-hidden='true'
                      />
                      メーラーで開く
                    </Button>
                  </div>
                </div>
              </div>
            ))
          }
        </Card>
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ tabs, CONTACT_EMAIL, DETAIL_PLACEHOLDER }}>
  function getDetailData() {
    const ua = navigator.userAgentData;
    if (ua) {
      return JSON.stringify({
        brands: ua.brands,
        mobile: ua.mobile,
        platform: ua.platform,
      });
    }
    return navigator.userAgent;
  }

  const detailData = getDetailData();

  function resolveBody(bodyTemplate) {
    return bodyTemplate.replace(DETAIL_PLACEHOLDER, detailData);
  }

  function buildGmailUrl(subject, body) {
    const params = new URLSearchParams({
      view: 'cm',
      to: CONTACT_EMAIL,
      su: subject,
      body: resolveBody(body),
    });
    return `https://mail.google.com/mail/?${params.toString()}`;
  }

  function buildMailtoUrl(subject, body) {
    const params = new URLSearchParams({
      subject,
      body: resolveBody(body),
    });
    return `mailto:${CONTACT_EMAIL}?${params.toString()}`;
  }

  function updateLinks(tabId) {
    const tmpl = tabs.find((t) => t.id === tabId);
    if (!tmpl) {
      return;
    }

    for (const btn of document.querySelectorAll(
      `.contact-gmail-btn[data-tab-id="${tabId}"]`,
    )) {
      btn.href = buildGmailUrl(tmpl.subject, tmpl.body);
    }
    for (const btn of document.querySelectorAll(
      `.contact-mailto-btn[data-tab-id="${tabId}"]`,
    )) {
      btn.href = buildMailtoUrl(tmpl.subject, tmpl.body);
    }
  }

  function switchTab(tabId) {
    for (const btn of document.querySelectorAll('.contact-tab')) {
      const isActive = btn.dataset.tabId === tabId;
      btn.setAttribute('aria-selected', String(isActive));
      btn.tabIndex = isActive ? 0 : -1;
      if (isActive) {
        btn.classList.add(
          'text-[hsl(var(--cc-main-orange))]',
          'border-b-2',
          'border-[hsl(var(--cc-main-orange))]',
          'font-medium',
        );
        btn.classList.remove('text-[hsl(var(--cc-main-black)/0.5)]');
      } else {
        btn.classList.remove(
          'text-[hsl(var(--cc-main-orange))]',
          'border-b-2',
          'border-[hsl(var(--cc-main-orange))]',
          'font-medium',
        );
        btn.classList.add('text-[hsl(var(--cc-main-black)/0.5)]');
      }
    }

    for (const panel of document.querySelectorAll('.contact-panel')) {
      panel.classList.toggle('hidden', panel.dataset.panelId !== tabId);
    }
  }

  async function handleCopy(btn) {
    const targetId = btn.dataset.copyTarget;
    const target = document.getElementById(targetId);
    if (!target) {
      return;
    }

    let text = target.textContent || '';
    if (text.includes(DETAIL_PLACEHOLDER)) {
      text = resolveBody(text);
    }

    try {
      await navigator.clipboard.writeText(text.trim());
      const label = btn.querySelector('.contact-copy-label');
      if (label) {
        const original = label.textContent;
        label.textContent = 'コピーしました';
        btn.classList.add('text-[hsl(var(--cc-main-orange))]');
        setTimeout(() => {
          label.textContent = original;
          btn.classList.remove('text-[hsl(var(--cc-main-orange))]');
        }, 2000);
      }
    } catch {
      // clipboard API 非対応環境向けフォールバック
      const textarea = document.createElement('textarea');
      textarea.value = text.trim();
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
    }
  }

  function initContact() {
    for (const el of document.querySelectorAll('[id^="body-"]')) {
      if (el.textContent?.includes(DETAIL_PLACEHOLDER)) {
        el.textContent = resolveBody(el.textContent);
      }
    }

    for (const tab of tabs) {
      updateLinks(tab.id);
    }

    for (const btn of document.querySelectorAll('.contact-tab')) {
      btn.addEventListener('click', () => {
        switchTab(btn.dataset.tabId);
      });
    }

    const tabButtons = [...document.querySelectorAll('.contact-tab')];
    for (const btn of tabButtons) {
      btn.addEventListener('keydown', (e) => {
        const idx = tabButtons.indexOf(btn);
        let nextIdx = -1;

        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          nextIdx = (idx + 1) % tabButtons.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          nextIdx = (idx - 1 + tabButtons.length) % tabButtons.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          nextIdx = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          nextIdx = tabButtons.length - 1;
        }

        if (nextIdx >= 0) {
          tabButtons[nextIdx].focus();
          switchTab(tabButtons[nextIdx].dataset.tabId);
        }
      });
    }

    for (const btn of document.querySelectorAll('.contact-copy-btn')) {
      btn.addEventListener('click', () => handleCopy(btn));
    }
  }

  initContact();
</script>
