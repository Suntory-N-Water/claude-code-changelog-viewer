---
import { getCollection } from 'astro:content';
import { TZDate } from '@date-fns/tz';
import { format } from 'date-fns';
import { ja } from 'date-fns/locale';
import Icon from '../../components/Icon.astro';
import DocFileDiff from '../../components/docs/DocFileDiff.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../lib/constants';
import { formatChangelogContent } from '../../lib/format-changelog-content';

export async function getStaticPaths() {
  const docsDiffEntries = await getCollection('docsDiff');

  return docsDiffEntries.map((col) => ({
    params: { slug: col.data.id },
    props: { entry: col.data },
  }));
}

type Props = {
  entry: {
    id: string;
    timestamp: string;
    aiSummary: string;
    files: {
      filename: string;
      additions: number;
      deletions: number;
      explanation?: string;
      hunks: {
        header: string;
        lines: { type: 'added' | 'removed' | 'context'; content: string }[];
      }[];
    }[];
  };
};

const { entry } = Astro.props;

const jstDate = new TZDate(entry.timestamp, 'Asia/Tokyo');
const formattedDate = format(jstDate, 'yyyy年M月d日 HH:mm', { locale: ja });

const totalAdditions = entry.files.reduce((sum, f) => sum + f.additions, 0);
const totalDeletions = entry.files.reduce((sum, f) => sum + f.deletions, 0);

const pageTitle = `Docs 更新履歴 ${formattedDate}`;
const formattedSummary = formatChangelogContent(entry.aiSummary);
---

<Layout
  title={`${pageTitle} - ${SITE_TITLE}`}
  description={entry.aiSummary}
  jsonLd={{ type: 'page' }}
  breadcrumbs={[
    { name: 'トップ', url: Astro.site?.href ?? '/' },
    { name: 'Docs 更新履歴', url: `${Astro.site?.href ?? '/'}docs` },
    { name: formattedDate, url: `${Astro.site?.href ?? '/'}docs/${entry.id}` },
  ]}
>
  <div class='max-w-4xl mx-auto px-4 py-8'>
    <!-- 戻るリンク -->
    <div class='mb-6'>
      <a
        href='/docs'
        data-direction='back'
        class='inline-flex items-center gap-1.5 text-sm text-[hsl(var(--cc-main-black)/0.55)] hover:text-[hsl(var(--cc-main-orange))] transition-colors'
      >
        <Icon name='arrow-left' class='w-4 h-4' aria-hidden='true' />
        タイムラインに戻る
      </a>
    </div>

    <!-- ヘッダー -->
    <div class='mb-6'>
      <h1 class='text-xl font-bold text-[hsl(var(--cc-main-black))] mb-2'>
        <time datetime={entry.timestamp}>{formattedDate}</time>
      </h1>
      <div
        class='flex flex-wrap items-center gap-3 text-sm text-[hsl(var(--cc-main-black)/0.5)]'
      >
        <span>{entry.files.length} ファイル変更</span>
        <span aria-hidden='true'>·</span>
        <span class='text-green-700 font-mono font-medium tabular-nums'
          >+{totalAdditions}</span
        >
        <span class='text-red-600 font-mono font-medium tabular-nums'
          >-{totalDeletions}</span
        >
      </div>
    </div>

    <!-- サマリー -->
    <div
      class='mb-8 p-6 bg-linear-to-br from-[hsl(var(--cc-main-orange)/0.05)] to-[hsl(var(--cc-main-orange)/0.02)] border border-[hsl(var(--cc-gray))] rounded-lg'
    >
      <div class='border-l-4 border-[hsl(var(--cc-main-orange))] pl-4'>
        <h2
          class='text-xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-3'
        >
          この更新の概要
        </h2>
        <p
          class='text-base leading-relaxed text-[hsl(var(--cc-main-black))] text-pretty'
          set:html={formattedSummary}
        />
      </div>
    </div>

    <!-- ファイルジャンプナビ(複数ファイルがある場合のみ表示) -->
    {
      entry.files.length > 1 && (
        <nav
          aria-label='変更ファイル一覧'
          class='mb-6 p-4 rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-gray)/0.2)]'
        >
          <p class='text-xs font-semibold text-[hsl(var(--cc-main-black)/0.5)] uppercase tracking-wide mb-2'>
            変更ファイル
          </p>
          <ul class='space-y-1'>
            {entry.files.map((file) => (
              <li>
                <a
                  href={`#${file.filename.replace('.md', '').replace(/\//g, '-')}`}
                  class='inline-flex items-center gap-2 text-xs font-mono text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))] transition-colors group'
                >
                  <span class='text-green-700 font-medium tabular-nums'>
                    +{file.additions}
                  </span>
                  <span class='text-red-600 font-medium tabular-nums'>
                    -{file.deletions}
                  </span>
                  <span class='group-hover:underline underline-offset-2'>
                    {file.filename.replace(/\.md$/, '')}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <!-- ファイル別 diff -->
    <div class='space-y-6'>
      {
        entry.files.map((file) => (
          <section id={file.filename.replace('.md', '').replace(/\//g, '-')}>
            <DocFileDiff
              filename={file.filename}
              additions={file.additions}
              deletions={file.deletions}
              explanation={file.explanation}
              hunks={file.hunks}
            />
          </section>
        ))
      }
    </div>
  </div>
</Layout>
