---
import { getCollection } from 'astro:content';
import { TZDate } from '@date-fns/tz';
import { format } from 'date-fns';
import { ja } from 'date-fns/locale';
import DocFileDiff from '../../components/docs/DocFileDiff.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../lib/constants';

export async function getStaticPaths() {
  const docsDiffEntries = await getCollection('docsDiff');

  const allEntries = docsDiffEntries.flatMap((col) => col.data.entries);

  return allEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = {
  entry: {
    id: string;
    timestamp: string;
    aiSummary: string;
    files: {
      filename: string;
      additions: number;
      deletions: number;
      hunks: {
        header: string;
        lines: { type: 'added' | 'removed' | 'context'; content: string }[];
      }[];
    }[];
  };
};

const { entry } = Astro.props;

const jstDate = new TZDate(entry.timestamp, 'Asia/Tokyo');
const formattedDate = format(jstDate, 'yyyy年M月d日 HH:mm', { locale: ja });

const totalAdditions = entry.files.reduce((sum, f) => sum + f.additions, 0);
const totalDeletions = entry.files.reduce((sum, f) => sum + f.deletions, 0);

const pageTitle = `Docs 更新 ${formattedDate} JST`;
---

<Layout
  title={`${pageTitle} - ${SITE_TITLE}`}
  description={entry.aiSummary}
  breadcrumbs={[
    { name: 'トップ', url: Astro.site?.href ?? '/' },
    { name: 'Docs 更新', url: `${Astro.site?.href ?? '/'}docs` },
    { name: formattedDate, url: `${Astro.site?.href ?? '/'}docs/${entry.id}` },
  ]}
>
  <div class='max-w-4xl mx-auto px-4 py-8'>
    <!-- 戻るリンク -->
    <div class='mb-6'>
      <a
        href='/docs'
        class='inline-flex items-center gap-1 text-sm text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] transition-colors'
      >
        <svg
          class='w-4 h-4'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
          aria-hidden='true'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M15 19l-7-7 7-7'></path>
        </svg>
        タイムラインに戻る
      </a>
    </div>

    <!-- ヘッダー -->
    <div class='mb-8'>
      <div class='flex flex-wrap items-center gap-3 mb-2'>
        <time
          datetime={entry.timestamp}
          class='text-2xl font-bold text-[hsl(var(--cc-main-black))]'
        >
          {formattedDate} JST
        </time>
        <span class='text-sm text-gray-400 font-mono'>{entry.id}</span>
      </div>
      <div class='flex items-center gap-3 text-sm text-gray-500'>
        <span>{entry.files.length} ファイル変更</span>
        <span>·</span>
        <span class='text-green-600 font-mono'>+{totalAdditions}</span>
        <span class='text-red-500 font-mono'>-{totalDeletions}</span>
      </div>
    </div>

    <!-- AI サマリー -->
    <div
      class='mb-8 bg-[hsl(var(--cc-gray)/0.3)] rounded-xl p-5 border border-[hsl(var(--cc-gray))]'
    >
      <div class='flex items-center gap-2 mb-2'>
        <svg
          class='w-4 h-4 text-[hsl(var(--cc-main-orange))]'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
          aria-hidden='true'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z'
          ></path>
        </svg>
        <span
          class='text-xs font-semibold text-[hsl(var(--cc-main-black)/0.6)] uppercase tracking-wide'
        >
          AI サマリー
        </span>
      </div>
      <p class='text-sm text-[hsl(var(--cc-main-black))] leading-relaxed'>
        {entry.aiSummary}
      </p>
    </div>

    <!-- ファイル別 diff -->
    <div class='space-y-6'>
      {
        entry.files.map((file) => (
          <section id={file.filename.replace('.md', '').replace(/\//g, '-')}>
            <DocFileDiff
              filename={file.filename}
              additions={file.additions}
              deletions={file.deletions}
              hunks={file.hunks}
            />
          </section>
        ))
      }
    </div>
  </div>
</Layout>
