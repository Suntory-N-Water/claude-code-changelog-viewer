---
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import DocsDiffCard from '../../components/docs/DocsDiffCard.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../lib/constants';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const docsDiffEntries = await getCollection('docsDiff');

  const allEntries = docsDiffEntries
    .map((col) => col.data)
    .sort(
      (a, b) =>
        new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime(),
    );

  // TODO: constants.ts に移す
  return paginate(allEntries, { pageSize: 5 });
}

type Props = {
  page: {
    data: {
      id: string;
      timestamp: string;
      aiSummary: string;
      files: { filename: string; additions: number; deletions: number }[];
    }[];
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
};

const { page } = Astro.props;

const pageNum = page.currentPage > 1 ? ` (${page.currentPage}ページ目)` : '';
const pageTitle = `公式ドキュメント更新履歴${pageNum}`;
const pageDescription =
  'Claude Code 公式ドキュメントの更新履歴を diff 形式で確認できます。';
---

<Layout
  title={`${pageTitle} - ${SITE_TITLE}`}
  description={pageDescription}
  jsonLd={{
    type: 'collection',
    title: pageTitle,
    description: pageDescription,
  }}
  breadcrumbs={[
    { name: 'トップ', url: Astro.site?.href ?? '/' },
    { name: 'Docs 更新履歴', url: `${Astro.site?.href ?? '/'}docs` },
  ]}
>
  <div class='max-w-4xl mx-auto px-4 py-8'>
    <!-- ページヘッダー -->
    <div class='mb-8'>
      <h1 class='text-2xl font-bold text-[hsl(var(--cc-main-black))] mb-2'>
        公式ドキュメント更新履歴
      </h1>
      <p
        class='text-sm text-[hsl(var(--cc-main-black)/0.55)] leading-relaxed pl-0.5'
      >
        Claude Code 公式ドキュメント(<a
          href='https://code.claude.com/docs'
          target='_blank'
          rel='noopener noreferrer'
          class='font-mono text-xs bg-[hsl(var(--cc-gray)/0.6)] hover:bg-[hsl(var(--cc-gray))] px-1.5 py-0.5 rounded transition-colors text-[hsl(var(--cc-main-black)/0.7)]'
          >https://code.claude.com/docs</a
        >)の更新を追跡しています。3時間おきに自動取得。
      </p>
    </div>

    {
      page.data.length === 0 ? (
        <div class='text-center py-20 border border-dashed border-[hsl(var(--cc-gray))] rounded-xl'>
          <svg
            class='w-10 h-10 text-[hsl(var(--cc-main-black)/0.2)] mx-auto mb-3'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='1.5'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z'
            />
          </svg>
          <p class='text-sm font-medium text-[hsl(var(--cc-main-black)/0.4)]'>
            まだ更新履歴がありません
          </p>
          <p class='text-xs text-[hsl(var(--cc-main-black)/0.3)] mt-1'>
            次回の自動取得(3時間おき)をお待ちください。
          </p>
        </div>
      ) : (
        <div class='space-y-4'>
          {page.data.map((entry) => (
            <div class='docs-diff-card'>
              <DocsDiffCard
                id={entry.id}
                timestamp={entry.timestamp}
                aiSummary={entry.aiSummary}
                files={entry.files}
              />
            </div>
          ))}
        </div>
      )
    }

    <!-- ページネーション -->
    {
      page.lastPage > 1 && (
        <nav
          aria-label='ページナビゲーション'
          class='flex items-center justify-between mt-10 pt-6 border-t border-[hsl(var(--cc-gray))]'
        >
          <div>
            {page.url.prev ? (
              <a
                href={page.url.prev}
                class='inline-flex items-center justify-center w-9 h-9 rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] text-[hsl(var(--cc-main-black)/0.5)] hover:border-[hsl(var(--cc-main-orange)/0.4)] hover:text-[hsl(var(--cc-main-orange))] transition-colors'
              >
                <span class='sr-only'>新しい更新へ</span>
                <svg
                  class='w-4 h-4'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'
                  aria-hidden='true'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M15 19l-7-7 7-7'
                  />
                </svg>
              </a>
            ) : (
              <span />
            )}
          </div>

          <span class='text-xs text-[hsl(var(--cc-main-black)/0.4)]'>
            {page.currentPage} / {page.lastPage}
          </span>

          <div>
            {page.url.next ? (
              <a
                href={page.url.next}
                class='inline-flex items-center justify-center w-9 h-9 rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] text-[hsl(var(--cc-main-black)/0.5)] hover:border-[hsl(var(--cc-main-orange)/0.4)] hover:text-[hsl(var(--cc-main-orange))] transition-colors'
              >
                <span class='sr-only'>古い更新へ</span>
                <svg
                  class='w-4 h-4'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'
                  aria-hidden='true'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M9 5l7 7-7 7'
                  />
                </svg>
              </a>
            ) : (
              <span />
            )}
          </div>
        </nav>
      )
    }
  </div>
</Layout>
