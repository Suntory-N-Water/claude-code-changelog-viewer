---
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import Icon from '../../components/Icon.astro';
import DocsDiffCard from '../../components/docs/DocsDiffCard.astro';
import Pagination from '../../components/ui/Pagination.astro';
import Card from '../../components/ui/Card.astro';
import Layout from '../../layouts/Layout.astro';
import { DOCS_DIFF_PAGE_SIZE, SITE_TITLE } from '../../lib/constants';
import { sortDocsDiffEntries } from '../../lib/docs-diff';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const docsDiffEntries = await getCollection('docsDiff');

  return paginate(sortDocsDiffEntries(docsDiffEntries), {
    pageSize: DOCS_DIFF_PAGE_SIZE,
  });
}

type Props = {
  page: {
    data: {
      id: string;
      timestamp: string;
      aiSummary: string;
      files: { filename: string; additions: number; deletions: number }[];
    }[];
    currentPage: number;
    lastPage: number;
    url: { first?: string; prev?: string; next?: string };
  };
};

const { page } = Astro.props;

const firstPageUrl = page.url.first ?? '/docs';
const pageUrlBase = firstPageUrl.replace(/\/$/, '');
const paginationPages = Array.from({ length: page.lastPage }, (_, index) => {
  const pageNumber = index + 1;
  return {
    number: pageNumber,
    url: pageNumber === 1 ? firstPageUrl : `${pageUrlBase}/${pageNumber}`,
  };
});

const pageNum = page.currentPage > 1 ? ` (${page.currentPage}ページ目)` : '';
const pageTitle = `公式ドキュメント更新履歴${pageNum}`;
const pageDescription =
  'Claude Code 公式ドキュメントの更新履歴を diff 形式で確認できます。';
---

<Layout
  title={`${pageTitle} - ${SITE_TITLE}`}
  description={pageDescription}
  jsonLd={{
    type: 'collection',
    title: pageTitle,
    description: pageDescription,
  }}
  breadcrumbs={[
    { name: 'トップ', url: Astro.site?.href ?? '/' },
    { name: 'Docs 更新履歴', url: `${Astro.site?.href ?? '/'}docs` },
  ]}
>
  <div class='max-w-4xl mx-auto px-4 py-8'>
    <!-- ページヘッダー -->
    <div class='mb-8'>
      <h1
        class='text-2xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-2'
      >
        公式ドキュメント更新履歴
      </h1>
      <p
        class='text-sm text-[hsl(var(--cc-main-black)/0.55)] leading-relaxed pl-0.5'
      >
        Claude Code 公式ドキュメント(<a
          href='https://code.claude.com/docs'
          target='_blank'
          rel='noopener noreferrer'
          class='font-mono text-xs bg-[hsl(var(--cc-gray)/0.6)] hover:bg-[hsl(var(--cc-gray))] px-1.5 py-0.5 rounded transition-colors text-[hsl(var(--cc-main-black)/0.7)]'
          >https://code.claude.com/docs</a
        >)の更新を追跡しています。3時間おきに自動取得。
      </p>
    </div>

    {
      page.data.length === 0 ? (
        <Card variant='dashed' padding='none' class='text-center py-20'>
          <Icon
            name='clock'
            class='w-10 h-10 text-[hsl(var(--cc-main-black)/0.2)] mx-auto mb-3'
            stroke-width='1.5'
            aria-hidden='true'
          />
          <p class='text-sm font-medium text-[hsl(var(--cc-main-black)/0.4)]'>
            まだ更新履歴がありません
          </p>
          <p class='text-xs text-[hsl(var(--cc-main-black)/0.3)] mt-1'>
            次回の自動取得(3時間おき)をお待ちください。
          </p>
        </Card>
      ) : (
        <div class='space-y-4'>
          {page.data.map((entry) => (
            <div class='docs-diff-card'>
              <DocsDiffCard
                id={entry.id}
                timestamp={entry.timestamp}
                aiSummary={entry.aiSummary}
                files={entry.files}
              />
            </div>
          ))}
        </div>
      )
    }

    {
      page.lastPage > 1 && (
        <Pagination
          pages={paginationPages}
          currentPage={page.currentPage}
          totalPages={page.lastPage}
          previousHref={page.url.prev}
          nextHref={page.url.next}
          previousLabel='新しい更新へ'
          nextLabel='古い更新へ'
          class='mt-10'
        />
      )
    }
  </div>
</Layout>
