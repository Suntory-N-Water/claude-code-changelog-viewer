---
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import Icon from '../../components/Icon.astro';
import DocsDiffCard from '../../components/docs/DocsDiffCard.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../lib/constants';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const docsDiffEntries = await getCollection('docsDiff');

  const allEntries = docsDiffEntries
    .map((col) => col.data)
    .sort(
      (a, b) =>
        new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime(),
    );

  // TODO: constants.ts に移す
  return paginate(allEntries, { pageSize: 5 });
}

type Props = {
  page: {
    data: {
      id: string;
      timestamp: string;
      aiSummary: string;
      files: { filename: string; additions: number; deletions: number }[];
    }[];
    currentPage: number;
    lastPage: number;
    url: { first?: string; prev?: string; next?: string };
  };
};

const { page } = Astro.props;

const firstPageUrl = page.url.first ?? '/docs';
const pageUrlBase = firstPageUrl.replace(/\/$/, '');
const paginationPages = Array.from({ length: page.lastPage }, (_, index) => {
  const pageNumber = index + 1;
  return {
    number: pageNumber,
    url: pageNumber === 1 ? firstPageUrl : `${pageUrlBase}/${pageNumber}`,
  };
});

const pageNum = page.currentPage > 1 ? ` (${page.currentPage}ページ目)` : '';
const pageTitle = `公式ドキュメント更新履歴${pageNum}`;
const pageDescription =
  'Claude Code 公式ドキュメントの更新履歴を diff 形式で確認できます。';
---

<Layout
  title={`${pageTitle} - ${SITE_TITLE}`}
  description={pageDescription}
  jsonLd={{
    type: 'collection',
    title: pageTitle,
    description: pageDescription,
  }}
  breadcrumbs={[
    { name: 'トップ', url: Astro.site?.href ?? '/' },
    { name: 'Docs 更新履歴', url: `${Astro.site?.href ?? '/'}docs` },
  ]}
>
  <div class='max-w-4xl mx-auto px-4 py-8'>
    <!-- ページヘッダー -->
    <div class='mb-8'>
      <h1
        class='text-2xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-2'
      >
        公式ドキュメント更新履歴
      </h1>
      <p
        class='text-sm text-[hsl(var(--cc-main-black)/0.55)] leading-relaxed pl-0.5'
      >
        Claude Code 公式ドキュメント(<a
          href='https://code.claude.com/docs'
          target='_blank'
          rel='noopener noreferrer'
          class='font-mono text-xs bg-[hsl(var(--cc-gray)/0.6)] hover:bg-[hsl(var(--cc-gray))] px-1.5 py-0.5 rounded transition-colors text-[hsl(var(--cc-main-black)/0.7)]'
          >https://code.claude.com/docs</a
        >)の更新を追跡しています。3時間おきに自動取得。
      </p>
    </div>

    {
      page.data.length === 0 ? (
        <div class='text-center py-20 border border-dashed border-[hsl(var(--cc-gray))] rounded-xl'>
          <Icon
            name='clock'
            class='w-10 h-10 text-[hsl(var(--cc-main-black)/0.2)] mx-auto mb-3'
            stroke-width='1.5'
            aria-hidden='true'
          />
          <p class='text-sm font-medium text-[hsl(var(--cc-main-black)/0.4)]'>
            まだ更新履歴がありません
          </p>
          <p class='text-xs text-[hsl(var(--cc-main-black)/0.3)] mt-1'>
            次回の自動取得(3時間おき)をお待ちください。
          </p>
        </div>
      ) : (
        <div class='space-y-4'>
          {page.data.map((entry) => (
            <div class='docs-diff-card'>
              <DocsDiffCard
                id={entry.id}
                timestamp={entry.timestamp}
                aiSummary={entry.aiSummary}
                files={entry.files}
              />
            </div>
          ))}
        </div>
      )
    }

    <!-- ページネーション -->
    {
      page.lastPage > 1 && (
        <nav
          aria-label='ページナビゲーション'
          class='flex items-center justify-between gap-3 mt-10 pt-6 border-t border-[hsl(var(--cc-gray))]'
        >
          <div class='shrink-0'>
            {page.url.prev ? (
              <a
                href={page.url.prev}
                class='inline-flex items-center justify-center w-11 h-11 rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] text-[hsl(var(--cc-main-black)/0.55)] hover:border-[hsl(var(--cc-main-orange)/0.45)] hover:text-[hsl(var(--cc-main-orange))] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(var(--cc-main-orange)/0.45)] transition-colors'
              >
                <span class='sr-only'>新しい更新へ</span>
                <Icon name='arrow-left' class='w-4 h-4' aria-hidden='true' />
              </a>
            ) : (
              <span class='block w-11 h-11' aria-hidden='true' />
            )}
          </div>

          <div class='relative min-w-0'>
            <label for='docs-page-select' class='sr-only'>
              表示するページ
            </label>
            <select
              id='docs-page-select'
              data-docs-pagination-select
              class='w-36 sm:w-40 h-11 appearance-none rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] px-4 pr-10 text-center text-sm font-medium tabular-nums text-[hsl(var(--cc-main-black)/0.72)] cursor-pointer hover:border-[hsl(var(--cc-main-orange)/0.45)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(var(--cc-main-orange)/0.45)] transition-colors'
            >
              {paginationPages.map((paginationPage) => (
                <option
                  value={paginationPage.url}
                  selected={paginationPage.number === page.currentPage}
                >
                  {paginationPage.number} / {page.lastPage} ページ
                </option>
              ))}
            </select>
            <Icon
              name='chevron-down'
              class='pointer-events-none absolute right-3 top-1/2 w-4 h-4 -translate-y-1/2 text-[hsl(var(--cc-main-black)/0.42)]'
              aria-hidden='true'
            />
          </div>

          <div class='shrink-0'>
            {page.url.next ? (
              <a
                href={page.url.next}
                class='inline-flex items-center justify-center w-11 h-11 rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] text-[hsl(var(--cc-main-black)/0.55)] hover:border-[hsl(var(--cc-main-orange)/0.45)] hover:text-[hsl(var(--cc-main-orange))] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(var(--cc-main-orange)/0.45)] transition-colors'
              >
                <span class='sr-only'>古い更新へ</span>
                <Icon name='chevron-right' class='w-4 h-4' aria-hidden='true' />
              </a>
            ) : (
              <span class='block w-11 h-11' aria-hidden='true' />
            )}
          </div>
        </nav>
      )
    }
  </div>

  <script>
    document.addEventListener('change', (event) => {
      const target = event.target;
      if (
        !(target instanceof HTMLSelectElement) ||
        !target.matches('[data-docs-pagination-select]')
      ) {
        return;
      }

      if (target.value) {
        window.location.href = target.value;
      }
    });
  </script>
</Layout>
