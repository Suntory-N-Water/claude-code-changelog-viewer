---
import { getCollection } from 'astro:content';
import DocsDiffCard from '../../components/docs/DocsDiffCard.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../lib/constants';

const docsDiffEntries = await getCollection('docsDiff');

// entries を時系列(新しい順)に展開
const allEntries = docsDiffEntries
  .flatMap((col) => col.data.entries)
  .sort(
    (a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime(),
  );

const pageTitle = '公式ドキュメント更新履歴';
const pageDescription =
  'Claude Code 公式日本語ドキュメントの更新履歴を diff 形式で確認できます。';
---

<Layout
  title={`${pageTitle} - ${SITE_TITLE}`}
  description={pageDescription}
  jsonLd={{
    type: 'collection',
    title: pageTitle,
    description: pageDescription,
  }}
  breadcrumbs={[
    { name: 'トップ', url: Astro.site?.href ?? '/' },
    { name: 'Docs 更新履歴', url: `${Astro.site?.href ?? '/'}docs` },
  ]}
>
  <div class='max-w-4xl mx-auto px-4 py-8'>
    <!-- ページヘッダー -->
    <div class='mb-8'>
      <h1 class='text-2xl font-bold text-[hsl(var(--cc-main-black))] mb-2'>
        公式ドキュメント更新履歴
      </h1>
      <p
        class='text-sm text-[hsl(var(--cc-main-black)/0.55)] leading-relaxed pl-0.5'
      >
        Claude Code 公式日本語ドキュメント(<a
          href='https://docs.anthropic.com/ja/claude-code'
          target='_blank'
          rel='noopener noreferrer'
          class='font-mono text-xs bg-[hsl(var(--cc-gray)/0.6)] hover:bg-[hsl(var(--cc-gray))] px-1.5 py-0.5 rounded transition-colors text-[hsl(var(--cc-main-black)/0.7)]'
          >claude.ai/code/docs/ja</a
        >)の更新を追跡しています。3時間おきに自動取得。
      </p>
    </div>

    {
      allEntries.length === 0 ? (
        <div class='text-center py-20 border border-dashed border-[hsl(var(--cc-gray))] rounded-xl'>
          <svg
            class='w-10 h-10 text-[hsl(var(--cc-main-black)/0.2)] mx-auto mb-3'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='1.5'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z'
            />
          </svg>
          <p class='text-sm font-medium text-[hsl(var(--cc-main-black)/0.4)]'>
            まだ更新履歴がありません
          </p>
          <p class='text-xs text-[hsl(var(--cc-main-black)/0.3)] mt-1'>
            次回の自動取得(3時間おき)をお待ちください。
          </p>
        </div>
      ) : (
        <div class='space-y-4'>
          {allEntries.map((entry) => (
            <div class='docs-diff-card'>
              <DocsDiffCard
                id={entry.id}
                timestamp={entry.timestamp}
                aiSummary={entry.aiSummary}
                files={entry.files}
              />
            </div>
          ))}
        </div>
      )
    }
  </div>
</Layout>
