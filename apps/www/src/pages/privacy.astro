---
import BackLink from '../components/ui/BackLink.astro';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../lib/constants';

const siteUrl = import.meta.env.SITE;
---

<Layout
  title={`プライバシーポリシー - ${SITE_TITLE}`}
  description={`${SITE_TITLE}のプライバシーポリシーです。Google Analyticsによるアクセス解析、Cookieの取り扱い、通知機能(Discord・Slack・メール)で収集する情報とその保護、AI生成コンテンツに関する免責事項について詳しく説明しています。`}
  jsonLd={{ type: 'page' }}
  breadcrumbs={[
    { name: 'トップ', url: siteUrl },
    { name: 'プライバシーポリシー', url: `${siteUrl}/privacy` },
  ]}
>
  <div class='pt-8 sm:pt-10 pb-24 px-4 sm:px-6'>
    <div class='max-w-2xl mx-auto'>
      <nav class='mb-8'>
        <BackLink href='/'>トップに戻る</BackLink>
      </nav>

      <h1 class='text-[clamp(2rem,2vw+1.25rem,3rem)] text-ink mb-12'>プライバシーポリシー</h1>

      <!-- セクション -->
      <div class='space-y-8'>
        <section class='border-t border-rule pt-8'>
          <h2 class='text-lg font-bold text-balance text-[hsl(var(--cc-main-black))] mb-3'>
            アクセス解析ツールについて
          </h2>
          <div class='space-y-3 text-base leading-relaxed text-ink-2'>
            <p>
              当サイトでは、サイトの利用状況を把握するために Google Analytics
              を使用しています。Google Analytics はデータの収集のために Cookie
              を使用する場合があります。このデータは匿名で収集されており、個人を特定するものではありません。
            </p>
            <p>
              この機能は Cookie を無効にすることで収集を拒否できます。詳しくは
              <a
                href='https://policies.google.com/technologies/partner-sites'
                target='_blank'
                rel='noopener noreferrer'
                class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
              >
                Google のポリシー
              </a>
              をご確認ください。
            </p>
          </div>
        </section>

        <section class='border-t border-rule pt-8'>
          <h2 class='text-lg font-bold text-balance text-[hsl(var(--cc-main-black))] mb-3'>
            通知機能について
          </h2>
          <div class='space-y-3 text-base leading-relaxed text-ink-2'>
            <p>
              Discord・Slackの通知機能をご利用の場合、Webhook URLをCloudflare
              D1データベースに保存します。このURLは通知の送信にのみ使用されます。
            </p>
            <p>
              メール通知をご利用の場合、メールアドレスをお預かりします。メールアドレスは暗号化した上でデータベースに保存しており、平文では保持しません。保存されたメールアドレスは通知の送信および重複登録の確認にのみ使用されます。
            </p>
            <p>
              通知はいつでも停止できます。通知メッセージ内の「通知を停止する」リンクをクリックすることで配信を停止できます。データの削除を希望される場合は
              <a
                href='/contact'
                class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
              >
                お問い合わせページ
              </a>
              からご連絡ください。
            </p>
          </div>
        </section>

        <section class='border-t border-rule pt-8'>
          <h2 class='text-lg font-bold text-balance text-[hsl(var(--cc-main-black))] mb-3'>
            免責事項
          </h2>
          <p class='text-base leading-relaxed text-ink-2'>
            当サイトのコンテンツはAIによって生成されたものを含みます。正確性には注意を払っていますが、内容の正確性・完全性を保証するものではありません。正確な情報は
            <a
              href='https://github.com/anthropics/claude-code/releases'
              target='_blank'
              rel='noopener noreferrer'
              class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
            >
              公式リリースノート
            </a>
            をご確認ください。
          </p>
        </section>

        <section class='border-t border-rule pt-8'>
          <h2 class='text-lg font-bold text-balance text-[hsl(var(--cc-main-black))] mb-3'>
            お問い合わせ
          </h2>
          <p class='text-base leading-relaxed text-ink-2'>
            当サイトに関するお問い合わせは
            <a
              href='/contact'
              class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] underline underline-offset-2 transition-colors'
            >
              お問い合わせページ
            </a>
            からお願いします。
          </p>
        </section>
      </div>
    </div>
  </div>
</Layout>
