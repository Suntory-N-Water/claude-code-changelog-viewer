---
import { TZDate } from '@date-fns/tz';
import { getCollection } from 'astro:content';
import { format } from 'date-fns';
import VersionCard from '../../components/changelog/VersionCard.astro';
import Layout from '../../layouts/Layout.astro';
import { buildDiffMap, buildVersionData } from '../../lib/changelog-diff';
import { getReleaseMap } from '../../lib/release-map';
import { semverCompareDesc } from '../../lib/semver';

const releaseMap = await getReleaseMap();
const formatReleaseDate = (version: string) => {
  const releasedAt = releaseMap.get(version);
  return releasedAt ? format(new TZDate(releasedAt, 'Asia/Tokyo'), 'yyyy/MM/dd') : undefined;
};

const sortedChangelogs = await getCollection('changelog');
sortedChangelogs.sort((a, b) => semverCompareDesc(a.data.version, b.data.version));

const diffEntries = await getCollection('diff');
const diffMap = buildDiffMap(diffEntries);

const versionData = buildVersionData(sortedChangelogs, diffMap);

// メジャーバージョンでグループ化
const groups = new Map<string, typeof versionData>();
for (const v of versionData) {
  const major = v.version.split('.')[0];
  const key = `v${major}.x`;
  if (!groups.has(key)) {
    groups.set(key, []);
  }
  groups.get(key)?.push(v);
}
---

<Layout
  title='全バージョン一覧 - CCログ超訳: Claude Codeの変更履歴'
  description={`Claude Codeの全${versionData.length}バージョンの変更履歴一覧。各バージョンの新機能・バグ修正・改善点をAIが日本語で解説します。`}
  jsonLd={{
    type: 'collection',
    title: '全バージョン一覧',
    description: `Claude Code 全${versionData.length}バージョン変更履歴`,
  }}
  breadcrumbs={[
    { name: 'ホーム', url: 'https://claude-code-log.com/' },
    { name: '全バージョン一覧', url: 'https://claude-code-log.com/changelog' },
  ]}
>
  <div class='max-w-6xl mx-auto px-4 sm:px-6 pt-8 sm:pt-10 pb-24'>
    <header class='pb-12 sm:pb-16'>
      <nav aria-label='パンくずリスト' class='flex items-center gap-2 text-sm text-muted'>
        <a
          href='/'
          class='inline-flex items-center min-h-10 underline-offset-4 hover:underline hover:text-ink'
        >
          ホーム
        </a>
        <span aria-hidden='true'>/</span>
        <span class='text-ink-2'>全バージョン一覧</span>
      </nav>
      <h1 class='mt-6 text-[clamp(2.25rem,3vw+1.25rem,3.5rem)] text-ink'>全バージョン一覧</h1>
      <p class='mt-3 text-base text-ink-2 tabular-nums'>{versionData.length} バージョン</p>
    </header>

    {[...groups.entries()].map(([groupKey, versions], i) => (
      <section class:list={['grid lg:grid-cols-12 gap-x-8 gap-y-4', i > 0 && 'mt-20']}>
        <h2 class='lg:col-span-2 text-3xl font-bold tabular-nums text-ink lg:sticky lg:top-[calc(var(--nav-height)+var(--space-lg))] self-start'>
          {groupKey}
        </h2>
        <ol class='lg:col-span-10'>
          {versions.map(({ version, itemCount, summary, diffStatus }) => (
            <VersionCard
              version={version}
              itemCount={itemCount}
              summary={summary}
              diffStatus={diffStatus}
              releaseDate={formatReleaseDate(version)}
            />
          ))}
        </ol>
      </section>
    ))}
  </div>
</Layout>
