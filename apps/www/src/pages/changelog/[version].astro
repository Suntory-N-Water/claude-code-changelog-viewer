---
import { getCollection } from 'astro:content';
import type { Prefix } from '@claude-code-changelog-viewer/common';
import ChangelogItemCard from '../../components/changelog/ChangelogItemCard.astro';
import BackLink from '../../components/ui/BackLink.astro';
import Button from '../../components/ui/Button.astro';
import PrefixTableOfContents from '../../components/changelog/PrefixTableOfContents.astro';
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import {
  buildDiffMap,
  type DiffEvent,
  formatDiffDateTime,
} from '../../lib/changelog-diff';
import { extractChangelogData, getLinkedAreas } from '../../lib/feature-area';
import { formatChangelogContent } from '../../lib/format-changelog-content';
import {
  getPrefixSortOrder,
  PREFIX_DEFAULT_STYLE,
  PREFIX_ICONS,
  PREFIX_LABELS,
  PREFIX_STYLES,
} from '../../lib/prefix';
import { semverCompareDesc } from '../../lib/semver';

export async function getStaticPaths() {
  const allChangelogs = await getCollection('changelog');

  // ページが存在する feature_area を算出
  const linkedAreas = getLinkedAreas(extractChangelogData(allChangelogs));

  // 差分データ読み込み
  const diffEntries = await getCollection('diff');
  const diffMap = buildDiffMap(diffEntries);

  // バージョン降順ソート
  const sorted = [...allChangelogs].sort((a, b) =>
    semverCompareDesc(a.data.version, b.data.version),
  );

  return sorted.map((entry, i) => ({
    params: { version: `v${entry.data.version}` },
    props: {
      entry,
      prevVersion: sorted[i + 1]?.data.version ?? null,
      nextVersion: sorted[i - 1]?.data.version ?? null,
      latestVersion: sorted[0].data.version,
      linkedAreas,
      diffEvents: diffMap.get(`v${entry.data.version}`) ?? [],
    },
  }));
}

const {
  entry,
  prevVersion,
  nextVersion,
  latestVersion,
  linkedAreas,
  diffEvents,
} = Astro.props;
const { version, items, summary } = entry.data;

// 差分ステータス算出
const removedEvent = diffEvents.find(
  (e: DiffEvent) => e.type === 'version_removed',
);
const isRemoved = !!removedEvent;
const removedDate = removedEvent
  ? formatDiffDateTime(removedEvent.detected_at)
  : '';
const itemChangeEvents = diffEvents.filter(
  (e: DiffEvent) => e.type === 'items_changed',
);
const hasItemChanges = itemChangeEvents.length > 0;

// メタタグ用 description: summary があれば使用、なければ変更項目数を含めた詳細テキスト
const MIN_DESC_LENGTH = 120;
const rawDescription =
  summary ??
  `Claude Code v${version}のアップデート内容(${items.length}件の変更項目)をAIが分析。新機能・バグ修正・改善点の詳細とユーザーへの具体的な恩恵を日本語で分かりやすく解説しています。`;
const description =
  rawDescription.length < MIN_DESC_LENGTH
    ? `${rawDescription} Claude Code v${version}の変更点をAIが日本語で分かりやすく解説します。`
    : rawDescription;

// summaryのバッククォートをHTMLコードタグに変換
const formattedSummary = summary ? formatChangelogContent(summary) : undefined;

// prefix でグルーピング → グループ内は impact level 降順
const IMPACT_LEVEL_ORDER: Record<string, number> = {
  high: 0,
  medium: 1,
  low: 2,
};
const IMPACT_UNSET = 3;

const groupMap = new Map<string, typeof items>();
for (const item of items) {
  const key = item.prefix;
  if (!groupMap.has(key)) {
    groupMap.set(key, []);
  }
  const group = groupMap.get(key);
  if (group) {
    group.push(item);
  }
}

const prefixGroups = [...groupMap.entries()]
  .sort(([a], [b]) => getPrefixSortOrder(a) - getPrefixSortOrder(b))
  .map(([prefix, groupItems]) => ({
    prefix,
    label: PREFIX_LABELS[prefix as Prefix] ?? prefix,
    items: groupItems.toSorted((a, b) => {
      const aOrder = IMPACT_LEVEL_ORDER[a.impact?.level ?? ''] ?? IMPACT_UNSET;
      const bOrder = IMPACT_LEVEL_ORDER[b.impact?.level ?? ''] ?? IMPACT_UNSET;
      return aOrder - bOrder;
    }),
  }));

// フラットリスト(件数表示用)
const totalItemCount = items.length;
---

<Layout
  title={`Claude Code v${version} の変更点 - ${items.length}件の新機能・バグ修正を日本語解説`}
  description={description}
  jsonLd={{
    type: 'article',
    version,
    summary,
  }}
  breadcrumbs={[
    { name: 'トップ', url: import.meta.env.SITE },
    { name: '変更履歴', url: `${import.meta.env.SITE}/changelog` },
    {
      name: `v${version}`,
      url: `${import.meta.env.SITE}/changelog/v${version}`,
    },
  ]}
>
  <div class='min-h-dvh py-12 sm:py-16 px-4' data-pagefind-body>
    <div class='max-w-4xl mx-auto'>
      <nav class='mb-8' aria-label='パンくずリスト' data-pagefind-ignore>
        <BackLink href='/' tone='accent'>バージョン一覧に戻る</BackLink>
      </nav>

      {
        version !== latestVersion && (
          <div class='mb-6 flex items-start gap-2 px-4 py-3 rounded-lg bg-[hsl(var(--cc-gray)/0.5)] border border-[hsl(var(--cc-gray))] text-sm text-[hsl(var(--cc-main-black)/0.85)]'>
            <Icon
              name='info-circle'
              class='w-4 h-4 shrink-0 mt-0.5'
              aria-hidden='true'
            />
            <div>
              <p>このバージョン以降にも更新があります。</p>
              <a
                href={`/changelog/v${latestVersion}`}
                class='font-medium text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline transition-colors rounded focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[hsl(var(--cc-main-orange))]'
              >
                最新版 v{latestVersion} を見る →
              </a>
            </div>
          </div>
        )
      }

      <header class='mb-10'>
        <div class='flex flex-wrap items-baseline gap-x-4 gap-y-3 mb-5'>
          <h1
            class='font-mono text-5xl sm:text-6xl lg:text-7xl font-bold tabular-nums leading-none tracking-tight text-[hsl(var(--cc-main-orange))]'
            transition:name={`version-title-${version}`}
            data-pagefind-meta='title'
          >
            <span class='sr-only'>Claude Code </span>v{version}
          </h1>
          {
            isRemoved && (
              <span class='inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-[hsl(var(--cc-gray))] text-[hsl(var(--cc-main-black))]'>
                公式のCHANGELOG.mdから削除済み
              </span>
            )
          }
          {
            !isRemoved && hasItemChanges && (
              <span class='inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-[hsl(var(--cc-gray))] text-[hsl(var(--cc-main-black))]'>
                公式のCHANGELOG.mdで更新あり
              </span>
            )
          }
        </div>
        <div
          class='flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-600 border-b border-[hsl(var(--cc-gray))] pb-6'
        >
          <p class='tabular-nums'>変更項目 {totalItemCount} 件</p>
          <a
            href={`https://github.com/anthropics/claude-code/blob/main/CHANGELOG.md#${version.replace(/\./g, '')}`}
            target='_blank'
            rel='noopener noreferrer'
            class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline inline-flex items-center gap-1 transition-colors'
          >
            公式 CHANGELOG.md
            <Icon name='external-link' class='w-3.5 h-3.5' aria-hidden='true' />
          </a>
        </div>
        {
          isRemoved && (
            <p class='text-sm text-[hsl(var(--cc-main-black)/0.6)] mt-1'>
              この内容は公式のCHANGELOG.mdから削除される前に取得したものです(
              {removedDate}
              検出)
            </p>
          )
        }
        {
          itemChangeEvents.length > 0 && (
            <>
              <Button
                type='button'
                popovertarget='changelog-history-popover'
                variant='ghost'
                size='sm'
                class='changelog-history-trigger p-0 mt-2 text-gray-600 hover:bg-transparent'
              >
                公式のCHANGELOG.mdでの変更履歴
                <Icon
                  name='chevron-down'
                  class='w-3.5 h-3.5'
                  aria-hidden='true'
                />
              </Button>
              <div
                id='changelog-history-popover'
                popover
                class='changelog-history-popover p-5 rounded-lg border border-[hsl(var(--cc-gray))] bg-[hsl(var(--cc-main-white))] shadow-xl max-w-md w-[min(90vw,28rem)] max-h-[70vh] overflow-y-auto'
              >
                <div class='flex items-center justify-between mb-3 pb-2 border-b border-[hsl(var(--cc-gray))]'>
                  <p class='text-sm font-semibold text-[hsl(var(--cc-main-black))]'>
                    公式のCHANGELOG.mdでの変更履歴
                  </p>
                  <Button
                    type='button'
                    popovertarget='changelog-history-popover'
                    popovertargetaction='hide'
                    variant='ghost'
                    size='icon-sm'
                    class='w-6 h-6 rounded text-gray-400 hover:text-[hsl(var(--cc-main-black))] hover:bg-transparent'
                    aria-label='閉じる'
                  >
                    <Icon name='close' class='w-4 h-4' aria-hidden='true' />
                  </Button>
                </div>
                <div class='space-y-2 text-sm text-gray-600'>
                  {itemChangeEvents.map((event: DiffEvent) => (
                    <div>
                      <p class='font-medium text-gray-700'>
                        {formatDiffDateTime(event.detected_at)}
                        {event.items_added.length > 0 && (
                          <span class='text-green-700 ml-2'>
                            +{event.items_added.length}件追加
                          </span>
                        )}
                        {event.items_removed.length > 0 && (
                          <span class='text-red-700 ml-2'>
                            -{event.items_removed.length}件削除
                          </span>
                        )}
                      </p>
                      {event.items_added.length > 0 && (
                        <ul class='mt-1 space-y-0.5'>
                          {event.items_added.map((item: string) => (
                            <li class='text-green-700 text-xs'>+ {item}</li>
                          ))}
                        </ul>
                      )}
                      {event.items_removed.length > 0 && (
                        <ul class='mt-1 space-y-0.5'>
                          {event.items_removed.map((item: string) => (
                            <li class='text-red-700 text-xs'>- {item}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </>
          )
        }
      </header>

      {
        summary && (
          <div class='mb-10 p-6 bg-linear-to-br from-[hsl(var(--cc-main-orange)/0.05)] to-[hsl(var(--cc-main-orange)/0.02)] border border-[hsl(var(--cc-gray))] rounded-lg'>
            <div class='border-l-4 border-[hsl(var(--cc-main-orange))] pl-4'>
              <h2 class='text-xl font-bold text-[hsl(var(--cc-main-black))] mb-3'>
                このバージョンの概要
              </h2>
              <p
                class='text-base leading-relaxed text-[hsl(var(--cc-main-black))]'
                data-pagefind-meta='description'
                set:html={formattedSummary}
              />
            </div>
            <PrefixTableOfContents groups={prefixGroups} />
          </div>
        )
      }

      <div class='space-y-10'>
        {
          prefixGroups.map((group) => {
            const style =
              PREFIX_STYLES[group.prefix as Prefix] || PREFIX_DEFAULT_STYLE;
            const iconPath = PREFIX_ICONS[group.prefix as Prefix];
            return (
              <section id={`prefix-${group.prefix.toLowerCase()}`}>
                <div class='sticky top-12 z-10 bg-[hsl(var(--cc-main-white)/0.95)] backdrop-blur-sm py-3 -mx-4 px-4 mb-4 border-b border-[hsl(var(--cc-gray)/0.3)]'>
                  <h3 class='flex items-center gap-2 text-lg font-bold text-[hsl(var(--cc-main-black))]'>
                    <span
                      class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold uppercase ${style}`}
                    >
                      {iconPath && (
                        <svg
                          class='w-3.5 h-3.5'
                          fill='none'
                          viewBox='0 0 24 24'
                          stroke='currentColor'
                          stroke-width='2.5'
                          aria-hidden='true'
                        >
                          <path
                            stroke-linecap='round'
                            stroke-linejoin='round'
                            d={iconPath}
                          />
                        </svg>
                      )}
                      {group.prefix}
                    </span>
                    <span>{group.label}</span>
                    <span class='text-sm font-normal text-gray-500 tabular-nums'>
                      ({group.items.length}件)
                    </span>
                  </h3>
                </div>
                <div class='space-y-6'>
                  {group.items.map((item) => (
                    <ChangelogItemCard
                      item={item}
                      anchorId={`item-${item.id}`}
                      linkedAreas={linkedAreas}
                    />
                  ))}
                </div>
              </section>
            );
          })
        }
      </div>

      <aside
        class='mt-10 p-5 bg-[hsl(var(--cc-main-orange)/0.04)] border border-[hsl(var(--cc-gray))] rounded-lg flex flex-col sm:flex-row items-center justify-between gap-4'
      >
        <p class='text-sm text-gray-600'>
          Claude Codeの新バージョンを見逃さない
        </p>
        <Button href='/notify' size='sm' shape='pill' data-cta='notify'>
          <Icon name='bell' class='w-4 h-4' aria-hidden='true' />
          更新通知を受け取る
        </Button>
      </aside>

      <div id='share-section' class='mt-8 flex flex-wrap items-center gap-3'>
        <span class='text-sm text-gray-500'>シェア:</span>
        <Button
          id='web-share-btn'
          type='button'
          hidden
          size='xs'
          shape='pill'
          class='px-4'
          aria-label='シェア'
        >
          <Icon name='bell' class='w-3.5 h-3.5' aria-hidden='true' />
          シェアする
        </Button>
        <Button
          href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(`${import.meta.env.SITE}/changelog/v${version}`)}&text=${encodeURIComponent(`Claude Code v${version} の変更点`)}`}
          target='_blank'
          rel='noopener noreferrer'
          variant='outline'
          size='xs'
          shape='pill'
          aria-label='Xでシェア'
          data-share='x'
        >
          <Icon name='x-twitter' class='w-3.5 h-3.5' aria-hidden='true' />
          X
        </Button>
        <Button
          href={`https://b.hatena.ne.jp/entry/s/${new URL(`/changelog/v${version}`, import.meta.env.SITE).host}${new URL(`/changelog/v${version}`, import.meta.env.SITE).pathname}`}
          target='_blank'
          rel='noopener noreferrer'
          variant='outline'
          size='xs'
          shape='pill'
          aria-label='はてなブックマークに追加'
          data-share='hatena'
        >
          <Icon name='hatena-b' class='w-3.5 h-3.5' aria-hidden='true' />
          はてブ
        </Button>
        <Button
          id='copy-url-btn'
          type='button'
          variant='outline'
          size='xs'
          shape='pill'
          aria-label='URLをコピー'
        >
          <Icon
            name='copy'
            id='copy-url-icon'
            class='w-3.5 h-3.5'
            aria-hidden='true'
          />
          <span id='copy-url-label'>URLをコピー</span>
        </Button>
      </div>

      <nav
        class='mt-8 pt-8 border-t border-[hsl(var(--cc-gray))] flex justify-between items-center'
        aria-label='バージョンナビゲーション'
      >
        {
          prevVersion ? (
            <a
              href={`/changelog/v${prevVersion}`}
              class='inline-flex items-center gap-1 text-sm text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] transition-colors'
              data-version-nav='prev'
            >
              <Icon name='arrow-left' class='w-4 h-4' aria-hidden='true' />v
              {prevVersion}
            </a>
          ) : (
            <span />
          )
        }
        {
          nextVersion ? (
            <a
              href={`/changelog/v${nextVersion}`}
              class='inline-flex items-center gap-1 text-sm text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] transition-colors'
              data-version-nav='next'
            >
              v{nextVersion}
              <Icon name='chevron-right' class='w-4 h-4' aria-hidden='true' />
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const version =
        document.querySelector<HTMLHeadingElement>('h1')?.textContent?.trim() ??
        '';

      // Web Share API (対応環境のみシェアボタンを表示、フォールバックは非表示)
      const webShareBtn = document.getElementById('web-share-btn');
      if (webShareBtn instanceof HTMLButtonElement && 'share' in navigator) {
        const shareData = {
          title: `Claude Code v${version} の変更点`,
          text: `Claude Code v${version} の変更点`,
          url: location.href,
        };
        const canShareData =
          typeof navigator.canShare === 'function'
            ? navigator.canShare(shareData)
            : true;
        if (canShareData) {
          webShareBtn.hidden = false;
          // 個別シェアリンク (X / はてブ / コピー) を非表示にして統合
          document
            .querySelectorAll<HTMLElement>(
              '#share-section [data-share], #share-section #copy-url-btn',
            )
            .forEach((el) => {
              el.hidden = true;
            });
          webShareBtn.addEventListener('click', async () => {
            try {
              await navigator.share(shareData);
              window.gtag?.('event', 'share_clicked', {
                event_category: 'engagement',
                share_method: 'web_share',
                version,
              });
            } catch {
              // ユーザーキャンセル等は無視
            }
          });
        }
      }

      // URLコピーボタン
      const btn = document.getElementById('copy-url-btn');
      const label = document.getElementById('copy-url-label');
      const icon = document.getElementById('copy-url-icon');
      if (btn && label && icon) {
        btn.addEventListener('click', async () => {
          await navigator.clipboard.writeText(location.href);
          window.gtag?.('event', 'share_clicked', {
            event_category: 'engagement',
            share_method: 'copy_url',
            version,
          });
          label.textContent = 'コピーしました';
          icon.innerHTML =
            '<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>';
          setTimeout(() => {
            label.textContent = 'URLをコピー';
            icon.innerHTML =
              '<path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>';
          }, 2000);
        });
      }

      // シェアリンク (X / はてブ)
      document
        .querySelectorAll<HTMLAnchorElement>('[data-share]')
        .forEach((el) => {
          el.addEventListener('click', () => {
            window.gtag?.('event', 'share_clicked', {
              event_category: 'engagement',
              share_method: el.dataset.share,
              version,
            });
          });
        });

      // 通知CTA
      document
        .querySelector<HTMLAnchorElement>('[data-cta="notify"]')
        ?.addEventListener('click', () => {
          window.gtag?.('event', 'notify_cta_clicked', {
            event_category: 'engagement',
            location: 'changelog_detail',
            version,
          });
        });

      // 前後バージョンナビゲーション
      document
        .querySelectorAll<HTMLAnchorElement>('[data-version-nav]')
        .forEach((el) => {
          el.addEventListener('click', () => {
            window.gtag?.('event', 'version_nav_clicked', {
              event_category: 'engagement',
              direction: el.dataset.versionNav,
              from_version: version,
            });
          });
        });

      // スクロール深度 (25% / 50% / 75% / 100%)
      const milestones = [25, 50, 75, 100];
      const fired = new Set<number>();
      function onScroll() {
        const scrolled = window.scrollY + window.innerHeight;
        const total = document.documentElement.scrollHeight;
        const pct = Math.round((scrolled / total) * 100);
        for (const milestone of milestones) {
          if (pct >= milestone && !fired.has(milestone)) {
            fired.add(milestone);
            window.gtag?.('event', 'scroll_depth', {
              event_category: 'engagement',
              depth_percent: milestone,
              version,
            });
          }
        }
        if (fired.size === milestones.length) {
          window.removeEventListener('scroll', onScroll, {
            passive: true,
          } as AddEventListenerOptions);
        }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
    });
  </script>

  <style>
    /* 開閉アニメーション (Popover API)。位置指定とは独立して translate を使用 */
    .changelog-history-popover {
      opacity: 0;
      translate: 0 -0.5rem;
      transition:
        opacity 0.18s ease-out,
        translate 0.18s ease-out,
        overlay 0.18s allow-discrete,
        display 0.18s allow-discrete;
    }
    .changelog-history-popover:popover-open {
      opacity: 1;
      translate: 0 0;
    }
    @starting-style {
      .changelog-history-popover:popover-open {
        opacity: 0;
        translate: 0 -0.5rem;
      }
    }

    /* Anchor Positioning 対応ブラウザではトリガー直下にドロップダウン表示。
       未対応ブラウザは UA デフォルト (inset:0 + margin:auto) の中央寄せにフォールバック */
    @supports (anchor-name: --x) {
      .changelog-history-trigger {
        anchor-name: --changelog-history-anchor;
      }
      .changelog-history-popover {
        position: fixed;
        position-anchor: --changelog-history-anchor;
        inset: auto;
        top: anchor(bottom);
        left: anchor(left);
        margin-top: 0.5rem;
        /* 下に収まらなければ上へフリップ */
        position-try-fallbacks: flip-block;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .changelog-history-popover {
        transition: none;
        translate: none;
      }
    }
  </style>
</Layout>
