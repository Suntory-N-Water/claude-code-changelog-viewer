---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ChangelogItemCard from '../../components/changelog/ChangelogItemCard.astro';
import { formatChangelogContent } from '../../lib/changelog';

export async function getStaticPaths() {
  const allChangelogs = await getCollection('changelog');

  return allChangelogs.map((entry) => ({
    params: { version: `v${entry.data.version}` },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { version, items, summary } = entry.data;

// メタタグ用 description: summary があれば使用、なければデフォルトテキスト
const description = summary ?? `Claude Code v${version}の変更内容と恩恵の解説`;

// summaryのバッククォートをHTMLコードタグに変換
const formattedSummary = summary ? formatChangelogContent(summary) : undefined;

// 重要度降順でソート
const sortedItems = [...items].sort(
  (a, b) => b.importance_score - a.importance_score,
);
---

<Layout
  title={`Claude Code v${version} 変更履歴`}
  description={description}
  image={`${import.meta.env.SITE}/changelog/v${version}/og.png`}
>
  <div class='min-h-dvh py-12 px-4'>
    <div class='max-w-4xl mx-auto'>
      <nav class='mb-8'>
        <a
          href='/'
          data-direction='back'
          class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline'
        >
          ← バージョン一覧に戻る
        </a>
      </nav>

      <header class='mb-8'>
        <h1
          class='text-4xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-2'
          transition:name={`version-title-${version}`}
        >
          Claude Code v{version}
        </h1>
        <div class='flex items-center gap-4 text-sm text-gray-600'>
          <p>変更項目: {sortedItems.length}件</p>
          <a
            href={`https://github.com/anthropics/claude-code/releases/tag/v${version}`}
            target='_blank'
            rel='noopener noreferrer'
            class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline'
          >
            GitHub Release →
          </a>
        </div>
      </header>

      {
        entry.data.summary && (
          <div class='mb-8 p-6 bg-linear-to-br from-[hsl(var(--cc-main-orange)/0.05)] to-[hsl(var(--cc-main-orange)/0.02)] border border-[hsl(var(--cc-gray))] rounded-lg'>
            <div class='border-l-4 border-[hsl(var(--cc-main-orange))] pl-4'>
              <h2 class='text-xl font-bold text-[hsl(var(--cc-main-black))] mb-3 flex items-center gap-2'>
                このバージョンの概要
              </h2>
              <p
                class='text-base leading-relaxed text-[hsl(var(--cc-main-black))] text-pretty'
                set:html={formattedSummary}
              />
            </div>
          </div>
        )
      }

      <div class='space-y-6'>
        {sortedItems.map((item) => <ChangelogItemCard item={item} />)}
      </div>
    </div>
  </div>
</Layout>
