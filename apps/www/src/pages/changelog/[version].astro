---
import { getCollection } from 'astro:content';
import ChangelogItemCard from '../../components/changelog/ChangelogItemCard.astro';
import BackLink from '../../components/ui/BackLink.astro';
import Button from '../../components/ui/Button.astro';
import PrefixTableOfContents from '../../components/changelog/PrefixTableOfContents.astro';
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import { buildDiffMap, type DiffEvent, formatDiffDateTime } from '../../lib/changelog-diff';
import { formatChangelogContent } from '../../lib/format-changelog-content';
import {
  getPrefixPresentation,
  getPrefixSortOrder,
  PREFIX_LABELS,
  type Prefix,
} from '../../lib/prefix';
import { semverCompareDesc } from '../../lib/semver';

export async function getStaticPaths() {
  const allChangelogs = await getCollection('changelog');

  // 差分データ読み込み
  const diffEntries = await getCollection('diff');
  const diffMap = buildDiffMap(diffEntries);

  // バージョン降順ソート
  const sorted = [...allChangelogs].sort((a, b) =>
    semverCompareDesc(a.data.version, b.data.version),
  );

  return sorted.map((entry, i) => ({
    params: { version: `v${entry.data.version}` },
    props: {
      entry,
      prevVersion: sorted[i + 1]?.data.version ?? null,
      nextVersion: sorted[i - 1]?.data.version ?? null,
      latestVersion: sorted[0].data.version,
      diffEvents: diffMap.get(`v${entry.data.version}`) ?? [],
    },
  }));
}

const { entry, prevVersion, nextVersion, latestVersion, diffEvents } = Astro.props;
const { version, items, summary } = entry.data;

// 差分ステータス算出
const removedEvent = diffEvents.find((e: DiffEvent) => e.type === 'version_removed');
const isRemoved = !!removedEvent;
const removedDate = removedEvent ? formatDiffDateTime(removedEvent.detected_at) : '';
const itemChangeEvents = diffEvents.filter((e: DiffEvent) => e.type === 'items_changed');
const hasItemChanges = itemChangeEvents.length > 0;

// メタタグ用 description: summary があれば使用、なければ変更項目数を含めた詳細テキスト
const MIN_DESC_LENGTH = 120;
const rawDescription =
  summary ??
  `Claude Code v${version}のアップデート内容(${items.length}件の変更項目)をAIが分析。新機能・バグ修正・改善点の詳細とユーザーへの具体的な恩恵を日本語で分かりやすく解説しています。`;
const description =
  rawDescription.length < MIN_DESC_LENGTH
    ? `${rawDescription} Claude Code v${version}の変更点をAIが日本語で分かりやすく解説します。`
    : rawDescription;

// summaryのバッククォートをHTMLコードタグに変換
const formattedSummary = summary ? formatChangelogContent(summary) : undefined;

const groupMap = new Map<string, typeof items>();
for (const item of items) {
  const key = item.prefix;
  if (!groupMap.has(key)) {
    groupMap.set(key, []);
  }
  const group = groupMap.get(key);
  if (group) {
    group.push(item);
  }
}

const prefixGroups = [...groupMap.entries()]
  .sort(([a], [b]) => getPrefixSortOrder(a) - getPrefixSortOrder(b))
  .map(([prefix, groupItems]) => ({
    prefix,
    label: PREFIX_LABELS[prefix as Prefix] ?? prefix,
    items: groupItems,
  }));

// フラットリスト(件数表示用)
const totalItemCount = items.length;
---

<Layout
  title={`Claude Code v${version} の変更点 - ${items.length}件の新機能・バグ修正を日本語解説`}
  description={description}
  jsonLd={{ type: 'article' }}
  breadcrumbs={[
    { name: 'トップ', url: import.meta.env.SITE },
    { name: '変更履歴', url: `${import.meta.env.SITE}/changelog` },
    {
      name: `v${version}`,
      url: `${import.meta.env.SITE}/changelog/v${version}`,
    },
  ]}
>
  <div class='max-w-6xl mx-auto px-4 sm:px-6 pt-8 sm:pt-10 pb-24' data-pagefind-body>
    <nav
      class='flex flex-wrap items-center justify-between gap-x-6 gap-y-2'
      aria-label='パンくずリスト'
      data-pagefind-ignore
    >
      <BackLink href='/'>バージョン一覧に戻る</BackLink>
      {version !== latestVersion && (
        <a
          href={`/changelog/v${latestVersion}`}
          class='inline-flex items-center gap-1.5 min-h-10 text-sm text-accent-text underline-offset-4 hover:underline'
        >
          最新版 v{latestVersion} を読む
          <Icon name='chevron-right' class='w-4 h-4 shrink-0' />
        </a>
      )}
    </nav>

    <header class='mt-8 sm:mt-12 pb-10 sm:pb-14 border-b border-rule'>
      <h1
        class='text-[clamp(3.25rem,8vw,7.5rem)] font-bold tabular-nums leading-[0.95] tracking-[-0.03em] text-accent-display'
        data-pagefind-meta='title'
      >
        <span class='sr-only'>Claude Code </span>v{version}
      </h1>
      <div class='mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-ink-2'>
        <p class='tabular-nums'>変更項目 {totalItemCount} 件</p>
        <a
          href={`https://github.com/anthropics/claude-code/blob/main/CHANGELOG.md#${version.replace(/\./g, '')}`}
          target='_blank'
          rel='noopener noreferrer'
          class='inline-flex items-center gap-1 min-h-10 text-accent-text underline-offset-4 hover:underline'
        >
          公式 CHANGELOG.md
          <Icon name='external-link' class='w-3.5 h-3.5' />
        </a>
        {isRemoved && (
          <span class='rounded-sm bg-paper-3 px-2 py-0.5 text-xs text-ink'>
            {removedDate} 公式のCHANGELOG.mdから削除
          </span>
        )}
        {hasItemChanges && (
          <>
            <Button
              type='button'
              popovertarget='changelog-history-popover'
              variant='ghost'
              size='sm'
              class='changelog-history-trigger min-h-10 px-2 -mx-2 font-normal'
            >
              公式のCHANGELOG.mdでの変更履歴
              <Icon name='chevron-down' class='w-3.5 h-3.5' />
            </Button>
            <div
              id='changelog-history-popover'
              popover
              class='changelog-history-popover p-5 rounded-lg bg-paper text-ink shadow-xl max-w-md w-[min(90vw,28rem)] max-h-[70dvh] overflow-y-auto'
            >
              <div class='flex items-center justify-between mb-3 pb-2 border-b border-rule'>
                <p class='text-sm font-semibold'>公式のCHANGELOG.mdでの変更履歴</p>
                <Button
                  type='button'
                  popovertarget='changelog-history-popover'
                  popovertargetaction='hide'
                  variant='ghost'
                  size='icon-sm'
                  class='rounded-md text-muted'
                  aria-label='閉じる'
                >
                  <Icon name='close' class='w-4 h-4' />
                </Button>
              </div>
              <div class='space-y-3 text-sm text-ink-2'>
                {itemChangeEvents.map((event: DiffEvent) => (
                  <div>
                    <p class='font-semibold text-ink tabular-nums'>
                      {formatDiffDateTime(event.detected_at)}
                      {event.items_added.length > 0 && (
                        <span class='text-success ml-2'>+{event.items_added.length}件追加</span>
                      )}
                      {event.items_removed.length > 0 && (
                        <span class='text-error ml-2'>-{event.items_removed.length}件削除</span>
                      )}
                    </p>
                    {event.items_added.length > 0 && (
                      <ul class='mt-1 space-y-0.5'>
                        {event.items_added.map((item: string) => (
                          <li class='text-success text-xs'>+ {item}</li>
                        ))}
                      </ul>
                    )}
                    {event.items_removed.length > 0 && (
                      <ul class='mt-1 space-y-0.5'>
                        {event.items_removed.map((item: string) => (
                          <li class='text-error text-xs'>- {item}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </>
        )}
      </div>
    </header>

    <div class='mt-10 lg:mt-12 grid lg:grid-cols-12 gap-x-12 gap-y-10'>
      <aside class='lg:col-span-3' data-pagefind-ignore>
        <div class='lg:sticky lg:top-[calc(var(--nav-height)+var(--space-lg))] space-y-8'>
          <PrefixTableOfContents groups={prefixGroups} />
          <Button href='/notify' shape='pill' variant='outline' data-cta='notify'>
            <Icon name='bell' class='w-4 h-4' />
            更新通知を受け取る
          </Button>
        </div>
      </aside>

      <div class='lg:col-span-9 min-w-0 max-w-[72ch] space-y-14'>
        {summary && (
          <p
            class='text-[17px] leading-[1.9] text-ink'
            data-pagefind-meta='description'
            set:html={formattedSummary}
          />
        )}
        {prefixGroups.map((group) => {
          const { style, icon: iconPath } = getPrefixPresentation(group.prefix);
          return (
            <section id={`prefix-${group.prefix.toLowerCase()}`}>
              <div class='sticky top-(--nav-height) z-10 flex items-center gap-3 bg-paper py-3 border-b-2 border-ink'>
                <h2 class='flex flex-wrap items-center gap-3 font-sans text-lg font-bold text-ink wrap-break-word min-w-0'>
                  <span
                    class={`inline-flex items-center justify-center size-6 rounded-sm ${style}`}
                    title={group.prefix}
                  >
                    {iconPath && (
                      <svg
                        class='w-3.5 h-3.5'
                        fill='none'
                        viewBox='0 0 24 24'
                        stroke='currentColor'
                        stroke-width='2.5'
                        aria-hidden='true'
                      >
                        <path stroke-linecap='round' stroke-linejoin='round' d={iconPath} />
                      </svg>
                    )}
                  </span>
                  <span>{group.label}</span>
                  <span class='sr-only'>({group.prefix})</span>
                </h2>
                <span class='ml-auto text-sm text-muted tabular-nums'>{group.items.length}件</span>
              </div>
              <div>
                {group.items.map((item) => (
                  <ChangelogItemCard item={item} anchorId={`item-${item.id}`} />
                ))}
              </div>
            </section>
          );
        })}

        <div id='share-section' class='flex flex-wrap items-center gap-3 pt-6 border-t border-rule'>
          <Button
            id='web-share-btn'
            type='button'
            hidden
            variant='outline'
            size='sm'
            shape='pill'
            class='px-4'
            aria-label='シェア'
          >
            <Icon name='share' class='w-3.5 h-3.5' aria-hidden='true' />
            シェアする
          </Button>
          <Button
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(`${import.meta.env.SITE}/changelog/v${version}`)}&text=${encodeURIComponent(`Claude Code v${version} の変更点`)}`}
            target='_blank'
            rel='noopener noreferrer'
            variant='outline'
            size='sm'
            shape='pill'
            aria-label='Xでシェア'
            data-share='x'
          >
            <Icon name='x-twitter' class='w-3.5 h-3.5' aria-hidden='true' />X
          </Button>
          <Button
            href={`https://b.hatena.ne.jp/entry/s/${new URL(`/changelog/v${version}`, import.meta.env.SITE).host}${new URL(`/changelog/v${version}`, import.meta.env.SITE).pathname}`}
            target='_blank'
            rel='noopener noreferrer'
            variant='outline'
            size='sm'
            shape='pill'
            aria-label='はてなブックマークに追加'
            data-share='hatena'
          >
            <Icon name='hatena-b' class='w-3.5 h-3.5' aria-hidden='true' />
            はてブ
          </Button>
          <Button
            id='copy-url-btn'
            type='button'
            variant='outline'
            size='sm'
            shape='pill'
            aria-label='URLをコピー'
          >
            <Icon name='copy' id='copy-url-icon' class='w-3.5 h-3.5' aria-hidden='true' />
            <span id='copy-url-label'>URLをコピー</span>
          </Button>
        </div>
      </div>
    </div>

    <nav
      class='mt-16 grid grid-cols-2 gap-px rounded-xl overflow-hidden bg-rule'
      aria-label='バージョンナビゲーション'
      data-pagefind-ignore
    >
      {prevVersion ? (
        <a
          href={`/changelog/v${prevVersion}`}
          class='group bg-paper-2 px-5 py-6 sm:px-8 sm:py-8 hover:bg-paper-3 transition-colors'
          data-version-nav='prev'
        >
          <span class='flex items-center gap-1 text-sm text-muted'>
            <Icon name='arrow-left' class='w-4 h-4' />
            前のバージョン
          </span>
          <span class='mt-2 block text-2xl sm:text-4xl font-semibold tabular-nums text-accent-text group-hover:text-ink transition-colors'>
            v{prevVersion}
          </span>
        </a>
      ) : (
        <span class='bg-paper-2' />
      )}
      {nextVersion ? (
        <a
          href={`/changelog/v${nextVersion}`}
          class='group bg-paper-2 px-5 py-6 sm:px-8 sm:py-8 text-right hover:bg-paper-3 transition-colors'
          data-version-nav='next'
        >
          <span class='flex items-center justify-end gap-1 text-sm text-muted'>
            次のバージョン
            <Icon name='chevron-right' class='w-4 h-4' />
          </span>
          <span class='mt-2 block text-2xl sm:text-4xl font-semibold tabular-nums text-accent-text group-hover:text-ink transition-colors'>
            v{nextVersion}
          </span>
        </a>
      ) : (
        <span class='bg-paper-2' />
      )}
    </nav>
  </div>

  <script>
    function initChangelogInteractions() {
      const version = document.querySelector<HTMLHeadingElement>('h1')?.textContent?.trim() ?? '';

      // Web Share API (対応環境のみシェアボタンを表示、フォールバックは非表示)
      const webShareBtn = document.getElementById('web-share-btn');
      if (webShareBtn instanceof HTMLButtonElement && 'share' in navigator) {
        const shareData = {
          title: `Claude Code v${version} の変更点`,
          text: `Claude Code v${version} の変更点`,
          url: location.href,
        };
        const canShareData =
          typeof navigator.canShare === 'function' ? navigator.canShare(shareData) : true;
        if (canShareData) {
          webShareBtn.hidden = false;
          // 個別シェアリンク (X / はてブ / コピー) を非表示にして統合
          document
            .querySelectorAll<HTMLElement>(
              '#share-section [data-share], #share-section #copy-url-btn',
            )
            .forEach((el) => {
              el.hidden = true;
            });
          webShareBtn.addEventListener('click', async () => {
            try {
              await navigator.share(shareData);
              window.gtag?.('event', 'share_clicked', {
                event_category: 'engagement',
                share_method: 'web_share',
                version,
              });
            } catch {
              // ユーザーキャンセル等は無視
            }
          });
        }
      }

      // URLコピーボタン
      const btn = document.getElementById('copy-url-btn');
      const label = document.getElementById('copy-url-label');
      const icon = document.getElementById('copy-url-icon');
      if (btn && label && icon) {
        btn.addEventListener('click', async () => {
          await navigator.clipboard.writeText(location.href);
          window.gtag?.('event', 'share_clicked', {
            event_category: 'engagement',
            share_method: 'copy_url',
            version,
          });
          label.textContent = 'コピーしました';
          icon.innerHTML =
            '<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>';
          setTimeout(() => {
            label.textContent = 'URLをコピー';
            icon.innerHTML =
              '<path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>';
          }, 2000);
        });
      }

      // シェアリンク (X / はてブ)
      document.querySelectorAll<HTMLAnchorElement>('[data-share]').forEach((el) => {
        el.addEventListener('click', () => {
          window.gtag?.('event', 'share_clicked', {
            event_category: 'engagement',
            share_method: el.dataset.share,
            version,
          });
        });
      });

      // 通知CTA
      document
        .querySelector<HTMLAnchorElement>('[data-cta="notify"]')
        ?.addEventListener('click', () => {
          window.gtag?.('event', 'notify_cta_clicked', {
            event_category: 'engagement',
            location: 'changelog_detail',
            version,
          });
        });

      // 前後バージョンナビゲーション
      document.querySelectorAll<HTMLAnchorElement>('[data-version-nav]').forEach((el) => {
        el.addEventListener('click', () => {
          window.gtag?.('event', 'version_nav_clicked', {
            event_category: 'engagement',
            direction: el.dataset.versionNav,
            from_version: version,
          });
        });
      });

      // スクロール深度 (25% / 50% / 75% / 100%)
      const milestones = [25, 50, 75, 100];
      const fired = new Set<number>();
      function onScroll() {
        const scrolled = window.scrollY + window.innerHeight;
        const total = document.documentElement.scrollHeight;
        const pct = Math.round((scrolled / total) * 100);
        for (const milestone of milestones) {
          if (pct >= milestone && !fired.has(milestone)) {
            fired.add(milestone);
            window.gtag?.('event', 'scroll_depth', {
              event_category: 'engagement',
              depth_percent: milestone,
              version,
            });
          }
        }
        if (fired.size === milestones.length) {
          window.removeEventListener('scroll', onScroll, {
            passive: true,
          } as AddEventListenerOptions);
        }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    initChangelogInteractions();
  </script>

  <style>
    /* 開閉アニメーション (Popover API)。位置指定とは独立して translate を使用 */
    .changelog-history-popover {
      opacity: 0;
      translate: 0 -0.5rem;
      transition:
        opacity 0.18s ease-out,
        translate 0.18s ease-out,
        overlay 0.18s allow-discrete,
        display 0.18s allow-discrete;
    }
    .changelog-history-popover:popover-open {
      opacity: 1;
      translate: 0 0;
    }
    @starting-style {
      .changelog-history-popover:popover-open {
        opacity: 0;
        translate: 0 -0.5rem;
      }
    }

    /* Anchor Positioning 対応ブラウザではトリガー直下にドロップダウン表示。
       未対応ブラウザは UA デフォルト (inset:0 + margin:auto) の中央寄せにフォールバック */
    @supports (anchor-name: --x) {
      .changelog-history-trigger {
        anchor-name: --changelog-history-anchor;
      }
      .changelog-history-popover {
        position: fixed;
        position-anchor: --changelog-history-anchor;
        inset: auto;
        top: anchor(bottom);
        left: anchor(left);
        margin-top: 0.5rem;
        /* 下に収まらなければ上へフリップ */
        position-try-fallbacks: flip-block;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .changelog-history-popover {
        transition: none;
        translate: none;
      }
    }
  </style>
</Layout>
