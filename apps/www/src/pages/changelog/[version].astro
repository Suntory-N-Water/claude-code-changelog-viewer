---
import { getCollection } from 'astro:content';
import ChangelogItemCard from '../../components/changelog/ChangelogItemCard.astro';
import PrefixTableOfContents from '../../components/changelog/PrefixTableOfContents.astro';
import Layout from '../../layouts/Layout.astro';
import { formatChangelogContent } from '../../lib/format-changelog-content';
import { extractChangelogData, getLinkedAreas } from '../../lib/feature-area';
import {
  PREFIX_DEFAULT_STYLE,
  PREFIX_ICONS,
  PREFIX_LABELS,
  PREFIX_STYLES,
  getPrefixSortOrder,
} from '../../lib/prefix';
import {
  type DiffEvent,
  buildDiffMap,
  formatDiffDateTime,
} from '../../lib/changelog-diff';
import { semverCompareDesc } from '../../lib/semver';

export async function getStaticPaths() {
  const allChangelogs = await getCollection('changelog');

  // GitHub API で Releases のバージョン一覧を取得(1リクエスト固定)
  let releaseVersions: Set<string>;
  try {
    const res = await fetch(
      'https://api.github.com/repos/anthropics/claude-code/releases?per_page=100',
      { headers: { 'User-Agent': 'claude-code-changelog-viewer' } },
    );
    if (!res.ok) {
      throw new Error(`GitHub API: ${res.status}`);
    }
    const releases: Array<{ tag_name: string }> = await res.json();
    releaseVersions = new Set(
      releases.map((r) => r.tag_name.replace(/^v/, '')),
    );
  } catch {
    releaseVersions = new Set();
  }

  // ページが存在する feature_area を算出
  const linkedAreas = getLinkedAreas(extractChangelogData(allChangelogs));

  // 差分データ読み込み
  const diffEntries = await getCollection('diff');
  const diffMap = buildDiffMap(diffEntries);

  // バージョン降順ソート
  const sorted = [...allChangelogs].sort((a, b) =>
    semverCompareDesc(a.data.version, b.data.version),
  );

  return sorted.map((entry, i) => ({
    params: { version: `v${entry.data.version}` },
    props: {
      entry,
      hasGitHubRelease: releaseVersions.has(entry.data.version),
      prevVersion: sorted[i + 1]?.data.version ?? null,
      nextVersion: sorted[i - 1]?.data.version ?? null,
      linkedAreas,
      diffEvents: diffMap.get(`v${entry.data.version}`) ?? [],
    },
  }));
}

const {
  entry,
  hasGitHubRelease,
  prevVersion,
  nextVersion,
  linkedAreas,
  diffEvents,
} = Astro.props;
const { version, items, summary } = entry.data;

// 差分ステータス算出
const removedEvent = diffEvents.find(
  (e: DiffEvent) => e.type === 'version_removed',
);
const isRemoved = !!removedEvent;
const removedDate = removedEvent
  ? formatDiffDateTime(removedEvent.detected_at)
  : '';
const itemChangeEvents = diffEvents.filter(
  (e: DiffEvent) => e.type === 'items_changed',
);
const hasItemChanges = itemChangeEvents.length > 0;

// メタタグ用 description: summary があれば使用、なければ変更項目数を含めた詳細テキスト
const MIN_DESC_LENGTH = 120;
const rawDescription =
  summary ??
  `Claude Code v${version}のアップデート内容(${items.length}件の変更項目)をAIが分析。新機能・バグ修正・改善点の詳細とユーザーへの具体的な恩恵を日本語で分かりやすく解説しています。`;
const description =
  rawDescription.length < MIN_DESC_LENGTH
    ? `${rawDescription} Claude Code v${version}の変更点をAIが日本語で分かりやすく解説します。`
    : rawDescription;

// summaryのバッククォートをHTMLコードタグに変換
const formattedSummary = summary ? formatChangelogContent(summary) : undefined;

// prefix でグルーピング + グループ内 importance_score 降順
const itemsWithIndex = items.map((item, index) => ({
  item,
  originalIndex: index,
}));

const groupMap = new Map<string, typeof itemsWithIndex>();
for (const entry of itemsWithIndex) {
  const key = entry.item.prefix;
  if (!groupMap.has(key)) {
    groupMap.set(key, []);
  }
  const group = groupMap.get(key);
  if (group) {
    group.push(entry);
  }
}
for (const group of groupMap.values()) {
  group.sort((a, b) => b.item.importance_score - a.item.importance_score);
}

const prefixGroups = [...groupMap.entries()]
  .sort(([a], [b]) => getPrefixSortOrder(a) - getPrefixSortOrder(b))
  .map(([prefix, groupItems]) => ({
    prefix,
    label: PREFIX_LABELS[prefix] ?? prefix,
    items: groupItems,
  }));

// フラットリスト(件数表示用)
const totalItemCount = items.length;
---

<Layout
  title={`Claude Code v${version} の変更点 - ${items.length}件のアップデート内容を日本語解説`}
  description={description}
  image={`${import.meta.env.SITE}/changelog/og/v${version}.png`}
  jsonLd={{ type: 'article', version, summary }}
  breadcrumbs={[
    { name: 'トップ', url: import.meta.env.SITE },
    {
      name: `v${version}`,
      url: `${import.meta.env.SITE}/changelog/v${version}`,
    },
  ]}
>
  <div class='min-h-dvh py-12 sm:py-16 px-4' data-pagefind-body>
    <div class='max-w-4xl mx-auto'>
      <nav class='mb-8' aria-label='パンくずリスト' data-pagefind-ignore>
        <a
          href='/'
          data-direction='back'
          class='text-sm text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline inline-flex items-center gap-1 transition-colors'
        >
          <svg
            class='w-4 h-4'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M15 19l-7-7 7-7'></path>
          </svg>
          バージョン一覧に戻る
        </a>
      </nav>

      <header class='mb-10'>
        <div class='flex flex-wrap items-center gap-3 mb-3'>
          <h1
            class='text-3xl sm:text-4xl font-bold text-balance text-[hsl(var(--cc-main-black))]'
            transition:name={`version-title-${version}`}
            data-pagefind-meta='title'
          >
            Claude Code v{version}
          </h1>
          {
            isRemoved && (
              <span class='inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-[hsl(var(--cc-gray))] text-[hsl(var(--cc-main-black))]'>
                公式のCHANGELOG.mdから削除済み
              </span>
            )
          }
          {
            !isRemoved && hasItemChanges && (
              <span class='inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-[hsl(var(--cc-gray))] text-[hsl(var(--cc-main-black))]'>
                公式のCHANGELOG.mdで更新あり
              </span>
            )
          }
        </div>
        <div
          class='flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-600'
        >
          <p>変更項目: {totalItemCount}件</p>
          {
            hasGitHubRelease && (
              <a
                href={`https://github.com/anthropics/claude-code/releases/tag/v${version}`}
                target='_blank'
                rel='noopener noreferrer'
                class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline inline-flex items-center gap-1 transition-colors'
              >
                GitHub Release
                <svg
                  class='w-3.5 h-3.5'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'
                  aria-hidden='true'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25'
                  />
                </svg>
              </a>
            )
          }
        </div>
        {
          isRemoved && (
            <p class='text-sm text-[hsl(var(--cc-main-black)/0.6)] mt-1'>
              この内容は公式のCHANGELOG.mdから削除される前に取得したものです(
              {removedDate}
              検出)
            </p>
          )
        }
        {
          itemChangeEvents.length > 0 && (
            <details class='text-sm text-gray-600 mt-2'>
              <summary class='cursor-pointer hover:text-[hsl(var(--cc-main-orange))]'>
                公式のCHANGELOG.mdでの変更履歴
              </summary>
              <div class='mt-2 space-y-2 pl-4 border-l-2 border-[hsl(var(--cc-gray))]'>
                {itemChangeEvents.map((event: DiffEvent) => (
                  <div>
                    <p class='font-medium text-gray-700'>
                      {formatDiffDateTime(event.detected_at)}
                      {event.items_added.length > 0 && (
                        <span class='text-green-700 ml-2'>
                          +{event.items_added.length}件追加
                        </span>
                      )}
                      {event.items_removed.length > 0 && (
                        <span class='text-red-700 ml-2'>
                          -{event.items_removed.length}件削除
                        </span>
                      )}
                    </p>
                    {event.items_added.length > 0 && (
                      <ul class='mt-1 space-y-0.5'>
                        {event.items_added.map((item: string) => (
                          <li class='text-green-700 text-xs'>+ {item}</li>
                        ))}
                      </ul>
                    )}
                    {event.items_removed.length > 0 && (
                      <ul class='mt-1 space-y-0.5'>
                        {event.items_removed.map((item: string) => (
                          <li class='text-red-700 text-xs'>- {item}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            </details>
          )
        }
      </header>

      {
        summary && (
          <div class='mb-10 p-6 bg-linear-to-br from-[hsl(var(--cc-main-orange)/0.05)] to-[hsl(var(--cc-main-orange)/0.02)] border border-[hsl(var(--cc-gray))] rounded-lg'>
            <div class='border-l-4 border-[hsl(var(--cc-main-orange))] pl-4'>
              <h2 class='text-xl font-bold text-[hsl(var(--cc-main-black))] mb-3'>
                このバージョンの概要
              </h2>
              <p
                class='text-base leading-relaxed text-[hsl(var(--cc-main-black))] text-pretty'
                data-pagefind-meta='description'
                set:html={formattedSummary}
              />
            </div>
            <PrefixTableOfContents groups={prefixGroups} />
          </div>
        )
      }

      <div class='space-y-10'>
        {
          prefixGroups.map((group) => {
            const style = PREFIX_STYLES[group.prefix] || PREFIX_DEFAULT_STYLE;
            const iconPath = PREFIX_ICONS[group.prefix];
            return (
              <section id={`prefix-${group.prefix.toLowerCase()}`}>
                <div class='sticky top-12 z-10 bg-[hsl(var(--cc-main-white)/0.95)] backdrop-blur-sm py-3 -mx-4 px-4 mb-4 border-b border-[hsl(var(--cc-gray)/0.3)]'>
                  <h3 class='flex items-center gap-2 text-lg font-bold text-[hsl(var(--cc-main-black))]'>
                    <span
                      class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold uppercase ${style}`}
                    >
                      {iconPath && (
                        <svg
                          class='w-3.5 h-3.5'
                          fill='none'
                          viewBox='0 0 24 24'
                          stroke='currentColor'
                          stroke-width='2.5'
                          aria-hidden='true'
                        >
                          <path
                            stroke-linecap='round'
                            stroke-linejoin='round'
                            d={iconPath}
                          />
                        </svg>
                      )}
                      {group.prefix}
                    </span>
                    <span>{group.label}</span>
                    <span class='text-sm font-normal text-gray-500'>
                      ({group.items.length}件)
                    </span>
                  </h3>
                </div>
                <div class='space-y-6'>
                  {group.items.map(({ item, originalIndex }) => (
                    <ChangelogItemCard
                      item={item}
                      anchorId={`item-${originalIndex}`}
                      linkedAreas={linkedAreas}
                    />
                  ))}
                </div>
              </section>
            );
          })
        }
      </div>

      <aside
        class='mt-10 p-5 bg-[hsl(var(--cc-main-orange)/0.04)] border border-[hsl(var(--cc-gray))] rounded-lg flex flex-col sm:flex-row items-center justify-between gap-4'
      >
        <p class='text-sm text-gray-600'>
          Claude Codeの新バージョンを見逃さない
        </p>
        <a
          href='/notify'
          class='inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-[hsl(var(--cc-main-orange))] text-sm text-white hover:bg-[hsl(var(--cc-orange-hover))] transition-colors'
        >
          <svg
            class='w-4 h-4'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9'
            ></path>
          </svg>
          Discordで更新通知を受け取る
        </a>
      </aside>

      <div class='mt-8 flex items-center gap-3'>
        <span class='text-sm text-gray-500'>シェア:</span>
        <a
          href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(`${import.meta.env.SITE}/changelog/v${version}`)}&text=${encodeURIComponent(`Claude Code v${version} の変更点`)}`}
          target='_blank'
          rel='noopener noreferrer'
          class='inline-flex items-center gap-1 px-3 py-1.5 rounded-full border border-[hsl(var(--cc-gray))] text-xs text-gray-600 hover:border-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-main-orange))] transition-colors'
          aria-label='Xでシェア'
        >
          <svg
            class='w-3.5 h-3.5'
            viewBox='0 0 24 24'
            fill='currentColor'
            aria-hidden='true'
          >
            <path
              d='M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'
            ></path>
          </svg>
          X
        </a>
        <a
          href={`https://b.hatena.ne.jp/entry/s/${new URL(`/changelog/v${version}`, import.meta.env.SITE).host}${new URL(`/changelog/v${version}`, import.meta.env.SITE).pathname}`}
          target='_blank'
          rel='noopener noreferrer'
          class='inline-flex items-center gap-1 px-3 py-1.5 rounded-full border border-[hsl(var(--cc-gray))] text-xs text-gray-600 hover:border-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-main-orange))] transition-colors'
          aria-label='はてなブックマークに追加'
        >
          <svg
            class='w-3.5 h-3.5'
            viewBox='0 0 24 24'
            fill='currentColor'
            aria-hidden='true'
          >
            <path
              d='M20.47 2H3.53A1.45 1.45 0 002 3.38v17.24A1.45 1.45 0 003.53 22h16.94A1.45 1.45 0 0022 20.62V3.38A1.45 1.45 0 0020.47 2zM8.6 17.05a3.64 3.64 0 01-1.34.62 6.4 6.4 0 01-1.67.21H3.28V6.12h2.39a5.3 5.3 0 011.41.18 3 3 0 011.06.56 2.38 2.38 0 01.66.94 3.44 3.44 0 01.23 1.28 2.68 2.68 0 01-.29 1.29 2.59 2.59 0 01-.85.9 2.84 2.84 0 011.13 1.09 3.42 3.42 0 01.39 1.68 3.68 3.68 0 01-.31 1.52 3.3 3.3 0 01-.9 1.13zm-.66-7.05a1.35 1.35 0 00-.54-.73 1.72 1.72 0 00-.45-.23 2.2 2.2 0 00-.59-.07h-.62v3h.56a2.3 2.3 0 001-.2 1.27 1.27 0 00.58-.54 1.71 1.71 0 00.19-.83 1.73 1.73 0 00-.13-.4zm.25 4a1.67 1.67 0 00-.63-.82 1.89 1.89 0 00-.54-.26 2.87 2.87 0 00-.72-.08h-.72v3.4h.87a2.34 2.34 0 001.15-.28 1.54 1.54 0 00.64-.74 2.38 2.38 0 00.2-1 2.17 2.17 0 00-.25-.22zM15.3 17.88h-2.08v-2.38h2.08zm5.43 0h-2.08v-2.38h2.08z'
            ></path>
          </svg>
          はてブ
        </a>
      </div>

      <nav
        class='mt-8 pt-8 border-t border-[hsl(var(--cc-gray))] flex justify-between items-center'
        aria-label='バージョンナビゲーション'
      >
        {
          prevVersion ? (
            <a
              href={`/changelog/v${prevVersion}`}
              class='inline-flex items-center gap-1 text-sm text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] transition-colors'
            >
              <svg
                class='w-4 h-4'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
                aria-hidden='true'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M15 19l-7-7 7-7'
                />
              </svg>
              v{prevVersion}
            </a>
          ) : (
            <span />
          )
        }
        {
          nextVersion ? (
            <a
              href={`/changelog/v${nextVersion}`}
              class='inline-flex items-center gap-1 text-sm text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] transition-colors'
            >
              v{nextVersion}
              <svg
                class='w-4 h-4'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
                aria-hidden='true'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M9 5l7 7-7 7'
                />
              </svg>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </div>
  </div>
</Layout>
