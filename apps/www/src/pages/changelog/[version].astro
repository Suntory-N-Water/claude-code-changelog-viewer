---
import { getCollection } from 'astro:content';
import ChangelogItemCard from '../../components/changelog/ChangelogItemCard.astro';
import Layout from '../../layouts/Layout.astro';
import { formatChangelogContent } from '../../lib/changelog';

export async function getStaticPaths() {
  const allChangelogs = await getCollection('changelog');

  // GitHub API で Releases のバージョン一覧を取得(1リクエスト固定)
  let releaseVersions: Set<string>;
  try {
    const res = await fetch(
      'https://api.github.com/repos/anthropics/claude-code/releases?per_page=100',
      { headers: { 'User-Agent': 'claude-code-changelog-viewer' } },
    );
    if (!res.ok) {
      throw new Error(`GitHub API: ${res.status}`);
    }
    const releases: Array<{ tag_name: string }> = await res.json();
    releaseVersions = new Set(
      releases.map((r) => r.tag_name.replace(/^v/, '')),
    );
  } catch {
    releaseVersions = new Set();
  }

  return allChangelogs.map((entry) => ({
    params: { version: `v${entry.data.version}` },
    props: {
      entry,
      hasGitHubRelease: releaseVersions.has(entry.data.version),
    },
  }));
}

const { entry, hasGitHubRelease } = Astro.props;
const { version, items, summary } = entry.data;

// メタタグ用 description: summary があれば使用、なければデフォルトテキスト
const description = summary ?? `Claude Code v${version}の変更内容と恩恵の解説`;

// summaryのバッククォートをHTMLコードタグに変換
const formattedSummary = summary ? formatChangelogContent(summary) : undefined;

// 元のインデックスを保持しつつ重要度降順でソート
const sortedItems = items
  .map((item, index) => ({ item, originalIndex: index }))
  .sort((a, b) => b.item.importance_score - a.item.importance_score);
---

<Layout
  title={`Claude Code v${version} 変更履歴`}
  description={description}
  image={`${import.meta.env.SITE}/changelog/v${version}/og.png`}
>
  <div class='min-h-dvh py-12 sm:py-16 px-4'>
    <div class='max-w-4xl mx-auto'>
      <nav class='mb-8' aria-label='パンくずリスト'>
        <a
          href='/'
          data-direction='back'
          class='text-sm text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline inline-flex items-center gap-1 transition-colors'
        >
          <svg
            class='w-4 h-4'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M15 19l-7-7 7-7'></path>
          </svg>
          バージョン一覧に戻る
        </a>
      </nav>

      <header class='mb-10'>
        <h1
          class='text-3xl sm:text-4xl font-bold text-balance text-[hsl(var(--cc-main-black))] mb-3'
          transition:name={`version-title-${version}`}
        >
          Claude Code v{version}
        </h1>
        <div
          class='flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-600'
        >
          <p>変更項目: {sortedItems.length}件</p>
          {
            hasGitHubRelease && (
              <a
                href={`https://github.com/anthropics/claude-code/releases/tag/v${version}`}
                target='_blank'
                rel='noopener noreferrer'
                class='text-[hsl(var(--cc-main-orange))] hover:text-[hsl(var(--cc-orange-hover))] hover:underline inline-flex items-center gap-1 transition-colors'
              >
                GitHub Release
                <svg
                  class='w-3.5 h-3.5'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'
                  aria-hidden='true'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25'
                  />
                </svg>
              </a>
            )
          }
        </div>
      </header>

      {
        entry.data.summary && (
          <div class='mb-10 p-6 bg-linear-to-br from-[hsl(var(--cc-main-orange)/0.05)] to-[hsl(var(--cc-main-orange)/0.02)] border border-[hsl(var(--cc-gray))] rounded-lg'>
            <div class='border-l-4 border-[hsl(var(--cc-main-orange))] pl-4'>
              <h2 class='text-xl font-bold text-[hsl(var(--cc-main-black))] mb-3'>
                このバージョンの概要
              </h2>
              <p
                class='text-base leading-relaxed text-[hsl(var(--cc-main-black))] text-pretty'
                set:html={formattedSummary}
              />
            </div>
          </div>
        )
      }

      <div class='space-y-6'>
        {
          sortedItems.map(({ item, originalIndex }) => (
            <ChangelogItemCard item={item} anchorId={`item-${originalIndex}`} />
          ))
        }
      </div>
    </div>
  </div>
</Layout>
