---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import MobileMenu from '../components/MobileMenu.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import SearchModal from '../components/SearchModal.astro';
import { SITE_TITLE } from '../lib/constants';
import { escapeJsonForScript } from '../lib/escape-html';
import {
  type BreadcrumbItem,
  type FAQItem,
  generateGraphJsonLd,
} from '../lib/json-ld';

type JsonLdData =
  | { type: 'website' }
  | {
      type: 'article';
      version: string;
      summary?: string;
      datePublished?: string;
    }
  | { type: 'page' }
  | { type: 'collection'; title: string; description: string };

type Props = {
  title: string;
  description?: string;
  image?: string;
  jsonLd?: JsonLdData;
  breadcrumbs?: BreadcrumbItem[];
  faqItems?: FAQItem[];
};

const { title, description, image, jsonLd, breadcrumbs, faqItems } =
  Astro.props;
const isDocsPage = Astro.url.pathname.startsWith('/docs');
const isReferencePage = Astro.url.pathname.startsWith('/reference');
const defaultDescription =
  'Claude Codeの変更履歴をAIが分析。各アップデートの新機能・バグ修正・改善点を日本語で分かりやすく解説し、ユーザーへの具体的な恩恵をまとめています。';
const pageDescription = description || defaultDescription;
const siteUrl = import.meta.env.SITE;
const canonicalUrl = new URL(
  Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/',
  siteUrl,
).toString();
const ogImage = image || `${siteUrl}/og-image.png`;

// JSON-LD 生成(単一 @graph)
let graphJsonLd: string | null = null;

if (jsonLd?.type === 'website') {
  graphJsonLd = escapeJsonForScript(
    JSON.stringify(
      generateGraphJsonLd(
        { type: 'website', siteUrl, title, description: pageDescription },
        breadcrumbs,
        faqItems,
      ),
    ),
  );
} else if (jsonLd?.type === 'article') {
  graphJsonLd = escapeJsonForScript(
    JSON.stringify(
      generateGraphJsonLd(
        {
          type: 'article',
          siteUrl,
          title,
          description: pageDescription,
          url: canonicalUrl,
          version: jsonLd.version,
          datePublished: jsonLd.datePublished,
        },
        breadcrumbs,
      ),
    ),
  );
} else if (jsonLd?.type === 'collection') {
  graphJsonLd = escapeJsonForScript(
    JSON.stringify(
      generateGraphJsonLd(
        {
          type: 'collection',
          siteUrl,
          title: jsonLd.title,
          description: jsonLd.description,
          url: canonicalUrl,
        },
        breadcrumbs,
      ),
    ),
  );
} else if (jsonLd?.type === 'page') {
  graphJsonLd = escapeJsonForScript(
    JSON.stringify(
      generateGraphJsonLd(
        {
          type: 'page',
          siteUrl,
          title,
          description: pageDescription,
          url: canonicalUrl,
        },
        breadcrumbs,
      ),
    ),
  );
}
---

<!doctype html>
<html lang='ja'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='description' content={pageDescription} />
    <meta
      name='google-site-verification'
      content='IxfdBiGbDvwfMwQwWqxxx7wvaw0k2P8o-DOxfpsIx-0'
    />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='apple-touch-icon' href='/icon.png' />
    <link rel='canonical' href={canonicalUrl} />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <link rel='nlweb' type='text/plain' href='/llms.txt' />
    <title>{title}</title>

    <meta
      name='robots'
      content='index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'
    />
    <link
      rel='alternate'
      type='application/rss+xml'
      title={SITE_TITLE}
      href='/rss.xml'
    />

    <meta
      property='og:type'
      content={jsonLd?.type === 'article' ? 'article' : 'website'}
    />
    <meta property='og:site_name' content={SITE_TITLE} />
    <meta property='og:url' content={canonicalUrl} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={pageDescription} />
    <meta property='og:image' content={ogImage} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:locale' content='ja_JP' />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={pageDescription} />
    <meta name='twitter:image' content={ogImage} />

    {
      graphJsonLd && (
        <script is:inline type='application/ld+json' set:html={graphJsonLd} />
      )
    }

    <script
      async
      is:inline
      src='https://www.googletagmanager.com/gtag/js?id=G-2815S79087'></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-2815S79087');
    </script>

    <ClientRouter />
    <script is:inline>
      let isBackNavigation = false;

      window.addEventListener('popstate', () => {
        isBackNavigation = true;
      });

      document.addEventListener('click', (e) => {
        const link =
          e.target instanceof Element
            ? e.target.closest('a[data-direction="back"]')
            : null;
        if (link) {
          isBackNavigation = true;
        }
      });

      document.addEventListener('astro:before-preparation', (event) => {
        if (isBackNavigation) {
          event.direction = 'back';
        }
        isBackNavigation = false;
      });
    </script>
  </head>
  <body>
    <header
      class='sticky top-0 z-50 bg-[hsl(var(--cc-main-white)/0.95)] backdrop-blur-sm border-b border-[hsl(var(--cc-gray))]'
    >
      <nav
        class='max-w-6xl mx-auto px-4 h-12 flex items-center justify-between gap-2'
      >
        <a
          href='/'
          class='text-sm font-bold text-[hsl(var(--cc-main-black))] hover:text-[hsl(var(--cc-main-orange))] transition-colors shrink-0'
        >
          CCログ超訳
        </a>

        <div class='flex items-center gap-2'>
          <!-- デスクトップ用ナビリンク -->
          <a
            href='/docs'
            class={`hidden sm:inline text-sm transition-colors ${isDocsPage ? 'text-[hsl(var(--cc-main-orange))] font-medium' : 'text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))]'}`}
            aria-current={isDocsPage ? 'page' : undefined}
          >
            Docs 更新履歴
          </a>
          <a
            href='/reference/settings'
            class={`hidden sm:inline text-sm transition-colors ${isReferencePage ? 'text-[hsl(var(--cc-main-orange))] font-medium' : 'text-[hsl(var(--cc-main-black)/0.7)] hover:text-[hsl(var(--cc-main-orange))]'}`}
            aria-current={isReferencePage ? 'page' : undefined}
          >
            設定リファレンス
          </a>

          <SearchModal />
          <MobileMenu
            isDocsPage={isDocsPage}
            isReferencePage={isReferencePage}
          />
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
    <ScrollProgress />
    <script is:inline>
      function initHighlight() {
        const params = new URLSearchParams(window.location.search);
        if (!params.has('highlight')) {
          return;
        }
        import('/pagefind/pagefind-highlight.js').then(() => {
          new PagefindHighlight({ highlightParam: 'highlight' });
        });
      }
      initHighlight();
      document.addEventListener('astro:after-swap', initHighlight);
    </script>
  </body>
</html>
