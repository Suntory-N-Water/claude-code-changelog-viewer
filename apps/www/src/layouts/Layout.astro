---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { SITE_TITLE } from '../lib/constants';
import {
  generateWebSiteJsonLd,
  generateArticleJsonLd,
  generateCollectionPageJsonLd,
  generateBreadcrumbJsonLd,
} from '../lib/json-ld';

type JsonLdData =
  | { type: 'website' }
  | { type: 'article'; version: string; summary?: string }
  | { type: 'page' }
  | { type: 'collection'; title: string; description: string };

type BreadcrumbItem = {
  name: string;
  url: string;
};

type Props = {
  title: string;
  description?: string;
  image?: string;
  jsonLd?: JsonLdData;
  breadcrumbs?: BreadcrumbItem[];
};

const { title, description, image, jsonLd, breadcrumbs } = Astro.props;
const defaultDescription =
  'Claude Codeの全バージョンの変更履歴をAIが分析。各アップデートの新機能・バグ修正・改善点を日本語で分かりやすく解説し、ユーザーへの具体的な恩恵をまとめています。';
const pageDescription = description || defaultDescription;
const siteUrl = import.meta.env.SITE;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = image || `${siteUrl}/og-image.png`;

// JSON-LD 生成
const jsonLdScripts: string[] = [];

if (jsonLd?.type === 'website') {
  jsonLdScripts.push(
    JSON.stringify(
      generateWebSiteJsonLd({
        siteUrl,
        title,
        description: pageDescription,
      }),
    ),
  );
} else if (jsonLd?.type === 'article') {
  jsonLdScripts.push(
    JSON.stringify(
      generateArticleJsonLd({
        siteUrl,
        title,
        description: pageDescription,
        url: canonicalUrl,
        version: jsonLd.version,
      }),
    ),
  );
} else if (jsonLd?.type === 'collection') {
  jsonLdScripts.push(
    JSON.stringify(
      generateCollectionPageJsonLd({
        siteUrl,
        title: jsonLd.title,
        description: jsonLd.description,
        url: canonicalUrl,
      }),
    ),
  );
}

if (breadcrumbs && breadcrumbs.length > 0) {
  jsonLdScripts.push(JSON.stringify(generateBreadcrumbJsonLd(breadcrumbs)));
}
---

<!doctype html>
<html lang='ja'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <meta name='description' content={pageDescription} />
    <meta
      name='google-site-verification'
      content='IxfdBiGbDvwfMwQwWqxxx7wvaw0k2P8o-DOxfpsIx-0'
    />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='canonical' href={canonicalUrl} />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <title>{title}</title>

    <meta name='robots' content='index, follow' />
    <link
      rel='alternate'
      type='application/rss+xml'
      title={SITE_TITLE}
      href='/rss.xml'
    />

    <meta
      property='og:type'
      content={jsonLd?.type === 'article' ? 'article' : 'website'}
    />
    <meta property='og:site_name' content={SITE_TITLE} />
    <meta property='og:url' content={canonicalUrl} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={pageDescription} />
    <meta property='og:image' content={ogImage} />
    <meta property='og:locale' content='ja_JP' />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={pageDescription} />
    <meta name='twitter:image' content={ogImage} />

    {
      jsonLdScripts.map((script) => (
        <script is:inline type='application/ld+json' set:html={script} />
      ))
    }

    <script
      async
      is:inline
      src='https://www.googletagmanager.com/gtag/js?id=G-2815S79087'></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-2815S79087');
    </script>

    <ClientRouter />
    <script is:inline>
      let isBackNavigation = false;

      window.addEventListener('popstate', () => {
        isBackNavigation = true;
      });

      document.addEventListener('click', (e) => {
        const link =
          e.target instanceof Element
            ? e.target.closest('a[data-direction="back"]')
            : null;
        if (link) {
          isBackNavigation = true;
        }
      });

      document.addEventListener('astro:before-preparation', (event) => {
        if (isBackNavigation) {
          event.direction = 'back';
        }
        isBackNavigation = false;
      });
    </script>
  </head>
  <body>
    <header
      class='sticky top-0 z-50 bg-[hsl(var(--cc-main-white)/0.95)] backdrop-blur-sm border-b border-[hsl(var(--cc-gray))]'
    >
      <nav
        class='max-w-6xl mx-auto px-4 h-12 flex items-center justify-between'
      >
        <a
          href='/'
          class='text-sm font-bold text-[hsl(var(--cc-main-black))] hover:text-[hsl(var(--cc-main-orange))] transition-colors'
        >
          Claude Code Changelog Viewer
        </a>
        <SearchModal />
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
    <script is:inline>
      function initHighlight() {
        const params = new URLSearchParams(window.location.search);
        if (!params.has('highlight')) {
          return;
        }
        import('/pagefind/pagefind-highlight.js').then(() => {
          new PagefindHighlight({ highlightParam: 'highlight' });
        });
      }
      initHighlight();
      document.addEventListener('astro:after-swap', initHighlight);
    </script>
  </body>
</html>
