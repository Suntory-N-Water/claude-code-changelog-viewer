{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-code-changelog-viewer",
  "compatibility_date": "2026-01-30",
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "claude-code-log.com",
      "custom_domain": true
    },
    {
      "pattern": "www.claude-code-log.com",
      "custom_domain": true
    }
  ]
}
