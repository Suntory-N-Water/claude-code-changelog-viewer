{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-code-changelog-viewer",
  "workers_dev": true,
  "compatibility_date": "2026-01-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "claude-code-log.com",
      "custom_domain": true
    },
    {
      "pattern": "www.claude-code-log.com",
      "custom_domain": true
    }
  ]
}
