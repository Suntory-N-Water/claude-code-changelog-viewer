{
  "name": "www",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "sync": "bun scripts/setup-content-symlinks.ts",
    "dev": "bun scripts/setup-content-symlinks.ts && bunx --bun astro dev --host 0.0.0.0",
    "build": "bun scripts/setup-content-symlinks.ts && bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "deploy": "bun run build && wrangler deploy --minify",
    "upload": "wrangler versions upload --minify",
    "astro": "astro",
    "format": "prettier --write '**/*.astro'",
    "check": "astro check",
    "test": "AGENT=1 bun test --bail=2",
    "lhci:healthcheck": "lhci healthcheck",
    "lhci:astro": "bun run build && lhci collect --config=lighthouserc.json",
    "lhci:assert": "lhci assert --config=lighthouserc.json",
    "lhci:upload": "lhci upload --config=lighthouserc.json",
    "lhci:open": "lhci open"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@claude-code-changelog-viewer/common": "workspace:*",
    "@claude-code-changelog-viewer/types": "workspace:*",
    "@date-fns/tz": "^1.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.1.3",
    "date-fns": "^4.1.0",
    "react": "^19.2.4",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/rss": "^4.0.18",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "astro-pagefind": "^1.8.6",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.80.0"
  }
}
