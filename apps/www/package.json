{
  "name": "www",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy --minify",
    "upload": "wrangler versions upload --minify",
    "astro": "astro",
    "format": "prettier --write --log-level warn '**/*.astro'",
    "check": "astro check --minimumSeverity error --silent",
    "test": "AGENT=1 vitest run",
    "type-check": "tsc --noEmit",
    "type-check:ai": "tsc --noEmit --pretty false",
    "lhci:healthcheck": "lhci healthcheck",
    "lhci:astro": "pnpm run build && lhci collect --config=lighthouserc.json",
    "lhci:assert": "lhci assert --config=lighthouserc.json",
    "lhci:upload": "lhci upload --config=lighthouserc.json",
    "lhci:open": "lhci open"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@claude-code-changelog-viewer/common": "workspace:*",
    "@claude-code-changelog-viewer/types": "workspace:*",
    "@date-fns/tz": "^1.5.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.0.6",
    "date-fns": "^4.4.0",
    "satori": "^0.29.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.3.2",
    "astro-pagefind": "^1.8.6",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "remark-link-card-plus": "0.7.4",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "wrangler": "catalog:"
  }
}
