{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "pnpm exec astro preview",
      "startServerReadyPattern": "Preview server running",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/changelog/v2.1.227",
        "http://localhost:4321/posts/weekly/2026-w28",
        "http://localhost:4321/reference/settings/model"
      ],
      "settings": {
        "preset": "desktop",
        "maxWaitForLoad": 60000,
        "locale": "ja"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.7 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.8 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
