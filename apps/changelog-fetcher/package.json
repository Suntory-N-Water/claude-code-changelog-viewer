{
  "name": "changelog-fetcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "tsx src/parse-changelog.ts",
    "analyze": "tsx src/analyze-changelog.ts",
    "infer": "tsx src/infer-benefits.ts",
    "infer:no-ai": "tsx src/infer-benefits.ts",
    "generate-settings": "tsx src/generate-settings-reference.ts",
    "generate-settings:no-ai": "SETTINGS_NO_AI=1 tsx src/generate-settings-reference.ts",
    "fetch:builtins": "tsx src/fetch-builtin-data.ts",
    "fetch:issues": "tsx src/fetch-issue-corpus.ts",
    "build:issues-embeddings": "tsx src/build-issues-embeddings.ts",
    "tie:issues": "tsx src/tie-issue.ts",
    "test": "AGENT=1 vitest run",
    "test:coverage": "AGENT=1 vitest run --coverage",
    "type-check": "tsc --noEmit",
    "type-check:ai": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@claude-code-changelog-viewer/common": "workspace:*",
    "@claude-code-changelog-viewer/types": "workspace:*",
    "@google/genai": "catalog:",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "p-retry": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {}
}
