{
  "name": "changelog-fetcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "tsx src/parse-changelog.ts",
    "analyze": "tsx src/analyze-changelog.ts",
    "infer": "node --env-file-if-exists=.env --import tsx src/infer-benefits.ts",
    "infer:no-ai": "tsx src/infer-benefits.ts",
    "notify:docs-send": "node --env-file-if-exists=.env --import tsx src/discord/create-docs-summary-message.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@claude-code-changelog-viewer/common": "workspace:*",
    "@claude-code-changelog-viewer/types": "workspace:*",
    "@google/genai": "^1.41.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "tsx": "^4.21.0",
    "vitest": "catalog:"
  }
}
