{
  "name": "changelog-fetcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "bun src/parse-changelog.ts",
    "analyze": "bun src/analyze-changelog.ts",
    "infer": "bun src/infer-benefits.ts",
    "infer:no-ai": "bun src/infer-benefits.ts",
    "notify:docs-send": "bun src/discord/create-docs-summary-message.ts",
    "test": "AGENT=1 bun test --bail=2",
    "test:coverage": "AGENT=1 bun test --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@claude-code-changelog-viewer/common": "workspace:*",
    "@claude-code-changelog-viewer/types": "workspace:*",
    "@google/genai": "^1.46.0",
    "p-retry": "^7.1.1"
  },
  "devDependencies": {}
}
