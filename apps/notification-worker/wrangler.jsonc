{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notification-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-19",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WORKER_URL": "https://claude-code-log.com",
    "SITE_URL": "https://claude-code-log.com",
    "EMAIL_FROM": "noreply@claude-code-log.com"
  },
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notification-db",
      "database_id": "d4301e1b-c7ae-427d-8017-8735b01e5943",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "changelog-notification"
      }
    ],
    "consumers": [
      {
        "queue": "changelog-notification",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "changelog-notification-dlq",
        "retry_delay": 60
      }
    ]
  },
  "routes": [
    {
      "pattern": "claude-code-log.com/api/*",
      "zone_name": "claude-code-log.com"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    // UTC なので JST に換算すると 毎日 0 時に実行される
    "crons": ["0 15 * * *"]
  }
}
