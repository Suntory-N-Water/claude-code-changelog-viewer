{
  "name": "notification-worker",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply notification-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply notification-db --remote",
    "test": "AGENT=1 vitest run",
    "test:coverage": "AGENT=1 vitest run --coverage",
    "type-check": "tsc --noEmit",
    "type-check:ai": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@claude-code-changelog-viewer/common": "workspace:*",
    "@claude-code-changelog-viewer/types": "workspace:*",
    "@hono/cloudflare-access": "^0.4.0",
    "@hono/standard-validator": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.28",
    "mimetext": "^3.0.28",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.10",
    "wrangler": "catalog:"
  }
}
